  "segments": [
    {
      "end": 10.52,
      "id": 0,
      "start": 0.82,
      "text": "第幾頁 總之問"
    },
    {
      "end": 12.86,
      "id": 1,
      "start": 10.52,
      "text": "諸位置是有分分是不是"
    },
    {
      "end": 14.76,
      "id": 2,
      "start": 12.86,
      "text": "在講這個對不對"
    },
    {
      "end": 16.31,
      "id": 3,
      "start": 14.76,
      "text": "是嗎"
    },
    {
      "end": 21.61,
      "id": 4,
      "start": 16.31,
      "text": "好 那往前稍微講一下"
    },
    {
      "end": 23.11,
      "id": 5,
      "start": 21.61,
      "text": "總之就變成"
    },
    {
      "end": 25.25,
      "id": 6,
      "start": 23.11,
      "text": "總管司講的"
    },
    {
      "end": 28.06,
      "id": 7,
      "start": 25.25,
      "text": "是一切法都無自信對不對"
    },
    {
      "end": 30.58,
      "id": 8,
      "start": 28.06,
      "text": "那要破的那個對方吧"
    },
    {
      "end": 32.48,
      "id": 9,
      "start": 30.58,
      "text": "分之就是對方的話就是"
    },
    {
      "end": 36.05,
      "id": 10,
      "start": 32.48,
      "text": "有的會說有自身"
    },
    {
      "end": 37.75,
      "id": 11,
      "start": 36.05,
      "text": "認為有自身"
    },
    {
      "end": 41.6,
      "id": 12,
      "start": 37.75,
      "text": "從而說有自信吧"
    },
    {
      "end": 45.51,
      "id": 13,
      "start": 41.6,
      "text": "那有些人說有他身"
    },
    {
      "end": 47.3,
      "id": 14,
      "start": 46.04,
      "text": "像自部吧"
    },
    {
      "end": 49.88,
      "id": 15,
      "start": 47.3,
      "text": "自部大概都是說因為有他身"
    },
    {
      "end": 53.4,
      "id": 16,
      "start": 49.88,
      "text": "所以一定要有自信之類的"
    },
    {
      "end": 57.76,
      "id": 17,
      "start": 53.4,
      "text": "總之基於這個就破了自身"
    },
    {
      "end": 59.26,
      "id": 18,
      "start": 57.76,
      "text": "他身這些對不對"
    },
    {
      "end": 65.03,
      "id": 19,
      "start": 59.26,
      "text": "這個完了之後還是會說有通達"
    },
    {
      "end": 69.28,
      "id": 20,
      "start": 66.23,
      "text": "通達該怎麼講"
    },
    {
      "end": 72.66,
      "id": 21,
      "start": 69.28,
      "text": "有通達者嘛"
    },
    {
      "end": 73.96,
      "id": 22,
      "start": 72.66,
      "text": "應該要這麼說吧"
    },
    {
      "end": 77.67,
      "id": 23,
      "start": 73.96,
      "text": "總之以他起自向"
    },
    {
      "end": 79.07,
      "id": 24,
      "start": 77.67,
      "text": "有這個部分是"
    },
    {
      "end": 81.34,
      "id": 25,
      "start": 79.07,
      "text": "有能通達他的事這樣"
    },
    {
      "end": 83.73,
      "id": 26,
      "start": 81.34,
      "text": "所以就講到了自身"
    },
    {
      "end": 86.23,
      "id": 27,
      "start": 83.73,
      "text": "也破除這樣可以嗎"
    },
    {
      "end": 89.24,
      "id": 28,
      "start": 86.23,
      "text": "所以就變成"
    },
    {
      "end": 93.05,
      "id": 29,
      "start": 89.24,
      "text": "我們這個以前我們都講過"
    },
    {
      "end": 94.29,
      "id": 30,
      "start": 93.05,
      "text": "可能要這樣想一下了"
    },
    {
      "end": 96.11,
      "id": 31,
      "start": 94.29,
      "text": "就是變成就是說"
    },
    {
      "end": 97.61,
      "id": 32,
      "start": 96.11,
      "text": "下部的話一直努力的"
    },
    {
      "end": 98.95,
      "id": 33,
      "start": 97.61,
      "text": "在做一個什麼事情"
    },
    {
      "end": 100.45,
      "id": 34,
      "start": 98.95,
      "text": "就是說以他起是實有"
    },
    {
      "end": 102.02,
      "id": 35,
      "start": 100.45,
      "text": "或者是自向有"
    },
    {
      "end": 105.66,
      "id": 36,
      "start": 103.16,
      "text": "他們一直往這邊去拉嘛對不對"
    },
    {
      "end": 108.12,
      "id": 37,
      "start": 105.66,
      "text": "所以就講了自身他身"
    },
    {
      "end": 110.26,
      "id": 38,
      "start": 108.12,
      "text": "自證之類的"
    },
    {
      "end": 111.36,
      "id": 39,
      "start": 110.26,
      "text": "那我們的話就是說"
    },
    {
      "end": 113.76,
      "id": 40,
      "start": 111.36,
      "text": "一直為了把它拉向無自信"
    },
    {
      "end": 114.66,
      "id": 41,
      "start": 113.76,
      "text": "無自向"
    },
    {
      "end": 117.26,
      "id": 42,
      "start": 115.22,
      "text": "所以就一直破了個自身他身"
    },
    {
      "end": 118.8,
      "id": 43,
      "start": 117.26,
      "text": "自證等等等等"
    },
    {
      "end": 119.8,
      "id": 44,
      "start": 118.8,
      "text": "這樣可以嗎"
    },
    {
      "end": 123.18,
      "id": 45,
      "start": 119.8,
      "text": "所以就變成"
    },
    {
      "end": 124.68,
      "id": 46,
      "start": 123.18,
      "text": "該怎麼講"
    },
    {
      "end": 133.66,
      "id": 47,
      "start": 124.68,
      "text": "這個部分好像講得比較早了一點點"
    },
    {
      "end": 134.4,
      "id": 48,
      "start": 133.66,
      "text": "但是"
    },
    {
      "end": 138.68,
      "id": 49,
      "start": 134.4,
      "text": "總之我們在做這個事情對不對"
    },
    {
      "end": 140.28,
      "id": 50,
      "start": 138.68,
      "text": "所以就變成"
    },
    {
      "end": 144.99,
      "id": 51,
      "start": 140.28,
      "text": "在下部來說非常努力的一個點"
    },
    {
      "end": 145.89,
      "id": 52,
      "start": 144.99,
      "text": "就是說"
    },
    {
      "end": 147.36,
      "id": 53,
      "start": 145.89,
      "text": "怎麼講"
    },
    {
      "end": 150.53,
      "id": 54,
      "start": 147.36,
      "text": "以他起是實有嘛"
    },
    {
      "end": 151.29,
      "id": 55,
      "start": 150.53,
      "text": "一方面是這樣"
    },
    {
      "end": 152.29,
      "id": 56,
      "start": 151.29,
      "text": "一方面的話就是說"
    },
    {
      "end": 153.93,
      "id": 57,
      "start": 152.29,
      "text": "像秩序的話不會說是實有"
    },
    {
      "end": 155.13,
      "id": 58,
      "start": 153.93,
      "text": "但是說"
    },
    {
      "end": 156.33,
      "id": 59,
      "start": 155.13,
      "text": "一定要有自向"
    },
    {
      "end": 159.68,
      "id": 60,
      "start": 156.33,
      "text": "如果一切法沒有自向的話"
    },
    {
      "end": 162.08,
      "id": 61,
      "start": 159.68,
      "text": "就會變成毀謗也好"
    },
    {
      "end": 164.82,
      "id": 62,
      "start": 162.08,
      "text": "就會變成無法安理一切法"
    },
    {
      "end": 166.58,
      "id": 63,
      "start": 164.82,
      "text": "那維持的話就是"
    },
    {
      "end": 168.04,
      "id": 64,
      "start": 166.58,
      "text": "變成以他起必須是實有"
    },
    {
      "end": 169.08,
      "id": 65,
      "start": 168.04,
      "text": "如果不是實有的話"
    },
    {
      "end": 170.42,
      "id": 66,
      "start": 169.08,
      "text": "就建立不起來"
    },
    {
      "end": 172.29,
      "id": 67,
      "start": 170.42,
      "text": "就是一直講這個嘛對不對"
    },
    {
      "end": 174.24,
      "id": 68,
      "start": 172.29,
      "text": "所以"
    },
    {
      "end": 176.04,
      "id": 69,
      "start": 174.24,
      "text": "直接講的話可以"
    },
    {
      "end": 177.84,
      "id": 70,
      "start": 176.04,
      "text": "可以有這樣一個層面就對了"
    },
    {
      "end": 179.99,
      "id": 71,
      "start": 177.84,
      "text": "其實這樣的一個層面的話"
    },
    {
      "end": 181.09,
      "id": 72,
      "start": 179.99,
      "text": "用另外的話來講的話"
    },
    {
      "end": 185.02,
      "id": 73,
      "start": 181.09,
      "text": "就是變成像下部的話把為四"
    }
