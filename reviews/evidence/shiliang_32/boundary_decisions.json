  "18": {
    "mergeCount": 2,
    "merges": [
      {
        "fromPid": "p_17",
        "toPid": "p_16",
        "lastSentId": "sent-67",
        "firstSentId": "sent-68",
        "prevText": "各位分得",
        "nextText": "清楚嗎？"
      },
      {
        "fromPid": "p_76",
        "toPid": "p_75",
        "lastSentId": "sent-480",
        "firstSentId": "sent-481",
        "prevText": "所",
        "nextText": "以透過串習之後，就不必再像當初一樣付出相同的心力，對境就會馬上現起瞋念。"
      }
    ]
  },
  "19": {
    "mergeCount": 2,
    "merges": [
      {
        "fromPid": "p_10",
        "toPid": "p_9",
        "lastSentId": "sent-54",
        "firstSentId": "sent-55",
        "prevText": "如果你想利益眾生，當紅綠燈",
        "nextText": "從綠燈變成黃燈、再變成紅燈時，你心中應該怎麼想？"
      },
      {
        "fromPid": "p_18",
        "toPid": "p_17",
        "lastSentId": "sent-110",
        "firstSentId": "sent-111",
        "prevText": "首先，我們看到",
        "nextText": "後兩句，「悲等諸覺心，修習於何住」──在長時精進修持慈悲、智慧等內在的功德之後，怎麼會只停留在某種狀態呢？"
      }
    ]
  },
  "20": {
    "mergeCount": 3,
    "merges": [
      {
        "fromPid": "p_16",
        "toPid": "p_15",
        "lastSentId": "sent-61",
        "firstSentId": "sent-62",
        "prevText": "這當中的「方",
        "nextText": "便生」指的是果，四諦當中，苦諦與滅諦是果；"
      },
      {
        "fromPid": "p_41",
        "toPid": "p_40",
        "lastSentId": "sent-218",
        "firstSentId": "sent-219",
        "prevText": "他不是那樣的想",
        "nextText": "法。"
      },
      {
        "fromPid": "p_49",
        "toPid": "p_48",
        "lastSentId": "sent-262",
        "firstSentId": "sent-263",
        "prevText": "在成",
        "nextText": "佛之前都不講法，成佛之後才選擇說法。"
      }
    ]
  },
  "21": {
    "mergeCount": 2,
    "merges": [
      {
        "fromPid": "p_28",
        "toPid": "p_27",
        "lastSentId": "sent-160",
        "firstSentId": "sent-161",
        "prevText": "先",
        "nextText": "了解苦，進而探索苦因。"
      },
      {
        "fromPid": "p_56",
        "toPid": "p_55",
        "lastSentId": "sent-369",
        "firstSentId": "sent-370",
        "prevText": "之前",
        "nextText": "我們提到了三種功德當中的前兩種，分別是「善斷」以及「不退轉斷」。"
      }
    ]
  },
  "22": {
    "mergeCount": 0,
