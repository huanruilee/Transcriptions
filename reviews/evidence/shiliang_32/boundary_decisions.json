  },
  "32": {
    "mergeCount": 1,
    "merges": [
      {
        "fromPid": "p_20",
        "toPid": "p_19",
        "lastSentId": "sent-102",
        "firstSentId": "sent-103",
        "prevText": "「為即由彼教」，「為」──為",
