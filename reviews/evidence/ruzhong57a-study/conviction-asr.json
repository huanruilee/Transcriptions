{
  "duration": 282.0,
  "language": "zh",
  "rtf": 0.017121209411474,
  "segments": [
    {
      "end": 0.99,
      "id": 0,
      "start": 0.09,
      "text": "对那个见解"
    },
    {
      "end": 3.55,
      "id": 1,
      "start": 0.99,
      "text": "所谓的见解是一个非常厉害的东西了"
    },
    {
      "end": 6.77,
      "id": 2,
      "start": 3.55,
      "text": "我觉得我们的那个佛教见解就弄来弄去"
    },
    {
      "end": 8.35,
      "id": 3,
      "start": 6.77,
      "text": "反正被我们弄坏了就对了"
    },
    {
      "end": 13.76,
      "id": 4,
      "start": 8.35,
      "text": "因为像现在科学界的一些了解吧"
    },
    {
      "end": 15.44,
      "id": 5,
      "start": 13.76,
      "text": "见解那个就真的很厉害"
    },
    {
      "end": 21.15,
      "id": 6,
      "start": 15.44,
      "text": "听说最近科学家透过什么放大镜了解吧"
    },
    {
      "end": 28.32,
      "id": 7,
      "start": 21.15,
      "text": "发现那个番茄可以让我们至少寿命可以延长五年十年"
    },
    {
      "end": 31.76,
      "id": 8,
      "start": 28.32,
      "text": "OK第二天大家都在买番茄吃了"
    },
    {
      "end": 38.62,
      "id": 9,
      "start": 31.76,
      "text": "虽然就是说寿命会增加五年还不止"
    },
    {
      "end": 39.86,
      "id": 10,
      "start": 38.62,
      "text": "可能是十五年左右"
    },
    {
      "end": 43.73,
      "id": 11,
      "start": 39.86,
      "text": "对可是就是说一直吃番茄的话"
    },
    {
      "end": 46.83,
      "id": 12,
      "start": 43.73,
      "text": "其实会这么讲对吧"
    },
    {
      "end": 50.97,
      "id": 13,
      "start": 46.83,
      "text": "对啊突然会这样的"
    },
    {
      "end": 55.24,
      "id": 14,
      "start": 50.97,
      "text": "OK就突然谁都不敢吃番茄了"
    },
    {
      "end": 56.26,
      "id": 15,
      "start": 55.24,
      "text": "装作的意思是说"
    },
    {
      "end": 59.85,
      "id": 16,
      "start": 56.26,
      "text": "因为我们会把那个科学界讲的东西"
    },
    {
      "end": 61.51,
      "id": 17,
      "start": 59.85,
      "text": "当成是事实的真相"
    },
    {
      "end": 63.56,
      "id": 18,
      "start": 61.51,
      "text": "事实的真理"
    },
    {
      "end": 65.34,
      "id": 19,
      "start": 63.56,
      "text": "所以马上取舍嘛对不对"
    },
    {
      "end": 67.64,
      "id": 20,
      "start": 65.34,
      "text": "佛教讲什么都没用"
    },
    {
      "end": 70.46,
      "id": 21,
      "start": 67.64,
      "text": "反正佛陀讲的自言明理"
    },
    {
      "end": 73.51,
      "id": 22,
      "start": 70.46,
      "text": "反正就是说真实的什么什么"
    },
    {
      "end": 75.95,
      "id": 23,
      "start": 73.51,
      "text": "OK听着听完了就完了"
    },
    {
      "end": 77.96,
      "id": 24,
      "start": 75.95,
      "text": "反正就不会把这个当成一个"
    },
    {
      "end": 83.68,
      "id": 25,
      "start": 77.96,
      "text": "所以不知道这骗佛陀还是说自己在骗自己"
    },
    {
      "end": 86.71,
      "id": 26,
      "start": 83.68,
      "text": "老实讲的时候也会说这个是真理"
    },
    {
      "end": 88.11,
      "id": 27,
      "start": 86.71,
      "text": "大家也认同这个是真理"
    },
    {
      "end": 91.42,
      "id": 28,
      "start": 88.11,
      "text": "可是不会把它当真"
    },
    {
      "end": 95.01,
      "id": 29,
      "start": 91.42,
      "text": "就很期待嘛对不对"
    },
    {
      "end": 95.09,
      "id": 30,
      "start": 95.01,
      "text": "对"
    },
    {
      "end": 115.03,
      "id": 31,
      "start": 112.67,
      "text": "一切的一切都是有意可以改变"
    },
    {
      "end": 117.11,
      "id": 32,
      "start": 115.03,
      "text": "其他是没办法改变什么的了"
    },
    {
      "end": 120.96,
      "id": 33,
      "start": 117.11,
      "text": "而改变一切的最终的方法其实就是空性"
    },
    {
      "end": 123.78,
      "id": 34,
      "start": 120.96,
      "text": "这个好像就是两千多年来"
    },
    {
      "end": 126.56,
      "id": 35,
      "start": 123.78,
      "text": "有太多的人相信这个"
    },
    {
      "end": 128.31,
      "id": 36,
      "start": 126.56,
      "text": "第一吧"
    },
    {
      "end": 128.97,
      "id": 37,
      "start": 128.31,
      "text": "第二的话其实"
    },
    {
      "end": 131.33,
      "id": 38,
      "start": 128.97,
      "text": "其实真的是真正有相信心"
    },
    {
      "end": 133.69,
      "id": 39,
      "start": 131.33,
      "text": "真正了解这些的人"
    },
    {
      "end": 136.28,
      "id": 40,
      "start": 133.69,
      "text": "成就者也是每一代"
    },
    {
      "end": 138.32,
      "id": 41,
      "start": 136.28,
      "text": "应该每一代都有说不清的人"
    },
    {
      "end": 144.33,
      "id": 42,
      "start": 138.32,
      "text": "虽然我们可能没有任何人是列在这个范围当中"
    },
    {
      "end": 149.35,
      "id": 43,
      "start": 144.33,
      "text": "可是应该是有说不清的人嘛对不对"
    },
    {
      "end": 153.08,
      "id": 44,
      "start": 149.35,
      "text": "总之就是变成有时候一直在努力的学了"
    },
    {
      "end": 160.01,
      "id": 45,
      "start": 153.08,
      "text": "可是就嗯对这个可以解决很多很多的问题"
    },
    {
      "end": 162.61,
      "id": 46,
      "start": 160.01,
      "text": "这样可以吗"
    },
    {
      "end": 165.87,
      "id": 47,
      "start": 162.61,
      "text": "我们所有的问题可能都可以透过这个解决了"
    },
    {
      "end": 170.92,
      "id": 48,
      "start": 165.87,
      "text": "但是呢自己不把它当一回事的时候"
    },
    {
      "end": 172.6,
      "id": 49,
      "start": 170.92,
      "text": "他也帮不了什么"
    },
    {
      "end": 177.75,
      "id": 50,
      "start": 172.6,
      "text": "对所以佛教简单的有时候就是变成拜个佛啦"
    },
    {
      "end": 181.67,
      "id": 51,
      "start": 177.75,
      "text": "或者绕个就是写很多剥裂的东西"
    },
    {
      "end": 183.29,
      "id": 52,
      "start": 181.67,
      "text": "放在塔里头绕"
    },
    {
      "end": 186.35,
      "id": 53,
      "start": 183.29,
      "text": "好像听说也可以绕出一些功德"
    },
    {
      "end": 189.07,
      "id": 54,
      "start": 186.35,
      "text": "那是一个很期待的现象嘛"
    },
    {
      "end": 192.67,
      "id": 55,
      "start": 189.07,
      "text": "有点像是我们的那个小学国中对不对"
    },
    {
      "end": 196.69,
      "id": 56,
      "start": 192.67,
      "text": "大学什么教科书全部都放在一个什么篮子里头"
    },
    {
      "end": 197.81,
      "id": 57,
      "start": 196.69,
      "text": "你去抓"
    },
    {
      "end": 201.17,
      "id": 58,
      "start": 197.81,
      "text": "听说有好处这个不可思议嘛对不对"
    },
    {
      "end": 206.0,
      "id": 59,
      "start": 201.17,
      "text": "但是嗯会说佛经有这样的功德呢"
    },
    {
      "end": 210.0,
      "id": 60,
      "start": 206.0,
      "text": "那更何况是好好的学习"
    },
    {
      "end": 214.06,
      "id": 61,
      "start": 210.0,
      "text": "对那应该要产生不可思议的一些成就"
    },
    {
      "end": 215.06,
      "id": 62,
      "start": 214.06,
      "text": "这样可以吗"
    },
    {
      "end": 218.12,
      "id": 63,
      "start": 215.06,
      "text": "对自己没有这个就要去想"
    },
    {
      "end": 221.86,
      "id": 64,
      "start": 218.12,
      "text": "为什么自己对这方面一点作用都没有"
    },
    {
      "end": 224.02,
      "id": 65,
      "start": 221.86,
      "text": "因为很多人是有的嘛"
    },
    {
      "end": 226.32,
      "id": 66,
      "start": 224.02,
      "text": "两千多年来一直都是有的嘛对不对"
    },
    {
      "end": 228.02,
      "id": 67,
      "start": 226.32,
      "text": "那你为什么没有"
    },
    {
      "end": 232.17,
      "id": 68,
      "start": 228.02,
      "text": "对所以可能不能够怪老师了解吧"
    },
    {
      "end": 239.31,
      "id": 69,
      "start": 232.17,
      "text": "那这种子就对所以就变成讲很多"
    },
    {
      "end": 242.74,
      "id": 70,
      "start": 239.31,
      "text": "要讲的就是说观念"
    },
    {
      "end": 247.06,
      "id": 71,
      "start": 242.74,
      "text": "就是观点观点其实可以左右很多很多的事情"
    },
    {
      "end": 251.16,
      "id": 72,
      "start": 247.06,
      "text": "而这个观点的话是终极的一个观点"
    },
    {
      "end": 255.5,
      "id": 73,
      "start": 251.16,
      "text": "对所以即便学的真正的学进去的话"
    },
    {
      "end": 256.54,
      "id": 74,
      "start": 255.5,
      "text": "当然那个不可思议"
    },
    {
      "end": 261.92,
      "id": 75,
      "start": 256.54,
      "text": "但是很多时候对这个有非常大的一个信心的话"
    },
    {
      "end": 264.08,
      "id": 76,
      "start": 261.92,
      "text": "可能也有很大的一个差别了"
    },
    {
      "end": 267.15,
      "id": 77,
      "start": 264.08,
      "text": "这样可以吗"
    },
    {
      "end": 271.5,
      "id": 78,
      "start": 267.15,
      "text": "嗯反正就为了大家该怎么讲"
    },
    {
      "end": 276.21,
      "id": 79,
      "start": 271.5,
      "text": "稍微提一点什么还是什么"
    },
    {
      "end": 278.72,
      "id": 80,
      "start": 276.21,
      "text": "就类似讲这样的一个话"
    },
    {
      "end": 281.98,
      "id": 81,
      "start": 278.72,
      "text": "接下去就是上一天"
    }
  ],
  "server_elapsed_s": 4.828181054035667,
