        "sent-264",
        "sent-265",
        "sent-266",
        "sent-267",
        "sent-268",
        "sent-269",
        "sent-270",
        "sent-271"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 255,
      "sourceLast": 271,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study57A-p16-s1",
      "start": 1786.9,
      "end": 1841.56,
      "text": "【編者註・底本對讀】2016上課版p.175：「觀待密意所依唯是異名,故義是一。」此為底本完整補列，非逐字聽核原話，不表示每字皆當堂讀出。【底本對讀結束】「觀待密意所依唯是異名，故義是一。」這個「故義是一」有一點玄機，不能直接當成兩法就是一。說實際上是一，但又不是一，這該怎麼講？",
      "sourceSentenceIds": [
        "sent-272",
        "sent-273",
        "sent-274",
        "sent-275",
        "sent-276",
        "sent-277",
        "sent-278",
        "sent-279",
        "sent-280"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 272,
      "sourceLast": 280,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study57A-p16-s2",
      "start": 1841.56,
      "end": 1956.33,
      "text": "觀待密意所依，除了名不同，內容是一樣的。不是一，卻針對密意處的空性來說是一；兩者背後最終要講的，都是自性空，所以是同一個義。藏文比較看得出來，中文看不出來。翻譯順著藏文思路，好像通，沒看藏文的人直接看中文，又變成另外一回事，常常會這樣。",
      "sourceSentenceIds": [
        "sent-281",
        "sent-282",
        "sent-283",
        "sent-284",
        "sent-285",
        "sent-286",
        "sent-287",
        "sent-288",
        "sent-289",
        "sent-290",
        "sent-291",
        "sent-292",
        "sent-293",
        "sent-294",
        "sent-295",
        "sent-296",
        "sent-297",
        "sent-298"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 281,
      "sourceLast": 298,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study57A-p17-s1",
      "start": 1962.95,
      "end": 1998.61,
      "text": "僅僅名不一樣，實際上的義相同。可是「義完全相同」，仍然要按照剛才那樣理解，不能忘記限定。",
      "sourceSentenceIds": [
        "sent-299",
