      "text": "佛说诸去也是一样"
    },
    {
      "end": 340.45,
      "id": 160,
      "start": 338.45,
      "text": "佛说诸去亦复然"
    },
    {
      "end": 342.49,
      "id": 161,
      "start": 340.45,
      "text": "嗯"
    },
    {
      "end": 343.49,
      "id": 162,
      "start": 342.49,
      "text": "总之真实上没有"
    },
    {
      "end": 349.14,
      "id": 163,
      "start": 343.49,
      "text": "为名安利而有这样"
    },
    {
      "end": 350.14,
      "id": 164,
      "start": 349.14,
      "text": "对由"
    },
    {
      "end": 351.14,
      "id": 165,
      "start": 350.14,
      "text": "谁想者"
    },
    {
      "end": 352.14,
      "id": 166,
      "start": 351.14,
      "text": "谁看到水"
    },
    {
      "end": 354.05,
      "id": 167,
      "start": 352.14,
      "text": "对"
    },
    {
      "end": 355.05,
      "id": 168,
      "start": 354.05,
      "text": "谁想者"
    },
    {
      "end": 356.05,
      "id": 169,
      "start": 355.05,
      "text": "谁会在阳烟看到水"
    },
    {
      "end": 357.2,
      "id": 170,
      "start": 356.05,
      "text": "可是阳烟中"
    },
    {
      "end": 359.2,
      "id": 171,
      "start": 357.2,
      "text": "事实上没有真正的水就对了"
    },
    {
      "end": 361.66,
      "id": 172,
      "start": 359.2,
      "text": "如是分别扰乱者"
    },
    {
      "end": 366.0,
      "id": 173,
      "start": 361.66,
      "text": "于不尽中也会看到尽"
    },
    {
      "end": 372.8,
      "id": 174,
      "start": 366.0,
      "text": "有如非常干净的那个镜中"
    },
    {
      "end": 375.36,
      "id": 175,
      "start": 372.8,
      "text": "嗯"
    },
    {
      "end": 376.56,
      "id": 176,
      "start": 375.36,
      "text": "现无怎么讲"
    },
    {
      "end": 378.56,
      "id": 177,
      "start": 376.56,
      "text": "无自信的影像了"
    },
    {
      "end": 379.93,
      "id": 178,
      "start": 378.56,
      "text": "所现的那个影像"
    },
    {
      "end": 381.93,
      "id": 179,
      "start": 379.93,
      "text": "不是真实的有这个东西"
    },
    {
      "end": 382.93,
      "id": 180,
      "start": 381.93,
      "text": "这样"
    },
    {
      "end": 384.59,
      "id": 181,
      "start": 382.93,
      "text": "大书如硬之"
    },
    {
      "end": 385.59,
      "id": 182,
      "start": 384.59,
      "text": "诸法亦如是"
    },
    {
      "end": 386.59,
      "id": 183,
      "start": 385.59,
      "text": "大概这样"
    },
    {
      "end": 389.65,
      "id": 184,
      "start": 386.59,
      "text": "这样对吧"
    },
    {
      "end": 390.65,
      "id": 185,
