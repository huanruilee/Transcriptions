      "timingMethod": "source-window",
      "sourceFirst": 198,
      "sourceLast": 205,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study59B-p11-s2",
      "start": 1529.96,
      "end": 1576.16,
      "text": "虛空、無方分微塵這一類是勝義諦。虛空錘也沒辦法錘，心也沒辦法拆散；瓶子一錘便不是瓶子。用心分析瓶嘴、各個支分，也知道那些支分不是瓶子。有部就有這樣概念。雖不是勝義有，但世俗有——換一句，可能不能這樣講：不是勝義諦，卻依然是世俗諦。【編者註：保留勝義有改說勝義諦的自我修正，未把兩派用語當成同一意義。】",
      "sourceSentenceIds": [
        "sent-206",
        "sent-207",
        "sent-208",
        "sent-209",
        "sent-210",
        "sent-211",
        "sent-212",
