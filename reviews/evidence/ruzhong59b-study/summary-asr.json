      "text": "使女儿则"
    },
    {
      "end": 15.7,
      "id": 8,
      "start": 14.18,
      "text": "大概这样"
    },
    {
      "end": 17.74,
      "id": 9,
      "start": 15.7,
      "text": "可是就是世间有"
    },
    {
      "end": 18.54,
      "id": 10,
      "start": 17.74,
      "text": "世俗有"
    },
    {
      "end": 20.29,
      "id": 11,
      "start": 18.54,
      "text": "使女儿则不耳"
    },
    {
      "end": 24.78,
      "id": 12,
      "start": 20.29,
      "text": "不像那个使女儿完全没有"
    },
    {
      "end": 28.51,
      "id": 13,
      "start": 24.78,
      "text": "此于辱至终成不定过"
    },
    {
      "end": 35.67,
      "id": 14,
      "start": 28.51,
      "text": "此于我等不成则难"
    },
    {
      "end": 39.58,
      "id": 15,
      "start": 35.67,
      "text": "以我等于世俗许设等有"
    },
    {
      "end": 40.54,
      "id": 16,
      "start": 39.58,
      "text": "自行生"
    },
    {
      "end": 42.86,
      "id": 17,
      "start": 40.54,
      "text": "此于这个在说什么"
    },
    {
      "end": 69.9,
      "id": 18,
      "start": 42.86,
      "text": "此叫一说设等"
    },
    {
      "end": 71.1,
      "id": 19,
      "start": 69.9,
      "text": "虽自行不生"
    },
    {
      "end": 72.62,
      "id": 20,
      "start": 71.1,
      "text": "然世事什么什么这样"
    },
    {
      "end": 74.32,
      "id": 21,
      "start": 72.62,
      "text": "使女儿则不耳"
    },
    {
      "end": 78.06,
      "id": 22,
      "start": 74.32,
      "text": "此于辱至终成不定过"
    },
    {
      "end": 80.29,
      "id": 23,
      "start": 78.06,
      "text": "对你来说会成不定过"
    },
    {
      "end": 82.09,
      "id": 24,
      "start": 80.29,
      "text": "此于我等不成则难"
    },
    {
      "end": 83.36,
      "id": 25,
      "start": 82.09,
      "text": "这样对吗"
    },
    {
      "end": 84.24,
      "id": 26,
      "start": 83.36,
      "text": "对你们是过"
    },
    {
      "end": 85.96,
      "id": 27,
      "start": 84.24,
      "text": "对我来说不会"
    },
    {
      "end": 88.16,
      "id": 28,
      "start": 85.96,
      "text": "为什么呢"
    },
    {
      "end": 92.06,
      "id": 29,
      "start": 88.16,
      "text": "以我等于非与世俗许设有自信"
    },
    {
      "end": 94.67,
      "id": 30,
      "start": 92.06,
      "text": "此于圣一种破误"
    },
    {
      "end": 95.31,
      "id": 31,
      "start": 94.67,
      "text": "这样对吗"
    },
    {
      "end": 97.99,
      "id": 32,
      "start": 95.31,
      "text": "我们没有说世俗有自信"
    },
    {
      "end": 99.83,
      "id": 33,
      "start": 97.99,
      "text": "世俗等世俗有自信"
    },
    {
      "end": 100.97,
      "id": 34,
      "start": 99.83,
      "text": "与圣一无自信"
    },
    {
      "end": 101.97,
      "id": 35,
      "start": 100.97,
      "text": "我们没有这样讲"
    },
    {
      "end": 104.74,
      "id": 36,
      "start": 101.97,
      "text": "对所以我们没有问题"
    },
    {
      "end": 105.34,
      "id": 37,
      "start": 104.74,
      "text": "这样"
    },
    {
      "end": 114.45,
      "id": 38,
      "start": 105.34,
      "text": "总之这个就变成整个内容"
    },
    {
      "end": 117.51,
      "id": 39,
      "start": 114.45,
      "text": "跟刚才我们讲过的就差不多"
    },
    {
      "end": 118.27,
      "id": 40,
      "start": 117.51,
      "text": "这样对吗"
    },
    {
      "end": 120.46,
      "id": 41,
      "start": 118.27,
      "text": "大概就这样一个状态"
    },
    {
      "end": 122.18,
      "id": 42,
      "start": 120.46,
      "text": "接下去的话就是总结"
    },
    {
      "end": 124.8,
      "id": 43,
      "start": 122.18,
      "text": "总结的时候问"
    },
    {
      "end": 129.7,
      "id": 44,
      "start": 124.8,
      "text": "如中何故非世俗中许设等于有自信"
    },
    {
      "end": 133.98,
      "id": 45,
      "start": 129.7,
      "text": "神圣一种破误"
    },
    {
      "end": 142.07,
      "id": 46,
      "start": 133.98,
      "text": "这个是非对没有错"
    },
    {
      "end": 147.01,
      "id": 47,
      "start": 142.07,
      "text": "如中何故非不这么做就对了"
    },
    {
      "end": 150.92,
      "id": 48,
      "start": 147.01,
      "text": "非与世俗中许的自信有"
    },
    {
      "end": 152.3,
      "id": 49,
      "start": 150.92,
      "text": "世俗中自信有"
    },
    {
      "end": 153.88,
      "id": 50,
