      "text": "所以自行不生"
    },
    {
      "end": 8.2,
      "id": 4,
      "start": 5.18,
      "text": "对所以一切诸法"
    },
    {
      "end": 9.44,
      "id": 5,
      "start": 8.2,
      "text": "自行不生"
    },
    {
      "end": 12.09,
      "id": 6,
