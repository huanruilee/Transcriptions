  "segments": [
    {
      "end": 1.64,
      "id": 0,
      "start": 0.34,
      "text": "所以这个地方"
    },
    {
      "end": 4.34,
      "id": 1,
      "start": 1.64,
      "text": "其实这边好像不太会觉得"
    },
    {
      "end": 6.98,
      "id": 2,
      "start": 4.34,
      "text": "这个是一个蛮重要的事情"
    },
    {
      "end": 10.46,
      "id": 3,
      "start": 6.98,
      "text": "可是现在看来"
    },
    {
      "end": 11.76,
      "id": 4,
      "start": 10.46,
      "text": "好像还蛮重要的感觉"
    },
    {
      "end": 16.46,
      "id": 5,
      "start": 11.76,
      "text": "因为或许就是没有把这个当成很重要"
    },
    {
      "end": 18.38,
      "id": 6,
      "start": 16.46,
      "text": "所以就钻扭脚尖"
    },
    {
      "end": 19.9,
      "id": 7,
      "start": 18.38,
      "text": "像刚才讲的那个"
    },
    {
      "end": 22.94,
      "id": 8,
      "start": 19.9,
      "text": "就是变成贫子为有法"
    },
    {
      "end": 24.67,
      "id": 9,
      "start": 22.94,
      "text": "是无自息"
    },
    {
      "end": 25.41,
      "id": 10,
      "start": 24.67,
      "text": "是缘起雇"
    },
    {
      "end": 29.21,
      "id": 11,
      "start": 25.41,
      "text": "对那个的他方"
    },
    {
      "end": 29.75,
      "id": 12,
      "start": 29.21,
      "text": "这样的"
    },
    {
      "end": 31.29,
      "id": 13,
      "start": 29.75,
      "text": "治方跟他方两者当中"
    },
    {
      "end": 32.07,
      "id": 14,
      "start": 31.29,
      "text": "他方是谁"
    },
    {
      "end": 33.59,
      "id": 15,
      "start": 32.07,
      "text": "他方要懂什么"
    },
    {
      "end": 37.08,
      "id": 16,
      "start": 33.59,
      "text": "这个在寺院当中的争论"
    },
    {
      "end": 37.94,
      "id": 17,
      "start": 37.08,
      "text": "非常非常的大"
    },
    {
      "end": 40.56,
      "id": 18,
      "start": 37.94,
      "text": "在这方面写也是写了很多东西"
    },
    {
      "end": 43.31,
      "id": 19,
      "start": 40.56,
      "text": "对反正就是说"
    },
    {
      "end": 46.01,
      "id": 20,
      "start": 43.31,
      "text": "每个人都会想一套出来讲"
    },
    {
      "end": 51.53,
      "id": 21,
      "start": 46.01,
      "text": "那自己是可以大声几乎这样"
    },
    {
      "end": 53.66,
      "id": 22,
      "start": 51.53,
      "text": "问题是说"
    },
    {
      "end": 57.27,
      "id": 23,
      "start": 53.66,
      "text": "比较没有能够"
    },
    {
      "end": 59.87,
      "id": 24,
      "start": 57.27,
      "text": "比较没有办法找到一个"
    },
    {
      "end": 64.77,
      "id": 25,
      "start": 59.87,
      "text": "觉得可信的感觉了"
    },
    {
      "end": 67.11,
      "id": 26,
      "start": 64.77,
      "text": "就是讲的都是很奇怪的一些状态"
    },
    {
      "end": 69.85,
      "id": 27,
      "start": 67.11,
      "text": "这样可以吗"
    },
    {
      "end": 70.05,
      "id": 28,
      "start": 69.85,
      "text": "对"
    },
    {
      "end": 74.74,
      "id": 29,
      "start": 70.05,
      "text": "所以这个怪怪的讲法会非常非常的多了"
    },
    {
      "end": 79.15,
      "id": 30,
      "start": 74.74,
      "text": "对可是我觉得像今天讲的那样一个状态"
    },
    {
      "end": 80.21,
      "id": 31,
      "start": 79.15,
      "text": "可能才是对的了"
    },
    {
      "end": 86.8,
      "id": 32,
      "start": 80.21,
