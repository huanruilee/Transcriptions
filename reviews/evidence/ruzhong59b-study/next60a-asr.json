      "text": "我们以前曾经有一个地方是有那个"
    },
    {
      "end": 27.3,
      "id": 7,
      "start": 22.11,
      "text": "自信什么射程什么什么的"
    },
    {
      "end": 29.12,
      "id": 8,
      "start": 27.3,
      "text": "造就了一切一切"
    },
    {
      "end": 30.4,
      "id": 9,
      "start": 29.12,
      "text": "已经有一个佛经了"
    },
    {
      "end": 31.68,
      "id": 10,
      "start": 30.4,
      "text": "就有讲这个话"
    },
    {
      "end": 35.26,
      "id": 11,
      "start": 31.68,
      "text": "那个在哪里"
    },
    {
      "end": 36.54,
      "id": 12,
      "start": 35.26,
      "text": "对对对微臣嘛"
    },
    {
      "end": 37.06,
      "id": 13,
      "start": 36.54,
      "text": "臣"
    },
    {
      "end": 40.08,
      "id": 14,
      "start": 37.06,
      "text": "他讲的是那个了"
    },
    {
      "end": 42.31,
      "id": 15,
      "start": 40.08,
      "text": "就是说随随随造成"
    },
    {
      "end": 43.85,
      "id": 16,
      "start": 42.31,
      "text": "是世间吗还是什么的"
    },
    {
      "end": 50.7,
