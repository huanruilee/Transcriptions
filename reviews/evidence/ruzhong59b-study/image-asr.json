      "text": "简单讲的话就是说"
    },
    {
      "end": 20.64,
      "id": 7,
      "start": 17.88,
      "text": "苗无有法治自行公义无事成故"
    },
    {
      "end": 22.92,
      "id": 8,
      "start": 20.64,
      "text": "大概这样对不对"
    },
    {
      "end": 23.6,
      "id": 9,
      "start": 22.92,
      "text": "可是就是说"
    },
    {
      "end": 25.48,
      "id": 10,
      "start": 23.6,
      "text": "现在世间一般的"
    },
    {
      "end": 29.76,
      "id": 11,
