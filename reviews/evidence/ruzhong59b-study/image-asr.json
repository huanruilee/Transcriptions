  "segments": [
    {
      "end": 2.15,
      "id": 0,
      "start": 0.63,
      "text": "这样怎么做得到的时候"
    },
    {
      "end": 3.63,
      "id": 1,
      "start": 2.15,
      "text": "就是变成一定要找"
    },
    {
      "end": 6.21,
      "id": 2,
      "start": 3.63,
      "text": "怎么讲"
    },
    {
      "end": 11.72,
      "id": 3,
      "start": 6.21,
      "text": "他许的来先让他在例子上面了"
    },
    {
      "end": 13.34,
      "id": 4,
      "start": 11.72,
      "text": "总之在例子上面"
    },
    {
      "end": 16.76,
      "id": 5,
