      "text": "无常意识 无意义"
    },
    {
      "end": 24.16,
      "id": 13,
      "start": 23.46,
      "text": "这样可以吗"
    },
    {
      "end": 25.72,
      "id": 14,
      "start": 24.16,
      "text": "所以这个也是一样的"
    },
    {
      "end": 28.2,
      "id": 15,
