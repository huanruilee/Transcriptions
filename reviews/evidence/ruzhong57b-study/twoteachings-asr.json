      "text": "刹那性是无常的定义"
    },
    {
      "end": 16.99,
      "id": 8,
      "start": 13.48,
      "text": "对 所以刹那性是无常的定义"
    },
    {
      "end": 18.31,
      "id": 9,
      "start": 16.99,
      "text": "可是就是变成"
    },
    {
      "end": 19.77,
      "id": 10,
