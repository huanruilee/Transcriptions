      "start": 0.63,
      "text": "佛经语云"
    },
    {
      "end": 4.05,
      "id": 1,
      "start": 1.87,
      "text": "无常意是无意义"
    },
    {
      "end": 4.83,
      "id": 2,
      "start": 4.05,
      "text": "对 无常"
    },
    {
      "end": 6.62,
      "id": 3,
