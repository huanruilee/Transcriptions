      "text": "已经那个出世间"
    },
    {
      "end": 45.72,
      "id": 23,
      "start": 43.68,
      "text": "这个跟上面有什么关系啊"
    },
    {
      "end": 46.5,
      "id": 24,
      "start": 45.72,
      "text": "你这个根本"
    },
    {
      "end": 48.76,
      "id": 25,
      "start": 46.5,
      "text": "我们就看不出它的关联嘛"
    },
    {
      "end": 51.65,
      "id": 26,
      "start": 48.76,
      "text": "对 所以成正之理"
    },
    {
      "end": 54.31,
      "id": 27,
      "start": 51.65,
      "text": "为佛与对法中"
    },
    {
      "end": 58.09,
      "id": 28,
      "start": 54.31,
      "text": "说四大种是促成"
    },
    {
      "end": 62.22,
      "id": 29,
