      "text": "怎么讲 需据许词二世"
    },
    {
      "end": 78.36,
      "id": 35,
      "start": 76.36,
      "text": "反正就是大种不是所见"
    },
    {
      "end": 80.32,
      "id": 36,
      "start": 78.36,
      "text": "大种所造才是所见"
    },
    {
      "end": 81.56,
      "id": 37,
      "start": 80.32,
      "text": "这个是要承许的了"
    },
    {
      "end": 83.04,
      "id": 38,
      "start": 81.56,
      "text": "这个是事实"
    },
    {
      "end": 86.14,
      "id": 39,
      "start": 83.04,
      "text": "对 佛明彼等"
    },
    {
      "end": 87.18,
      "id": 40,
      "start": 86.14,
      "text": "是真实义的时候"
    },
    {
      "end": 88.64,
      "id": 41,
      "start": 87.18,
      "text": "可是佛在讲空性的时候"
    },
    {
      "end": 91.31,
      "id": 42,
      "start": 88.64,
      "text": "事实上是这样一个状态"
    },
    {
      "end": 92.69,
      "id": 43,
      "start": 91.31,
      "text": "可是佛在讲空性的时候"
    },
    {
      "end": 94.03,
      "id": 44,
