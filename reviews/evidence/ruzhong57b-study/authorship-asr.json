  "segments": [
    {
      "end": 10.16,
      "id": 0,
      "start": 0.0,
      "text": "这本书上面有个注释说"
    },
    {
      "end": 13.24,
      "id": 1,
      "start": 10.16,
      "text": "智障极论是至心随即"
    },
    {
      "end": 15.94,
      "id": 2,
      "start": 13.24,
      "text": "近代学者说这个论不是提婆的作品"
    },
    {
      "end": 25.26,
      "id": 3,
      "start": 15.94,
      "text": "所以这本书说提婆菩萨意识智障"
    },
    {
      "end": 30.88,
      "id": 4,
      "start": 25.26,
      "text": "有明显的说法这样可以吗"
    },
    {
      "end": 34.42,
      "id": 5,
      "start": 30.88,
      "text": "钟大师说是提婆菩萨讲的了"
    },
    {
      "end": 36.8,
      "id": 6,
      "start": 34.42,
      "text": "近代学者的话是谁"
    },
    {
      "end": 43.75,
      "id": 7,
      "start": 36.8,
      "text": "没关系了反正就是这样"
    },
    {
      "end": 47.56,
      "id": 8,
      "start": 43.75,
      "text": "近代学者有近代学者的很多做法"
    },
    {
      "end": 58.58,
      "id": 9,
      "start": 47.56,
      "text": "所以就该怎么讲"
    },
    {
      "end": 61.97,
      "id": 10,
      "start": 58.58,
      "text": "近代学者的话会把相信菩提心识论"
    },
    {
      "end": 63.59,
      "id": 11,
      "start": 61.97,
      "text": "是不是龙树所造的"
    },
    {
      "end": 66.47,
      "id": 12,
      "start": 63.59,
      "text": "可能近代学者也有话说"
    },
    {
      "end": 69.68,
      "id": 13,
      "start": 66.47,
      "text": "因为菩提心识论"
    },
    {
      "end": 73.54,
      "id": 14,
      "start": 69.68,
      "text": "它是一个跟密集非常有关系的一本书"
    },
    {
      "end": 78.16,
      "id": 15,
      "start": 73.54,
      "text": "对而近代学者的话就会说"
    },
    {
      "end": 82.11,
      "id": 16,
      "start": 78.16,
      "text": "这些有关无上秘序的这些不是龙树写的吗"
    },
    {
      "end": 84.7,
      "id": 17,
      "start": 82.11,
      "text": "是一个另外的龙树写的吗"
    },
    {
      "end": 87.64,
      "id": 18,
