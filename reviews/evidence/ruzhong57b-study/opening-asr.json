  "segments": [
    {
      "end": 3.38,
      "id": 0,
      "start": 0.0,
      "text": "就是说维世忠以破无方分来破无外境"
    },
    {
      "end": 7.34,
      "id": 1,
      "start": 3.38,
      "text": "那同样的理路其实已经可以破内心了"
    },
    {
      "end": 10.74,
      "id": 2,
      "start": 7.34,
      "text": "但是只是维世忠没有那个赶量走这条路"
    },
    {
      "end": 12.3,
      "id": 3,
      "start": 10.74,
      "text": "对不对"
    },
    {
      "end": 14.56,
      "id": 4,
      "start": 12.3,
      "text": "就是说因为破了内心以后"
    },
    {
      "end": 18.2,
      "id": 5,
      "start": 14.56,
      "text": "就是唯一条合理道路就是走向硬沉内"
    },
    {
      "end": 20.23,
      "id": 6,
      "start": 18.2,
      "text": "那个方法"
    },
    {
      "end": 22.18,
      "id": 7,
      "start": 20.23,
      "text": "那否则就会多断电"
    },
    {
      "end": 24.26,
      "id": 8,
      "start": 22.18,
      "text": "那可是他不愿意走硬沉的路"
    },
    {
      "end": 26.54,
      "id": 9,
      "start": 24.26,
      "text": "所以他就没有用同样"
    },
    {
      "end": 29.08,
      "id": 10,
      "start": 26.54,
      "text": "破外境的那样的理路来破内心"
    },
    {
      "end": 30.36,
      "id": 11,
      "start": 29.08,
      "text": "老师刚刚这样讲"
    },
    {
      "end": 33.32,
      "id": 12,
      "start": 30.36,
      "text": "但是其实理路是可以破内心的"
    },
    {
      "end": 34.32,
      "id": 13,
      "start": 33.32,
      "text": "那这样就会"
    },
    {
      "end": 36.66,
      "id": 14,
      "start": 34.32,
      "text": "我会有一个问题"
    },
    {
      "end": 40.58,
      "id": 15,
      "start": 36.66,
      "text": "就是说因为维世忠在破无方分以后"
    },
    {
      "end": 41.58,
      "id": 16,
      "start": 40.58,
      "text": "就说没有外境"
    },
    {
      "end": 43.74,
      "id": 17,
      "start": 41.58,
      "text": "那样的理路顶多"
    },
    {
      "end": 48.06,
      "id": 18,
      "start": 43.74,
      "text": "顶多只能说它是运用了有知跟知分的缘起"
    },
    {
      "end": 49.2,
      "id": 19,
      "start": 48.06,
      "text": "顶多到这样"
    },
    {
      "end": 52.86,
      "id": 20,
      "start": 49.2,
      "text": "因为一切外境都是有知分"
    },
    {
      "end": 55.26,
      "id": 21,
      "start": 52.86,
      "text": "没有一个外境是所谓的无方分"
    },
    {
      "end": 56.9,
      "id": 22,
      "start": 55.26,
      "text": "所以呢怎样怎样"
    },
    {
      "end": 58.18,
      "id": 23,
      "start": 56.9,
      "text": "顶多是这样"
    },
    {
      "end": 60.14,
      "id": 24,
      "start": 58.18,
      "text": "那如果这样也可以把内心破掉"
    },
    {
      "end": 62.26,
      "id": 25,
      "start": 60.14,
      "text": "反正就因为没有所谓的无时分参"
    },
    {
      "end": 62.86,
      "id": 26,
      "start": 62.26,
      "text": "那行事"
    },
    {
      "end": 63.86,
      "id": 27,
      "start": 62.86,
      "text": "所以怎样这样"
    },
    {
      "end": 66.06,
      "id": 28,
      "start": 63.86,
      "text": "那这样子好像用这样的理路"
    },
    {
      "end": 68.95,
      "id": 29,
      "start": 66.06,
      "text": "就已经正得自信空了"
    },
    {
      "end": 71.19,
      "id": 30,
      "start": 68.95,
      "text": "那缘起之王者是"
    },
    {
      "end": 72.55,
      "id": 31,
      "start": 71.19,
      "text": "为民安利而有的缘起嘛"
    },
    {
      "end": 74.15,
      "id": 32,
      "start": 72.55,
      "text": "并不是有知之分的缘起"
    },
    {
      "end": 75.79,
      "id": 33,
      "start": 74.15,
      "text": "那这里要怎么去解释"
    },
    {
      "end": 85.94,
      "id": 34,
      "start": 75.79,
      "text": "大家有听到他在讲什么嘛"
    },
    {
      "end": 86.28,
      "id": 35,
      "start": 85.94,
      "text": "对不对"
    },
    {
      "end": 94.19,
      "id": 36,
      "start": 86.28,
      "text": "总之我谈到破外境的那个方式"
    },
    {
      "end": 96.16,
      "id": 37,
      "start": 94.19,
      "text": "其实转过来的话"
    },
    {
      "end": 99.1,
      "id": 38,
      "start": 96.16,
      "text": "是可以破那个内在的内心吧"
    },
    {
      "end": 103.44,
      "id": 39,
      "start": 99.1,
      "text": "人知能够破这样"
    },
    {
      "end": 106.43,
      "id": 40,
      "start": 103.44,
      "text": "对他的问题可能就是说"
    },
    {
      "end": 107.69,
      "id": 41,
      "start": 106.43,
      "text": "如果这个人的话"
    },
    {
      "end": 109.82,
      "id": 42,
      "start": 107.69,
      "text": "那总管讲的"
    },
    {
      "end": 111.88,
      "id": 43,
      "start": 109.82,
      "text": "怎么讲"
    },
    {
      "end": 115.12,
      "id": 44,
      "start": 111.88,
      "text": "缘起正义之类的"
    },
    {
      "end": 115.66,
      "id": 45,
      "start": 115.12,
      "text": "这样可以吗"
    },
    {
      "end": 117.78,
      "id": 46,
      "start": 115.66,
      "text": "这个好像不需要吗"
    },
    {
      "end": 118.24,
      "id": 47,
      "start": 117.78,
      "text": "还是什么"
    },
    {
      "end": 121.64,
      "id": 48,
      "start": 118.24,
      "text": "对 为民安利要怎么"
    },
    {
      "end": 125.74,
      "id": 49,
      "start": 121.64,
      "text": "为民安利要怎么"
    },
    {
      "end": 130.88,
      "id": 50,
      "start": 125.74,
      "text": "对 所以我是觉得"
    },
    {
      "end": 132.32,
      "id": 51,
      "start": 130.88,
      "text": "这个里面是不是有这样一个状态"
    },
    {
      "end": 136.24,
      "id": 52,
      "start": 132.32,
      "text": "我刚才讲的是破外境"
    },
    {
      "end": 138.68,
      "id": 53,
      "start": 136.24,
      "text": "用这个方式来破内在"
    },
    {
      "end": 140.58,
      "id": 54,
      "start": 138.68,
      "text": "能够破这样"
    },
    {
      "end": 143.93,
      "id": 55,
      "start": 140.58,
      "text": "对 你是谈到的是一个利"
    },
    {
      "end": 146.76,
      "id": 56,
      "start": 143.93,
      "text": "为民安利"
    },
    {
      "end": 147.98,
      "id": 57,
      "start": 146.76,
      "text": "这样可以吗"
    },
    {
      "end": 151.24,
      "id": 58,
      "start": 147.98,
      "text": "对 就谈到能够这样利吗"
    },
    {
      "end": 156.17,
      "id": 59,
      "start": 151.24,
      "text": "这样 好了 我听成这个样子"
    },
    {
      "end": 158.47,
      "id": 60,
      "start": 156.17,
      "text": "这样可以吗"
    },
    {
      "end": 162.11,
      "id": 61,
      "start": 158.47,
      "text": "对 我是把它听成这个部分"
    },
    {
      "end": 165.22,
      "id": 62,
      "start": 162.11,
      "text": "中观应成要能够建立什么"
    },
    {
      "end": 165.68,
      "id": 63,
      "start": 165.22,
      "text": "对不对"
    },
    {
      "end": 167.56,
      "id": 64,
      "start": 165.68,
      "text": "这个部分怎么能这样"
    },
    {
      "end": 170.98,
      "id": 65,
      "start": 167.56,
      "text": "对 我是觉得"
    },
    {
      "end": 172.02,
      "id": 66,
      "start": 170.98,
      "text": "对 为民安利要能够建立什么"
    },
    {
      "end": 173.68,
      "id": 67,
      "start": 172.02,
      "text": "对 为民安利要求建立的"
    },
    {
      "end": 174.86,
      "id": 68,
      "start": 173.68,
      "text": "如果这个人的话"
    },
    {
      "end": 175.4,
      "id": 69,
      "start": 174.86,
      "text": "可以直接在这个地方"
    },
    {
      "end": 175.82,
      "id": 70,
      "start": 175.4,
      "text": "也能够建立什么"
    },
    {
      "end": 176.68,
      "id": 71,
      "start": 175.82,
      "text": "对ane"
    },
    {
      "end": 177.58,
      "id": 72,
      "start": 176.68,
      "text": "听到的"
    },
    {
      "end": 179.5,
      "id": 73,
      "start": 177.58,
      "text": "我们就能够建立什么"
    },
    {
      "end": 180.86,
      "id": 74,
      "start": 179.5,
      "text": "的"
    },
    {
      "end": 181.56,
      "id": 75,
