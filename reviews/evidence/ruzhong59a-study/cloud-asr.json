  "segments": [
    {
      "end": 2.62,
      "id": 0,
      "start": 0.0,
      "text": "若为由于之"
    },
    {
      "end": 4.89,
      "id": 1,
      "start": 2.62,
      "text": "怎么讲"
    },
    {
      "end": 5.33,
      "id": 2,
      "start": 4.89,
      "text": "复辟"
    },
    {
      "end": 9.64,
      "id": 3,
      "start": 5.33,
      "text": "由于于之的复辟"
    },
    {
      "end": 13.48,
      "id": 4,
      "start": 9.64,
      "text": "虽可以不见真正的真实义"
    },
    {
      "end": 13.86,
      "id": 5,
      "start": 13.48,
      "text": "对不对"
    },
    {
      "end": 17.47,
      "id": 6,
      "start": 13.86,
      "text": "虽然可以见不到真正的自信"
    },
    {
      "end": 20.27,
      "id": 7,
      "start": 17.47,
      "text": "为什么反而会说见到"
    },
    {
      "end": 22.18,
      "id": 8,
      "start": 20.27,
      "text": "颠倒的自信"
    },
    {
      "end": 24.12,
      "id": 9,
      "start": 22.18,
      "text": "这样对吗"
    },
    {
      "end": 25.94,
      "id": 10,
      "start": 24.12,
      "text": "对反正就是很厚的云遮住"
    },
    {
      "end": 28.65,
      "id": 11,
      "start": 25.94,
      "text": "所以见不到什么真的什么东西"
    },
    {
      "end": 29.55,
      "id": 12,
      "start": 28.65,
      "text": "是OK的了"
    },
    {
      "end": 33.51,
      "id": 13,
      "start": 29.55,
      "text": "那为什么会反倒见一个另外的"
    },
    {
      "end": 35.27,
      "id": 14,
      "start": 33.51,
      "text": "假的什么东西这样"
    },
    {
      "end": 39.58,
      "id": 15,
      "start": 35.27,
      "text": "虽无自信而现由此"
    },
    {
      "end": 42.7,
      "id": 16,
      "start": 39.58,
      "text": "对所以就变成没有自信有"
    },
    {
      "end": 46.12,
      "id": 17,
      "start": 42.7,
      "text": "但是所见到的自信吗"
    },
    {
      "end": 46.58,
      "id": 18,
      "start": 46.12,
      "text": "还是什么"
    },
    {
      "end": 47.76,
      "id": 19,
      "start": 46.58,
      "text": "现我有自信"
    },
    {
      "end": 49.34,
      "id": 20,
      "start": 47.76,
      "text": "是于于此等利"
    },
    {
      "end": 53.1,
      "id": 21,
      "start": 49.34,
      "text": "反正于此是可以做得出这个就对了"
    },
    {
      "end": 56.44,
      "id": 22,
      "start": 53.1,
      "text": "当以外遇现实这样对吗"
    },
    {
      "end": 57.4,
      "id": 23,
      "start": 56.44,
      "text": "再举个例子的话"
    },
    {
      "end": 58.0,
      "id": 24,
      "start": 57.4,
      "text": "就是说"
    },
    {
      "end": 60.38,
      "id": 25,
      "start": 58.0,
      "text": "有了个眼异症的人"
    },
    {
      "end": 63.18,
      "id": 26,
      "start": 60.38,
      "text": "会有了个导职"
    },
    {
      "end": 67.88,
      "id": 27,
      "start": 63.18,
      "text": "有了个怎么讲毛法在那边"
    },
    {
      "end": 70.36,
      "id": 28,
      "start": 67.88,
      "text": "还有就是二月"
    },
    {
      "end": 74.4,
      "id": 29,
      "start": 70.36,
      "text": "雀宁神等"
    },
    {
      "end": 78.5,
      "id": 30,
      "start": 74.4,
      "text": "如是无自有吃过"
    },
    {
      "end": 81.89,
      "id": 31,
      "start": 78.5,
      "text": "以种种会观有为"
    },
    {
      "end": 83.35,
      "id": 32,
      "start": 81.89,
      "text": "这样对吗"
    },
    {
      "end": 86.71,
      "id": 33,
      "start": 83.35,
      "text": "用以种种协会把观有为"
    },
    {
      "end": 89.44,
      "id": 34,
      "start": 86.71,
      "text": "反正就是把没有自信的"
    },
    {
      "end": 90.38,
      "id": 35,
      "start": 89.44,
      "text": "现为有自信"
    },
    {
      "end": 93.2,
      "id": 36,
      "start": 90.38,
      "text": "对所以就变成"
    },
    {
      "end": 99.74,
      "id": 37,
      "start": 93.2,
      "text": "炎异症是不是会让我们导致有那个毛法"
    },
    {
      "end": 102.18,
      "id": 38,
      "start": 99.74,
      "text": "就是这样的一个意思了"
    },
    {
      "end": 107.14,
      "id": 39,
      "start": 102.18,
      "text": "对所以一方面就是可能像云一样"
    },
    {
      "end": 109.08,
      "id": 40,
      "start": 107.14,
      "text": "就是遮住见不到晴天这样"
    },
    {
      "end": 111.75,
      "id": 41,
      "start": 109.08,
      "text": "另外一方面就有点像是炎异症"
    },
    {
      "end": 115.06,
      "id": 42,
      "start": 111.75,
      "text": "预刺把预刺就像炎异症"
    },
    {
      "end": 118.66,
      "id": 43,
      "start": 115.06,
      "text": "让我们颠倒的看到什么这样"
    },
    {
      "end": 122.6,
      "id": 44,
      "start": 118.66,
      "text": "如有益根"
    },
    {
      "end": 124.92,
      "id": 45,
      "start": 122.6,
      "text": "由玄异利"
    },
    {
      "end": 126.52,
      "id": 46,
      "start": 124.92,
      "text": "虽无毛法"
    },
    {
      "end": 129.63,
      "id": 47,
      "start": 126.52,
      "text": "基本就是因为这个病的原因"
    },
    {
      "end": 130.67,
      "id": 48,
      "start": 129.63,
      "text": "没有毛法"
    },
    {
      "end": 131.67,
      "id": 49,
      "start": 130.67,
      "text": "没有二月"
    },
    {
      "end": 132.71,
      "id": 50,
      "start": 131.67,
      "text": "确离"
    },
    {
      "end": 134.34,
      "id": 51,
      "start": 132.71,
      "text": "风神等事"
    },
    {
      "end": 135.86,
      "id": 52,
      "start": 134.34,
      "text": "可是呢"
    },
    {
      "end": 137.02,
      "id": 53,
      "start": 135.86,
      "text": "就是会导致"
    },
    {
      "end": 138.18,
      "id": 54,
      "start": 137.02,
      "text": "他为有"
    },
    {
      "end": 140.58,
      "id": 55,
      "start": 138.18,
      "text": "如是足"
    },
    {
      "end": 142.6,
      "id": 56,
      "start": 140.58,
      "text": "无自的一生"
    },
    {
      "end": 145.6,
      "id": 57,
      "start": 142.6,
      "text": "由于吃过失利固"
    },
    {
      "end": 146.74,
      "id": 58,
      "start": 145.6,
      "text": "以种种"
    },
    {
      "end": 147.94,
      "id": 59,
      "start": 146.74,
      "text": "会见"
    },
    {
      "end": 149.63,
      "id": 60,
      "start": 147.94,
      "text": "观察"
    },
    {
      "end": 150.53,
      "id": 61,
      "start": 149.63,
      "text": "清等"
    },
    {
      "end": 151.75,
      "id": 62,
      "start": 150.53,
      "text": "自有为"
    },
    {
      "end": 154.67,
      "id": 63,
