      "id": 0,
      "start": 0.38,
      "text": "由玄义者所见尽"
    },
    {
      "end": 7.75,
      "id": 1,
      "start": 2.7,
      "text": "比毛法等皆不生"
    },
    {
      "end": 13.11,
      "id": 2,
      "start": 7.75,
      "text": "如此以比而变真"
    },
    {
      "end": 15.66,
      "id": 3,
      "start": 13.11,
      "text": "后者无名嫌疑者"
    },
    {
      "end": 19.05,
      "id": 4,
      "start": 15.66,
      "text": "讲了这么一个话"
    },
    {
      "end": 20.67,
      "id": 5,
      "start": 19.05,
      "text": "反正你先去跟什么什么真嘛"
