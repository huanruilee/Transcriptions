  "segments": [
    {
      "end": 1.5,
      "id": 0,
      "start": 0.0,
      "text": "对 装置是智者吗"
    },
    {
      "end": 3.76,
      "id": 1,
      "start": 1.5,
      "text": "还是什么 智者见无名"
    },
    {
      "end": 7.74,
      "id": 2,
      "start": 3.76,
      "text": "智者见说无名原形"
    },
    {
      "end": 10.56,
      "id": 3,
      "start": 7.74,
      "text": "这样对吗 智者"
    },
    {
      "end": 14.76,
      "id": 4,
      "start": 10.56,
      "text": "非但了达诸行空无自信"
    },
    {
      "end": 18.17,
      "id": 5,
      "start": 14.76,
      "text": "对 所以就是变成无名原形"
    },
    {
      "end": 21.0,
      "id": 6,
      "start": 18.17,
      "text": "或者是行事源无名而生的"
    },
    {
      "end": 24.0,
      "id": 7,
      "start": 21.0,
      "text": "智者基于这个"
    },
    {
      "end": 25.71,
      "id": 8,
      "start": 24.0,
      "text": "就能够了达空性"
    },
    {
      "end": 26.61,
      "id": 9,
      "start": 25.71,
      "text": "无自信"
    },
    {
      "end": 31.46,
      "id": 10,
      "start": 26.61,
      "text": "这个OK吗 对不对"
    },
    {
      "end": 35.9,
      "id": 11,
      "start": 31.46,
      "text": "对 装置就是变成"
    },
    {
      "end": 38.1,
      "id": 12,
      "start": 35.9,
      "text": "因果原起或者自分原起"
    },
    {
      "end": 39.3,
      "id": 13,
      "start": 38.1,
      "text": "或者说装置就是说"
    },
    {
      "end": 42.26,
      "id": 14,
      "start": 39.3,
      "text": "最主要是为民安利的原起吧"
    },
    {
      "end": 43.66,
      "id": 15,
      "start": 42.26,
      "text": "智者如果能够见到"
    },
    {
      "end": 44.96,
      "id": 16,
      "start": 43.66,
      "text": "为民安利的原起的话"
    },
    {
      "end": 49.2,
      "id": 17,
      "start": 44.96,
      "text": "当然就非常的容易了解智行空这样"
    },
    {
      "end": 53.02,
      "id": 18,
      "start": 49.2,
      "text": "且以同达原起真理的会日"
    },
    {
      "end": 55.42,
      "id": 19,
      "start": 53.02,
      "text": "总之就是变成原起智行空的智慧"
    },
    {
      "end": 61.58,
      "id": 20,
      "start": 55.42,
      "text": "破除如同一样的无名"
    },
    {
      "end": 67.42,
      "id": 21,
      "start": 61.58,
      "text": "记忆不取诸业"
    },
    {
      "end": 69.02,
      "id": 22,
      "start": 67.42,
      "text": "不 没有无名嘛"
    },
    {
      "end": 72.54,
      "id": 23,
      "start": 69.02,
      "text": "就变成就无形这样"
    },
    {
      "end": 75.64,
      "id": 24,
      "start": 72.54,
      "text": "由于断造业的无名因"
    },
    {
      "end": 79.05,
      "id": 25,
      "start": 75.64,
      "text": "故意决定解脱生死"
    },
    {
      "end": 83.81,
      "id": 26,
      "start": 79.05,
      "text": "总之就是说"
    },
    {
      "end": 88.72,
      "id": 27,
      "start": 83.81,
      "text": "生那个行这样"
    },
    {
      "end": 91.56,
      "id": 28,
      "start": 88.72,
      "text": "这个了解空性"
    },
    {
      "end": 92.76,
      "id": 29,
      "start": 91.56,
      "text": "断除无名"
    },
    {
      "end": 95.58,
      "id": 30,
      "start": 92.76,
      "text": "嗯 不早意"
    },
    {
      "end": 98.52,
      "id": 31,
      "start": 95.58,
      "text": "波勒诵里头就谈到"
    },
    {
      "end": 100.72,
      "id": 32,
      "start": 98.52,
      "text": "菩萨般若观原起"
    },
    {
      "end": 103.1,
      "id": 33,
      "start": 100.72,
      "text": "鸟子无生"
    },
    {
      "end": 104.2,
      "id": 34,
      "start": 103.1,
      "text": "无有尽"
    },
    {
      "end": 105.2,
      "id": 35,
      "start": 104.2,
      "text": "不生意不灭"
    },
    {
      "end": 106.5,
      "id": 36,
      "start": 105.2,
      "text": "这样对吗"
    },
    {
      "end": 107.6,
      "id": 37,
      "start": 106.5,
      "text": "跟不生意不灭一样"
    },
    {
      "end": 110.24,
      "id": 38,
      "start": 107.6,
      "text": "就是无生意无尽"
    },
    {
      "end": 111.54,
      "id": 39,
      "start": 110.24,
      "text": "嗯 如日"
    },
    {
      "end": 113.54,
      "id": 40,
      "start": 111.54,
      "text": "无云放光明"
    },
    {
      "end": 115.43,
      "id": 41,
      "start": 113.54,
      "text": "就没有那个无云了"
    },
    {
      "end": 116.63,
      "id": 42,
      "start": 115.43,
      "text": "破无名障"
    },
    {
      "end": 119.94,
      "id": 43,
      "start": 116.63,
      "text": "嗯 正菩提"
    },
    {
      "end": 121.34,
      "id": 44,
      "start": 119.94,
      "text": "若未射等诸法与真实"
    },
    {
      "end": 124.24,
      "id": 45,
      "start": 121.34,
      "text": "生意中都无自信者"
    },
    {
      "end": 128.1,
      "id": 46,
      "start": 124.24,
      "text": "对 所以这个的话就是变成"
    },
    {
      "end": 130.1,
      "id": 47,
      "start": 128.1,
      "text": "嗯 以上大概OK吧"
    },
    {
      "end": 132.9,
      "id": 48,
      "start": 130.8,
      "text": "以上其实简单讲的话就"
    },
    {
      "end": 136.9,
      "id": 49,
      "start": 132.9,
      "text": "该怎么讲"
    },
    {
      "end": 140.8,
      "id": 50,
      "start": 136.9,
      "text": "就是因为有一个很厚重的无名"
    },
    {
      "end": 142.2,
      "id": 51,
      "start": 140.8,
      "text": "所以就会看不到自信"
    },
    {
      "end": 142.8,
      "id": 52,
      "start": 142.2,
      "text": "对不对"
    },
    {
      "end": 145.12,
      "id": 53,
      "start": 142.8,
      "text": "反而会看到自信"
    },
    {
      "end": 146.58,
      "id": 54,
      "start": 145.12,
      "text": "就是这样"
    },
    {
      "end": 149.42,
      "id": 55,
      "start": 146.58,
      "text": "那看不到自信也就罢了"
    },
    {
      "end": 152.52,
      "id": 56,
      "start": 149.42,
      "text": "为什么会无名反而会导致看到自信"
    },
    {
      "end": 156.28,
      "id": 57,
      "start": 152.52,
      "text": "嗯 因为就像有悬疑"
    },
    {
      "end": 159.22,
      "id": 58,
      "start": 156.28,
      "text": "这样跟这个一样这样"
    },
    {
      "end": 160.22,
      "id": 59,
      "start": 159.22,
      "text": "嗯 对"
    },
    {
      "end": 163.58,
      "id": 60,
      "start": 160.22,
      "text": "所以具有无名的就会这个样子"
    },
    {
      "end": 165.38,
      "id": 61,
      "start": 163.58,
      "text": "了解空性的话就会"
    },
    {
      "end": 166.96,
      "id": 62,
      "start": 165.38,
      "text": "才会反过去"
    },
    {
      "end": 168.17,
      "id": 63,
      "start": 166.96,
      "text": "就是这样的意思"
    },
    {
      "end": 168.77,
      "id": 64,
      "start": 168.17,
      "text": "对不对"
    },
    {
      "end": 169.57,
      "id": 65,
      "start": 168.77,
      "text": "以上"
    },
    {
      "end": 171.69,
      "id": 66,
      "start": 169.57,
      "text": "那接下去的话就是说"
    },
    {
      "end": 175.39,
      "id": 67,
      "start": 171.69,
      "text": "若与射等诸法与真实意中都无自信"
    },
    {
      "end": 178.18,
      "id": 68,
      "start": 175.39,
      "text": "对 总之就是说"
    },
    {
      "end": 180.18,
      "id": 69,
      "start": 178.18,
      "text": "如果说瓶子无自信者"
    },
    {
      "end": 182.17,
      "id": 70,
      "start": 180.18,
      "text": "诸法无自信者"
    },
    {
      "end": 185.68,
      "id": 71,
      "start": 182.17,
      "text": "对 如果诸法无自信的话"
    },
    {
      "end": 187.28,
      "id": 72,
      "start": 185.68,
      "text": "应该像是女儿"
    },
    {
      "end": 190.48,
      "id": 73,
      "start": 187.28,
      "text": "与明眼中一无情等自信"
    },
    {
      "end": 191.18,
      "id": 74,
      "start": 190.48,
      "text": "这样可以吗"
    },
    {
      "end": 195.64,
      "id": 75,
      "start": 191.18,
      "text": "对 如果圣意中无自信的话"
    },
    {
      "end": 198.91,
      "id": 76,
      "start": 195.64,
      "text": "明眼中也不应该有自信"
    },
    {
      "end": 201.51,
      "id": 77,
      "start": 198.91,
      "text": "然设等于世俗有故"
    },
    {
      "end": 202.88,
      "id": 78,
      "start": 201.51,
      "text": "故彼等于有"
    },
    {
      "end": 203.88,
      "id": 79,
      "start": 202.88,
      "text": "应是自信有"
    },
    {
      "end": 205.4,
      "id": 80,
      "start": 203.88,
      "text": "这样可以吗"
    },
    {
      "end": 206.8,
      "id": 81,
      "start": 205.4,
      "text": "圣意中无自信的话"
    },
    {
      "end": 208.6,
      "id": 82,
