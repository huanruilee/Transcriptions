      "text": "故彼定义自信有"
    },
    {
      "end": 249.55,
      "id": 97,
      "start": 248.25,
      "text": "这样可以吗"
    },
    {
      "end": 250.65,
      "id": 98,
      "start": 249.55,
      "text": "因为明眼中有"
    },
    {
      "end": 252.15,
      "id": 99,
