      "sourceFirst": 235,
      "sourceLast": 250,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p14-s2",
      "start": 1724.06,
      "end": 1805.95,
      "text": "問：我們好像雞同鴨講。我避開直接用業滅這名詞，只說第二剎那業已不存在。這個不存在是遮法，另外又引出有為法，那業滅到底是哪一個？答：你說「它會引出」，這個它到底指誰？你一直換指涉。問：一件是它消失，一件是它引生。答：這真像在打游擊。",
      "sourceSentenceIds": [
        "sent-251",
        "sent-252",
        "sent-253",
        "sent-254",
        "sent-255",
        "sent-256",
        "sent-257",
        "sent-258",
        "sent-259",
        "sent-260",
        "sent-261",
        "sent-262",
        "sent-263",
        "sent-264"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 251,
      "sourceLast": 264,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p15-s1",
      "start": 1807.82,
      "end": 1876.65,
      "text": "答：我猜，你問的還是業滅是遮法、是遮非，它所拋出的到底是什麼？可是你又說不是，那我實在聽不懂。問：我聽以前講業滅，一直指向所引的法延續下去；現在是不是只有第一剎那於第二剎那滅這個遮非？那它是有為法嗎？答：你看，一定要轉三轉。我放棄了。【編者註】當堂沒有將這串疑問完整釐清，不能整理成雙方已達成一致。",
      "sourceSentenceIds": [
        "sent-265",
        "sent-266",
        "sent-267",
        "sent-268",
        "sent-269",
        "sent-270",
        "sent-271",
        "sent-272",
        "sent-273",
        "sent-274",
        "sent-275",
        "sent-276"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 265,
      "sourceLast": 276,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p16-s1",
      "start": 1877.78,
      "end": 1915.35,
      "text": "要用簡單方式問：聲音是不是無常？如果聽不懂，可以先說清什麼叫聲音、什麼叫無常；但先把「聲音是不是無常」這一問解決，再往下談。不要一下又換一個問題，那就抓不住。",
      "sourceSentenceIds": [
        "sent-277",
        "sent-278",
        "sent-279",
        "sent-280",
        "sent-281",
        "sent-282",
        "sent-283",
        "sent-284"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 277,
      "sourceLast": 284,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p16-s2",
      "start": 1921.14,
      "end": 2020.03,
      "text": "論式裡先抓什麼是什麼、什麼有沒有什麼，複雜問題也不超出這個。先搞清是不是，再說若是如此會怎樣。說明可以很多，但要抓穩所問。我真的不是故意刁難、找碴，是問這個又跳另一個，實在抓不住。",
      "sourceSentenceIds": [
        "sent-285",
        "sent-286",
        "sent-287",
        "sent-288",
        "sent-289",
        "sent-290",
        "sent-291",
        "sent-292",
        "sent-293",
        "sent-294",
        "sent-295",
        "sent-296",
        "sent-297",
        "sent-298",
        "sent-299"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 285,
      "sourceLast": 299,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p17-s1",
      "start": 2026.01,
      "end": 2084.42,
      "text": "接下去126頁，釋妨難：先釋異熟無窮難，再釋違阿賴耶教難。經裡真的說過阿賴耶識，不能只說佛講了但我不承認，總要有個解釋。【編者註】經名音近誤字留原話；後文才依127頁定位《楞伽經》《解深密經》等。",
      "sourceSentenceIds": [
        "sent-300",
        "sent-301",
        "sent-302",
        "sent-303",
        "sent-304",
        "sent-305",
        "sent-306",
        "sent-307",
        "sent-308"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 300,
      "sourceLast": 308,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p17-s2",
      "start": 2085.64,
      "end": 2124.68,
      "text": "另一個問題是：既然無自性，怎麼還能善業生樂、惡業生苦？可是我們說的是自性無，不是說業完全不存在。不要把這兩個混在一起。",
      "sourceSentenceIds": [
        "sent-309",
        "sent-310",
        "sent-311",
        "sent-312",
        "sent-313",
        "sent-314",
        "sent-315"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 309,
      "sourceLast": 315,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p18-s1",
      "start": 2127.68,
      "end": 2188.61,
      "text": "問：若業自性不生、自性不滅，仍能感異熟，那已感異熟的業，豈不還要繼續感，成無窮過？回答用譬喻：「如境雖俱非有性，有翳唯見毛髮相，而非見為餘物相，當知已熟不更熟。」已熟，就不再熟。",
      "sourceSentenceIds": [
        "sent-316",
        "sent-317",
        "sent-318",
        "sent-319",
        "sent-320",
        "sent-321",
        "sent-322",
        "sent-323",
        "sent-324",
        "sent-325",
        "sent-326"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 316,
      "sourceLast": 326,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p18-s2",
      "start": 2189.78,
      "end": 2263.64,
      "text": "有眼翳的人，只見毛髮、飛蚊那種相，不會見兔角。飛蚊相所指的外境與兔角都不存在，但不是一樣不存在就亂見。跟這個一樣，業雖都無自性，未熟業能感異熟，已熟業不會再感。【編者註】這是眼翳見相的譬喻，不把講者口語改作對眼疾的醫學判斷。",
      "sourceSentenceIds": [
        "sent-327",
        "sent-328",
        "sent-329",
        "sent-330",
        "sent-331",
        "sent-332",
        "sent-333",
        "sent-334",
        "sent-335",
        "sent-336",
        "sent-337"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 327,
      "sourceLast": 337,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p19-s1",
      "start": 2265.1,
      "end": 2396.98,
      "text": "這不只成立業定有果，也成立善不善業感苦樂果各別決定，不會亂來。「故見苦果由黑業，樂果唯從善業生，無善惡慧得解脫，亦遮思惟諸業果。」我讀到無善惡慧，先想可能是無分別、空性那樣的慧；接著解釋，就是通達善不善業自性不可得的慧，好好修便得解脫。不是取消善惡：可愛樂異熟不從不善業生，非愛苦異熟不從善業生。",
      "sourceSentenceIds": [
        "sent-338",
        "sent-339",
        "sent-340",
        "sent-341",
        "sent-342",
        "sent-343",
        "sent-344",
        "sent-345",
        "sent-346",
        "sent-347",
        "sent-348",
        "sent-349",
        "sent-350",
        "sent-351"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 338,
      "sourceLast": 351,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p20-s1",
      "start": 2398.14,
      "end": 2482.75,
      "text": "佛恐凡夫樂以理智詳細觀察，卻沒有智慧，去推想這樣差別的業為什麼感那樣差別的果，反而毀謗業果、壞世俗諦，所以說諸業異熟不可思議，遮止這種思擇。看到「遮止思擇」是不是有點怪？要看下面：此論怕人對業果退失定見，所以由多門令人生定解；空性見也是資助業果決定。已到寶洲，要善努力，不要徒手而返。",
      "sourceSentenceIds": [
        "sent-352",
        "sent-353",
        "sent-354",
        "sent-355",
        "sent-356",
        "sent-357",
        "sent-358",
        "sent-359",
        "sent-360",
        "sent-361",
        "sent-362",
        "sent-363",
        "sent-364"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 352,
      "sourceLast": 364,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p20-s2",
      "start": 2484.38,
      "end": 2533,
      "text": "總結兩個：業與業滅雖無自性，已感者不會因此又感異熟；業滅無自性，善惡也不會混淆。這兩件事都用剛才眼翳的例子來講。",
      "sourceSentenceIds": [
        "sent-365",
        "sent-366",
        "sent-367",
        "sent-368",
        "sent-369",
        "sent-370",
        "sent-371",
        "sent-372",
        "sent-373",
        "sent-374"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 365,
      "sourceLast": 374,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p21-s1",
      "start": 2535.24,
      "end": 2642.07,
      "text": "接下來本來想放下堂，還有五分鐘，那就講吧。釋違阿賴耶教難分三：正釋違教文義、離意識外說不說有異體阿賴耶之理、密意言教之喻。第一正答，第二解釋為什麼佛對一些弟子說有、另一些說沒有，第三再用譬喻。這裡只先看正文。",
      "sourceSentenceIds": [
        "sent-375",
        "sent-376",
        "sent-377",
        "sent-378",
        "sent-379",
        "sent-380",
        "sent-381",
        "sent-382",
        "sent-383",
        "sent-384",
        "sent-385",
        "sent-386",
        "sent-387",
        "sent-388"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 375,
      "sourceLast": 388,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p22-s1",
      "start": 2646.01,
      "end": 2711.84,
      "text": "問：若無阿賴耶識也能安立業果，那《楞伽經》《解深密經》《阿毗達摩大乘經》等，說阿賴耶識為一切有為法功能差別的所依，名一切種，如海起波浪，作內外一切諸法生起之因，難道這些建立一切非有嗎？【編者註】此處經名與讀句依127頁核字，底本是文字參考，不是人工聽核證明。",
      "sourceSentenceIds": [
        "sent-389",
        "sent-390",
        "sent-391",
        "sent-392",
        "sent-393",
        "sent-394",
        "sent-395",
        "sent-396",
        "sent-397",
        "sent-398"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 389,
      "sourceLast": 398,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p22-s2",
      "start": 2717.19,
      "end": 2795.08,
      "text": "答「不爾」。要好好看，問的是：難道這些建立全沒有？答不是沒有。對需要說有阿賴耶識才能調伏的眾生，就應說有；所以這些建立不是沒有，是因為有這樣教化的需要。",
      "sourceSentenceIds": [
        "sent-399",
        "sent-400",
        "sent-401",
        "sent-402",
        "sent-403",
        "sent-404",
        "sent-405",
        "sent-406",
        "sent-407",
        "sent-408"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 399,
      "sourceLast": 408,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p23-s1",
      "start": 2798.5,
      "end": 2873.61,
      "text": "為調伏眾生而說有阿賴耶識，自宗說它是密意教，或者說非了義。那密意是什麼？底本說唯說自性空之空性，名阿賴耶識。為什麼這樣稱？因為空性隨一切法轉；一切法自性空，才會有緣起的一切。",
      "sourceSentenceIds": [
        "sent-409",
        "sent-410",
        "sent-411",
        "sent-412",
        "sent-413",
        "sent-414",
        "sent-415",
        "sent-416",
        "sent-417",
        "sent-418",
        "sent-419"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 409,
      "sourceLast": 419,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p23-s2",
      "start": 2873.61,
      "end": 2902.91,
      "text": "就像我以前講過的青蛙，你們還記得嗎？以前在色拉，大家傳我們房間有鬼。我覺得奇怪，怎麼會有鬼？後來搞來搞去，原來是我自己傳出去的。",
      "sourceSentenceIds": [
        "sent-420",
        "sent-421",
        "sent-422",
        "sent-423"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 420,
      "sourceLast": 423,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p24-s1",
      "start": 2906,
      "end": 2979.9,
      "text": "我們房裡有水罈，上面放盤子、水杯，想喝水就去那邊。水罈下面滴水，地面比較潮，偶爾三五隻青蛙跑進去。我愛講故事，別人來聽，我看到青蛙，就說肚子大、眼睛圓、頭尖，晚上還有叫聲，我把它講成青蛙鬼。",
      "sourceSentenceIds": [
        "sent-424",
        "sent-425",
        "sent-426",
        "sent-427",
        "sent-428",
        "sent-429",
        "sent-430",
        "sent-431",
        "sent-432",
        "sent-433"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 424,
      "sourceLast": 433,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p24-s2",
      "start": 2981.09,
      "end": 3025.74,
      "text": "我描述兩個圓圓的眼睛、尖頭、大肚子，故意講成鬼，別人聽來也是鬼，覺得很可怕。後來傳得沸沸揚揚，好像大家都知道，反而我不知道；最後才發現，是我自己講出去的。我心裡講的是青蛙。",
      "sourceSentenceIds": [
        "sent-434",
        "sent-435",
        "sent-436",
        "sent-437",
        "sent-438",
        "sent-439"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 434,
      "sourceLast": 439,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p25-s1",
      "start": 3025.74,
      "end": 3056.39,
      "text": "跟這個一樣，佛陀想著自性空，卻用阿賴耶識這個名稱來說：由這個才有一切可能，是一切生起之因，等等。好像把它講得比較實在。【編者註・存疑】原稿反覆作「影像自性空」，此處按當堂底本自性空的語境整理；確切音詞尚未逐句聽核，不據此另立影像術語。",
      "sourceSentenceIds": [
        "sent-440",
        "sent-441",
        "sent-442",
        "sent-443",
        "sent-444",
        "sent-445"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 440,
      "sourceLast": 445,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study40B-p25-s2",
      "start": 3057.69,
      "end": 3104.9400000000005,
      "text": "這裡要抓兩個：第一，有說阿賴耶識，是由密意而說，不能直接當作字面事實；第二，它基於什麼而說、密意所依是什麼？這裡指自性空。大概是這個狀態。好，今天講到這邊。",
      "sourceSentenceIds": [
        "sent-446",
        "sent-447",
        "sent-448",
        "sent-449",
        "sent-450",
        "sent-451",
        "sent-452",
        "sent-453",
        "sent-454"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 446,
      "sourceLast": 454,
      "editorialRole": "source-bound-study-guide"
    }
  ]
}
