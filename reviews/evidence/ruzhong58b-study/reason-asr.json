    {
      "end": 1.9,
      "id": 0,
      "start": 0.0,
      "text": "某一生的话"
    },
    {
      "end": 4.04,
      "id": 1,
      "start": 1.9,
      "text": "也相当于会有自生"
    },
    {
      "end": 4.52,
      "id": 2,
      "start": 4.04,
      "text": "对不对"
    },
    {
      "end": 9.4,
      "id": 3,
      "start": 4.52,
      "text": "这两个就大概就是这样一个状态"
    },
    {
      "end": 13.84,
      "id": 4,
      "start": 9.4,
      "text": "诸记大志在天等人生诸法者"
    },
    {
      "end": 15.33,
      "id": 5,
      "start": 13.84,
      "text": "第五了"
    },
    {
      "end": 18.06,
      "id": 6,
      "start": 15.33,
      "text": "这个就是变成第五的感觉"
    },
    {
      "end": 23.6,
      "id": 7,
      "start": 18.06,
      "text": "就是大志在天生诸法"
    },
    {
      "end": 27.37,
      "id": 8,
      "start": 23.6,
      "text": "比大志在天等义必是这样可以吗"
    },
    {
      "end": 28.37,
      "id": 9,
      "start": 27.37,
      "text": "可是分析的话"
    },
    {
      "end": 32.16,
      "id": 10,
      "start": 28.37,
      "text": "讲的时候可能会说大志在天生诸法"
    },
    {
      "end": 34.06,
      "id": 11,
      "start": 32.16,
      "text": "这个好像牵扯不到"
    },
    {
      "end": 36.82,
      "id": 12,
      "start": 34.06,
      "text": "就是说没有办法直接说是自生他生"
    },
    {
      "end": 37.24,
      "id": 13,
      "start": 36.82,
      "text": "对不对"
    },
    {
      "end": 39.37,
      "id": 14,
      "start": 37.24,
      "text": "好像是第五生"
    },
    {
      "end": 43.33,
      "id": 15,
      "start": 39.37,
      "text": "但是问题是说详细分析的话"
    },
    {
      "end": 47.73,
      "id": 16,
      "start": 43.33,
      "text": "可能就是大志在天等义必是若智若他若共"
    },
    {
      "end": 51.0,
      "id": 17,
      "start": 47.73,
      "text": "故及大志在天等为因"
    },
    {
      "end": 53.38,
      "id": 18,
      "start": 51.0,
      "text": "义不能出上面所说的过失"
    },
    {
      "end": 57.79,
      "id": 19,
      "start": 53.38,
      "text": "反正他不会是五因生"
    },
    {
      "end": 60.48,
      "id": 20,
      "start": 57.79,
      "text": "所以在这样"
    },
    {
      "end": 62.36,
      "id": 21,
      "start": 60.48,
      "text": "故第五因能生"
    },
    {
      "end": 63.83,
      "id": 22,
      "start": 62.36,
      "text": "这样可以吗"
    },
    {
      "end": 66.85,
      "id": 23,
      "start": 63.83,
      "text": "这个就是我们破自生他生二生五因生"
    },
    {
      "end": 69.19,
      "id": 24,
      "start": 66.85,
      "text": "之后不需要破到第五种"
    },
    {
      "end": 70.68,
      "id": 25,
      "start": 69.19,
      "text": "反正就是没有"
    },
    {
      "end": 75.91,
      "id": 26,
      "start": 70.68,
      "text": "大概就是这样"
    },
    {
      "end": 83.54,
      "id": 27,
      "start": 75.91,
      "text": "故由破四种分别忘记之生"
    },
    {
      "end": 88.05,
      "id": 28,
      "start": 83.54,
      "text": "这四种生事实上是没有"
    },
    {
      "end": 91.28,
      "id": 29,
      "start": 88.05,
      "text": "四种生都是分别忘记"
    },
    {
      "end": 95.74,
      "id": 30,
      "start": 91.28,
      "text": "故说诸法无自行生"
    },
    {
      "end": 100.56,
      "id": 31,
      "start": 95.74,
      "text": "未嫌此义"
    },
    {
      "end": 106.76,
      "id": 32,
      "start": 100.56,
      "text": "送于有五自他自生他生"
    },
    {
      "end": 108.32,
      "id": 33,
      "start": 106.76,
      "text": "共还有就是无因"
    },
    {
      "end": 110.56,
      "id": 34,
      "start": 108.32,
      "text": "故说诸法你自信"
    },
    {
      "end": 111.46,
      "id": 35,
      "start": 110.56,
      "text": "这样可以吗"
    },
    {
      "end": 115.65,
      "id": 36,
      "start": 112.95,
      "text": "所以就是变成诸法有自信的话"
    },
    {
      "end": 121.23,
      "id": 37,
      "start": 115.65,
      "text": "就必须是这四生当中的其中的之一吧"
    },
    {
      "end": 123.35,
      "id": 38,
      "start": 121.23,
      "text": "类似之一或者之二嘛"
    },
    {
      "end": 123.43,
      "id": 39,
      "start": 123.35,
      "text": "对不对"
    },
    {
      "end": 125.88,
      "id": 40,
      "start": 123.43,
      "text": "换一句话来说"
    },
    {
      "end": 127.46,
      "id": 41,
      "start": 125.88,
      "text": "如果没有这四生的话"
    },
    {
      "end": 130.94,
      "id": 42,
      "start": 127.46,
      "text": "也就相当于没有自信生"
    },
    {
      "end": 133.38,
      "id": 43,
      "start": 130.94,
      "text": "有五自他共"
    },
    {
      "end": 135.38,
      "id": 44,
      "start": 133.38,
      "text": "反正就是无因的这个生"
    },
    {
      "end": 137.99,
      "id": 45,
      "start": 135.38,
      "text": "所以就是诸法就是离自信"
    },
    {
      "end": 139.01,
      "id": 46,
      "start": 137.99,
      "text": "这样可以吗"
    },
    {
      "end": 146.16,
      "id": 47,
      "start": 139.01,
      "text": "有五自生他生共生"
    },
    {
      "end": 147.94,
      "id": 48,
      "start": 146.16,
      "text": "无因生故故说诸法"
    },
    {
      "end": 149.52,
      "id": 49,
      "start": 147.94,
      "text": "用你自信"
    },
    {
      "end": 153.43,
      "id": 50,
      "start": 149.52,
      "text": "此名破四边生后"
    },
    {
      "end": 155.12,
      "id": 51,
      "start": 153.43,
      "text": "一子正因"
    },
