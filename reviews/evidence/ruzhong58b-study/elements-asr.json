  "segments": [
    {
      "end": 3.79,
      "id": 0,
      "start": 1.27,
      "text": "那四大种讲的应该就是地水火风"
    },
    {
      "end": 4.51,
      "id": 1,
      "start": 3.79,
      "text": "这样可以吗"
    },
    {
      "end": 6.33,
      "id": 2,
      "start": 4.51,
      "text": "所以这个非常的符合我们的科学"
    },
    {
      "end": 10.7,
      "id": 3,
      "start": 6.33,
      "text": "由彼等"
    },
    {
      "end": 14.93,
      "id": 4,
      "start": 10.7,
      "text": "由那个四大的那个变异差别"
    },
    {
      "end": 19.49,
      "id": 5,
      "start": 14.93,
      "text": "非但现见的那个年华石榴啊空虚啊"
    },
    {
      "end": 23.59,
      "id": 6,
      "start": 19.49,
      "text": "水物等各种差别"
    },
    {
      "end": 25.73,
      "id": 7,
      "start": 23.59,
      "text": "因何道理"
    },
    {
      "end": 29.45,
      "id": 8,
      "start": 25.73,
      "text": "既能了别各种物体之内心"
    },
    {
      "end": 32.68,
      "id": 9,
      "start": 29.45,
      "text": "亦为虫彼身也"
    },
    {
      "end": 34.46,
      "id": 10,
      "start": 32.68,
      "text": "对啊"
    },
    {
      "end": 36.2,
      "id": 11,
      "start": 34.46,
      "text": "所以都是从四大室内的"
    },
    {
      "end": 41.46,
      "id": 12,
      "start": 36.2,
      "text": "如酒中有四大室和何变异差别"
    },
    {
      "end": 43.08,
      "id": 13,
      "start": 41.46,
      "text": "对啊"
    },
    {
      "end": 43.8,
      "id": 14,
      "start": 43.08,
      "text": "就是这个"
    },
    {
      "end": 45.1,
      "id": 15,
      "start": 43.8,
      "text": "在这简简简的时候"
    },
    {
      "end": 47.96,
      "id": 16,
      "start": 45.1,
      "text": "就有那个狂罪的那个功能"
    },
    {
      "end": 51.81,
      "id": 17,
      "start": 47.96,
      "text": "为主众生狂罪闷觉之因"
    },
    {
      "end": 56.96,
      "id": 18,
      "start": 51.81,
      "text": "如是有杰罗兰等大室之差别变异"
    },
    {
      "end": 58.34,
      "id": 19,
      "start": 56.96,
      "text": "生出心事"
    },
    {
      "end": 63.38,
      "id": 20,
      "start": 58.34,
      "text": "乃自能广了别一切众物"
    },
    {
      "end": 64.5,
      "id": 21,
      "start": 63.38,
      "text": "故一切法"
    },
    {
      "end": 68.7,
      "id": 22,
      "start": 64.5,
      "text": "为从现世因生"
    },
    {
      "end": 69.84,
      "id": 23,
      "start": 68.7,
      "text": "现世的因生"
    },
    {
      "end": 73.39,
      "id": 24,
      "start": 69.84,
      "text": "非是前世造业"
    },
    {
      "end": 75.14,
      "id": 25,
      "start": 73.39,
      "text": "今生才成熟"
    },
    {
      "end": 77.41,
      "id": 26,
      "start": 75.14,
      "text": "此是造业"
    },
    {
      "end": 79.25,
      "id": 27,
      "start": 77.41,
      "text": "踏实成熟"
    },
    {
      "end": 80.63,
      "id": 28,
      "start": 79.25,
      "text": "前后踏实"
    },
    {
      "end": 82.31,
      "id": 29,
      "start": 80.63,
      "text": "皆非是有"
    },
    {
      "end": 85.05,
      "id": 30,
      "start": 82.31,
      "text": "比喻受用美女"
    },
    {
      "end": 87.31,
      "id": 31,
      "start": 85.05,
      "text": "为命美女子"
    },
    {
      "end": 89.15,
      "id": 32,
      "start": 87.31,
      "text": "知"
    },
    {
      "end": 91.82,
      "id": 33,
      "start": 89.15,
      "text": "知道没有那个前后事"
    },
    {
      "end": 93.39,
      "id": 34,
      "start": 91.82,
      "text": "曾曰"
    },
    {
      "end": 95.21,
      "id": 35,
      "start": 93.39,
      "text": "美女善行"
    },
    {
      "end": 99.16,
      "id": 36,
      "start": 95.21,
      "text": "善行善引淡"
    },
    {
      "end": 101.62,
      "id": 37,
      "start": 99.16,
      "text": "妙生以去非如有"
    },
    {
      "end": 104.35,
      "id": 38,
      "start": 101.62,
      "text": "此生为是假和成"
    },
    {
      "end": 106.83,
      "id": 39,
      "start": 104.35,
      "text": "去以不凡"
    },
    {
      "end": 109.42,
      "id": 40,
      "start": 106.83,
      "text": "不虚为"
    },
    {
      "end": 111.49,
      "id": 41,
      "start": 109.42,
      "text": "莫具"
    },
    {
      "end": 114.25,
      "id": 42,
      "start": 111.49,
      "text": "拿出一丝亦为"
    },
    {
      "end": 115.17,
      "id": 43,
      "start": 114.25,
      "text": "过去"
    },
    {
      "end": 119.57,
      "id": 44,
      "start": 115.17,
      "text": "不为不复生"
    },
    {
      "end": 119.91,
      "id": 45,
      "start": 119.57,
      "text": "这样"
    },
    {
      "end": 122.8,
      "id": 46,
      "start": 119.91,
      "text": "问如为"
    },
    {
      "end": 124.2,
      "id": 47,
      "start": 122.8,
      "text": "我有"
    },
    {
      "end": 127.9,
      "id": 48,
      "start": 124.2,
      "text": "他事"
    },
    {
      "end": 131.31,
      "id": 49,
      "start": 127.9,
      "text": "为何你决定"
    },
    {
      "end": 131.77,
      "id": 50,
      "start": 131.31,
      "text": "曰"
    },
    {
      "end": 134.3,
      "id": 51,
      "start": 131.77,
      "text": "他是非现见故"
    },
    {
      "end": 134.8,
      "id": 52,
      "start": 134.3,
      "text": "对"
    },
    {
      "end": 135.44,
      "id": 53,
      "start": 134.8,
      "text": "就是变成"
    },
    {
      "end": 137.43,
      "id": 54,
      "start": 135.44,
      "text": "他说没有那个他是"
    },
    {
      "end": 137.87,
      "id": 55,
      "start": 137.43,
      "text": "对不对"
    },
    {
      "end": 138.69,
      "id": 56,
      "start": 137.87,
      "text": "没有前生来世"
    },
    {
      "end": 139.61,
      "id": 57,
      "start": 138.69,
      "text": "反正他的主张"
    },
    {
      "end": 140.69,
      "id": 58,
      "start": 139.61,
      "text": "就是没有前生来世"
    },
    {
      "end": 142.65,
      "id": 59,
      "start": 140.69,
      "text": "问他为什么"
    },
    {
      "end": 143.81,
      "id": 60,
      "start": 142.65,
      "text": "没有前生来世的时候"
    },
    {
      "end": 145.39,
      "id": 61,
      "start": 143.81,
      "text": "他就谈到的说"
    },
    {
      "end": 145.89,
      "id": 62,
      "start": 145.39,
      "text": "那个了"
    },
    {
      "end": 147.42,
      "id": 63,
      "start": 145.89,
      "text": "非"
    },
    {
      "end": 148.48,
      "id": 64,
      "start": 147.42,
      "text": "非现见故"
    },
    {
      "end": 150.19,
      "id": 65,
      "start": 148.48,
      "text": "看不到啊"
    },
    {
      "end": 150.93,
      "id": 66,
      "start": 150.19,
      "text": "就是这个意思嘛"
    },
    {
      "end": 152.39,
      "id": 67,
      "start": 150.93,
      "text": "对不对"
    },
    {
      "end": 152.89,
      "id": 68,
      "start": 152.39,
      "text": "对所以"
    },
    {
      "end": 155.12,
      "id": 69,
      "start": 152.89,
      "text": "他是非现见"
    },
    {
      "end": 156.78,
      "id": 70,
      "start": 155.12,
      "text": "此未现世"
    },
    {
      "end": 160.51,
      "id": 71,
      "start": 156.78,
      "text": "亦非现世"
    },
    {
      "end": 166.2,
      "id": 72,
      "start": 160.51,
      "text": "OK嘛"
    },
    {
      "end": 166.48,
      "id": 73,
      "start": 166.2,
      "text": "对不对"
    },
    {
      "end": 167.12,
      "id": 74,
      "start": 166.48,
      "text": "总之我们"
    },
    {
      "end": 168.44,
      "id": 75,
      "start": 167.12,
      "text": "我们现在也是一样"
    },
    {
      "end": 169.48,
      "id": 76,
      "start": 168.44,
      "text": "就是看不到啊"
    },
    {
      "end": 170.12,
      "id": 77,
      "start": 169.48,
      "text": "之类的"
    },
    {
      "end": 172.52,
      "id": 78,
      "start": 170.12,
      "text": "很多时候会用这个理由"
    },
    {
      "end": 172.78,
      "id": 79,
      "start": 172.52,
      "text": "第一"
    },
    {
      "end": 174.32,
      "id": 80,
      "start": 172.78,
      "text": "第二的话就是变成"
    },
    {
      "end": 175.06,
      "id": 81,
      "start": 174.32,
      "text": "什么"
    },
    {
      "end": 176.51,
      "id": 82,
      "start": 175.06,
      "text": "亲眼所见啊"
    },
    {
      "end": 177.03,
      "id": 83,
      "start": 176.51,
      "text": "什么之类的"
    },
    {
      "end": 178.01,
      "id": 84,
      "start": 177.03,
      "text": "也会用这个理由"
    },
    {
      "end": 179.86,
      "id": 85,
      "start": 178.01,
      "text": "总之"
    },
    {
      "end": 181.24,
      "id": 86,
      "start": 179.86,
      "text": "他的话是说"
    },
    {
      "end": 182.18,
      "id": 87,
      "start": 181.24,
      "text": "非现见故"
    },
    {
      "end": 183.48,
      "id": 88,
      "start": 182.18,
      "text": "那"
    },
    {
      "end": 187.22,
      "id": 89,
      "start": 183.48,
      "text": "问他是非现见"
    },
    {
      "end": 188.16,
      "id": 90,
      "start": 187.22,
      "text": "此未现见"
    },
    {
      "end": 188.98,
      "id": 91,
      "start": 188.16,
      "text": "他是非现见"
    },
    {
      "end": 189.82,
      "id": 92,
      "start": 188.98,
      "text": "这个是现见"
    },
    {
      "end": 191.2,
      "id": 93,
      "start": 189.82,
      "text": "还是不是现见"
    },
    {
      "end": 193.13,
      "id": 94,
      "start": 191.2,
      "text": "若言现见的话"
    },
    {
      "end": 195.26,
      "id": 95,
      "start": 193.13,
      "text": "既取非现见"
    },
    {
      "end": 196.1,
      "id": 96,
      "start": 195.26,
      "text": "则为现见"
    },
    {
      "end": 197.06,
      "id": 97,
      "start": 196.1,
      "text": "对不对"
    },
    {
      "end": 199.18,
      "id": 98,
      "start": 197.06,
      "text": "亦无事"
    },
    {
      "end": 201.0,
      "id": 99,
      "start": 199.18,
      "text": "以现世"
    },
    {
      "end": 201.6,
      "id": 100,
      "start": 201.0,
      "text": "不相伪"
    },
    {
      "end": 226.13,
      "id": 101,
      "start": 201.6,
      "text": "事以现世"
    },
    {
      "end": 226.71,
      "id": 102,
      "start": 226.13,
      "text": "不相伪"
    },
    {
      "end": 227.67,
      "id": 103,
      "start": 226.71,
      "text": "反正就是说"
    },
    {
      "end": 229.07,
      "id": 104,
      "start": 227.67,
      "text": "会有这个问题"
    },
    {
      "end": 231.9,
      "id": 105,
      "start": 229.07,
      "text": "事则如中"
    },
    {
      "end": 233.14,
      "id": 106,
      "start": 231.9,
      "text": "无事"
    },
    {
      "end": 234.22,
      "id": 107,
      "start": 233.14,
      "text": "亦成有事"
    },
    {
      "end": 237.44,
      "id": 108,
      "start": 234.22,
      "text": "也许他是非现见"
    },
    {
      "end": 238.84,
      "id": 109,
      "start": 237.44,
      "text": "为现见所"
    },
    {
      "end": 240.8,
      "id": 110,
      "start": 238.84,
      "text": "亲"
    },
    {
      "end": 242.38,
      "id": 111,
      "start": 240.8,
      "text": "什么"
    },
    {
      "end": 243.62,
      "id": 112,
      "start": 242.38,
      "text": "为现见所"
    },
    {
      "end": 244.66,
      "id": 113,
      "start": 243.62,
      "text": "亲"
    },
    {
      "end": 245.99,
      "id": 114,
      "start": 244.66,
      "text": "量之"
    },
    {
      "end": 246.91,
      "id": 115,
      "start": 245.99,
      "text": "现世故"
    },
    {
      "end": 248.54,
      "id": 116,
      "start": 246.91,
      "text": "犹如有事"
    },
    {
      "end": 252.09,
      "id": 117,
      "start": 248.54,
      "text": "既全无事"
    },
    {
      "end": 256.0,
      "id": 118,
      "start": 252.09,
      "text": "亦应无有事"
    },
    {
      "end": 257.88,
      "id": 119,
      "start": 256.0,
      "text": "无所待故"
    },
    {
      "end": 264.24,
      "id": 120,
      "start": 257.88,
      "text": "若比而非有的话"
    },
    {
      "end": 265.38,
      "id": 121,
      "start": 264.24,
      "text": "则如有事"
    },
    {
      "end": 265.84,
      "id": 122,
      "start": 265.38,
      "text": "大种"
    },
    {
      "end": 266.34,
      "id": 123,
      "start": 265.84,
      "text": "即"
    },
    {
      "end": 268.24,
      "id": 124,
      "start": 266.34,
      "text": "无他事之中"
    },
    {
      "end": 271.65,
      "id": 125,
      "start": 268.24,
      "text": "皆当失坏"
    },
    {
      "end": 275.22,
      "id": 126,
      "start": 271.65,
      "text": "若为非现世"
    },
    {
      "end": 275.54,
      "id": 127,
      "start": 275.22,
      "text": "者"
    },
    {
      "end": 277.7,
      "id": 128,
      "start": 275.54,
      "text": "既非现世"
    },
    {
      "end": 278.64,
      "id": 129,
      "start": 277.7,
      "text": "亦以现量"
    },
    {
      "end": 279.46,
      "id": 130,
      "start": 278.64,
      "text": "亦不可见"
    },
    {
      "end": 281.42,
      "id": 131,
      "start": 279.46,
      "text": "云和又不可见"
    },
    {
      "end": 282.1,
      "id": 132,
      "start": 281.42,
      "text": "门而"
    },
    {
      "end": 283.42,
      "id": 133,
      "start": 282.1,
      "text": "彼之"
    },
    {
      "end": 284.78,
      "id": 134,
      "start": 283.42,
      "text": "他是非有也"
    },
    {
      "end": 285.96,
      "id": 135,
      "start": 284.78,
      "text": "嗯"
    }
  ],
