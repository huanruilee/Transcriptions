  "segments": [
    {
      "end": 3.55,
      "id": 0,
      "start": 0.89,
      "text": "如顺势派外道"
    },
    {
      "end": 7.75,
      "id": 1,
      "start": 3.55,
      "text": "自体与所知自信成颠倒见"
    },
    {
      "end": 13.67,
      "id": 2,
      "start": 7.75,
      "text": "以具足毁谤他事的那个见解"
    },
    {
      "end": 17.11,
      "id": 3,
      "start": 13.67,
      "text": "你们具备了那个毁谤他事的见解"
    },
    {
      "end": 20.59,
      "id": 4,
      "start": 17.11,
      "text": "等同所依自身故"
    },
    {
      "end": 23.11,
      "id": 5,
      "start": 20.59,
      "text": "对具音反正就是有这样的身体"
    },
    {
      "end": 28.56,
      "id": 6,
      "start": 23.35,
      "text": "如既大众自信实有知识"
    },
    {
      "end": 30.76,
      "id": 7,
      "start": 28.56,
      "text": "下面就谈到所依"
    },
    {
      "end": 32.64,
      "id": 8,
      "start": 30.76,
      "text": "讲的是比见安住的因"
    },
    {
      "end": 36.66,
      "id": 9,
      "start": 32.64,
      "text": "反正我们可能会说"
    },
    {
      "end": 37.88,
      "id": 10,
      "start": 36.66,
      "text": "你有邪见嘛"
    },
    {
      "end": 38.22,
      "id": 11,
      "start": 37.88,
      "text": "对不对"
    },
    {
      "end": 40.52,
      "id": 12,
      "start": 38.22,
      "text": "可是这边的话讲二方是"
    },
    {
      "end": 45.26,
      "id": 13,
      "start": 40.52,
      "text": "有那个邪见所依之身"
    },
    {
      "end": 45.92,
      "id": 14,
      "start": 45.26,
      "text": "那是这样"
    },
    {
      "end": 48.53,
      "id": 15,
      "start": 45.92,
      "text": "安住之音"
    },
    {
      "end": 52.35,
      "id": 16,
      "start": 48.53,
      "text": "若为我既大众使有的时候"
    },
    {
      "end": 56.14,
      "id": 17,
      "start": 52.35,
      "text": "非颠倒见"
    },
    {
      "end": 57.67,
      "id": 18,
      "start": 56.14,
      "text": "如之同欲"
    },
    {
      "end": 60.53,
      "id": 19,
      "start": 57.67,
      "text": "缺所立法则"
    },
    {
      "end": 61.87,
      "id": 20,
      "start": 60.53,
      "text": "这个不是颠倒见"
    },
    {
      "end": 63.47,
      "id": 21,
      "start": 61.87,
      "text": "你那个屁语不对这样"
    },
    {
      "end": 65.03,
      "id": 22,
      "start": 63.47,
      "text": "约持过非有"
    },
    {
      "end": 68.43,
      "id": 23,
      "start": 65.03,
      "text": "如既自信不生"
    },
    {
      "end": 69.83,
      "id": 24,
      "start": 68.43,
      "text": "自信非有之"
    },
    {
      "end": 71.14,
      "id": 25,
      "start": 69.83,
      "text": "自信不生"
    },
    {
      "end": 72.6,
      "id": 26,
      "start": 71.14,
      "text": "自信非有之大众"
    },
    {
      "end": 75.7,
      "id": 27,
      "start": 72.6,
      "text": "为自信有及自信生"
    },
    {
      "end": 79.07,
      "id": 28,
      "start": 75.7,
      "text": "但是总之就是把那个"
    },
    {
      "end": 83.82,
      "id": 29,
      "start": 79.07,
      "text": "事实上没有怎么讲"
    },
    {
      "end": 84.82,
      "id": 30,
      "start": 83.82,
      "text": "没有自信"
    },
    {
      "end": 86.22,
      "id": 31,
      "start": 84.82,
      "text": "无自信的大众"
    },
    {
      "end": 86.62,
      "id": 32,
      "start": 86.22,
      "text": "这样跟他"
    },
    {
      "end": 88.97,
      "id": 33,
      "start": 86.62,
      "text": "事实上自信不生"
    },
    {
      "end": 90.29,
      "id": 34,
      "start": 88.97,
      "text": "自信非有的大众"
    },
    {
      "end": 94.5,
      "id": 35,
      "start": 90.29,
      "text": "你把它当作是自信有自信生"
    },
    {
      "end": 95.14,
      "id": 36,
      "start": 94.5,
      "text": "这样跟他"
    },
    {
      "end": 96.82,
      "id": 37,
      "start": 95.14,
      "text": "这个就是颠倒"
    },
    {
      "end": 100.78,
      "id": 38,
      "start": 96.82,
      "text": "是明至终"
    },
    {
      "end": 101.84,
      "id": 39,
      "start": 100.78,
      "text": "正因之量"
    },
    {
      "end": 105.32,
      "id": 40,
      "start": 101.84,
      "text": "是终所所举同欲"
    },
    {
      "end": 107.17,
      "id": 41,
      "start": 105.32,
      "text": "而不缺所立法"
    },
    {
      "end": 109.57,
      "id": 42,
      "start": 107.17,
      "text": "则所建立之正因"
    },
    {
      "end": 110.79,
      "id": 43,
      "start": 109.57,
      "text": "亦必应而"
    },
    {
      "end": 114.58,
      "id": 44,
      "start": 110.79,
      "text": "反正我们的这个中英语是OK的"
    },
    {
      "end": 116.54,
      "id": 45,
      "start": 114.58,
      "text": "前说成你生是无常"
    },
    {
      "end": 119.05,
      "id": 46,
      "start": 116.54,
      "text": "以眼见为因"
    },
    {
      "end": 121.84,
      "id": 47,
      "start": 119.05,
      "text": "这样的话会犯不成过"
    },
    {
      "end": 122.36,
      "id": 48,
      "start": 121.84,
      "text": "这样可以吗"
    },
    {
      "end": 125.49,
      "id": 49,
      "start": 122.36,
      "text": "生因为有法是无常"
    },
    {
      "end": 126.31,
      "id": 50,
      "start": 125.49,
      "text": "也是眼见过"
    },
    {
      "end": 126.83,
      "id": 51,
      "start": 126.31,
      "text": "这样可以吗"
    },
    {
      "end": 127.85,
      "id": 52,
      "start": 126.83,
      "text": "这样的话会变成"
    },
    {
      "end": 128.63,
      "id": 53,
      "start": 127.85,
      "text": "这个因是"
    },
    {
      "end": 131.1,
      "id": 54,
      "start": 128.63,
      "text": "这个因是那个"
    },
    {
      "end": 132.88,
      "id": 55,
      "start": 131.1,
      "text": "不成过的因"
    },
    {
      "end": 136.5,
      "id": 56,
      "start": 132.88,
      "text": "可是我们用的这个就不是这样"
    },
    {
      "end": 139.19,
      "id": 57,
      "start": 136.5,
      "text": "故意正因成立中"
    },
    {
      "end": 141.44,
      "id": 58,
      "start": 139.19,
      "text": "要聚三项也"
    },
    {
      "end": 144.01,
      "id": 59,
      "start": 141.44,
      "text": "因三项"
    },
    {
      "end": 146.19,
      "id": 60,
      "start": 144.01,
      "text": "正因的话要聚因三项"
    },
    {
      "end": 147.95,
      "id": 61,
      "start": 146.19,
      "text": "若为大众自信不生"
    },
    {
      "end": 150.29,
      "id": 62,
      "start": 147.95,
      "text": "由待成立者"
    },
    {
      "end": 152.54,
      "id": 63,
      "start": 150.29,
      "text": "大众不生"
    },
    {
      "end": 153.56,
      "id": 64,
      "start": 152.54,
      "text": "这个还要成立"
    },
    {
      "end": 155.43,
      "id": 65,
      "start": 153.56,
      "text": "这样的话"
    },
    {
      "end": 156.99,
      "id": 66,
      "start": 155.43,
      "text": "大众非有钱以说"
    },
    {
      "end": 158.86,
