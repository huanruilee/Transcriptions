  "segments": [
    {
      "end": 4.48,
      "id": 0,
      "start": 0.0,
      "text": "种子是或者是他是为了让有情度向这样一个状态"
    },
    {
      "end": 5.04,
      "id": 1,
      "start": 4.48,
      "text": "就是这样"
    },
    {
      "end": 8.93,
      "id": 2,
      "start": 5.04,
      "text": "接下来龙氏辅寺的吉论"
    },
    {
      "end": 10.49,
      "id": 3,
      "start": 8.93,
      "text": "这个的话"
    },
    {
      "end": 11.39,
      "id": 4,
      "start": 10.49,
      "text": "正小圣人"
    },
    {
      "end": 15.69,
      "id": 5,
      "start": 11.39,
      "text": "正小圣的人后入大圣而成正觉"
    },
    {
      "end": 17.19,
      "id": 6,
