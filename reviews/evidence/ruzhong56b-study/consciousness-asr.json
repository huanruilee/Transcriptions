    {
      "end": 292.3,
      "id": 153,
      "start": 290.3,
      "text": "这个里头又有两个"
    },
    {
      "end": 293.94,
      "id": 154,
      "start": 292.3,
      "text": "就变成有四亿"
    },
    {
      "end": 299.26,
      "id": 155,
      "start": 293.94,
      "text": "过于此等意"
    },
    {
      "end": 302.01,
      "id": 156,
      "start": 299.26,
      "text": "不得透彻了解"
    },
    {
      "end": 304.47,
      "id": 157,
      "start": 302.01,
      "text": "对"
    },
    {
      "end": 306.85,
      "id": 158,
      "start": 304.47,
      "text": "则不能知耳中的差别"
    },
    {
      "end": 311.0,
      "id": 159,
      "start": 306.85,
      "text": "我也是跟总观的差别"
    },
    {
      "end": 311.92,
      "id": 160,
      "start": 311.0,
      "text": "就不能知"
    },
    {
      "end": 313.51,
      "id": 161,
      "start": 311.92,
      "text": "更不能知"
    },
    {
      "end": 314.83,
      "id": 162,
      "start": 313.51,
      "text": "此中之不共要义"
    },
    {
      "end": 317.14,
      "id": 163,
      "start": 314.83,
      "text": "耳中的差别也不知道"
    },
    {
      "end": 320.21,
      "id": 164,
      "start": 317.14,
      "text": "那此中的不共要义"
    },
    {
      "end": 322.58,
      "id": 165,
      "start": 320.21,
      "text": "也不知道"
    },
    {
      "end": 324.8,
      "id": 166,
      "start": 322.58,
      "text": "那为了了解这些吧"
    },
    {
      "end": 326.46,
      "id": 167,
      "start": 324.8,
      "text": "与变了不了义中"
    },
    {
      "end": 327.82,
      "id": 168,
      "start": 326.46,
      "text": "已经相似"
    },
    {
      "end": 331.33,
      "id": 169,
      "start": 327.82,
      "text": "大概这样"
    },
    {
      "end": 332.11,
      "id": 170,
