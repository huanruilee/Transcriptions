      "text": "非常的容易了解"
    },
    {
      "end": 134.56,
      "id": 69,
      "start": 134.36,
      "text": "对"
    },
    {
      "end": 135.0,
      "id": 70,
      "start": 134.56,
      "text": "所以"
    },
    {
      "end": 135.64,
      "id": 71,
