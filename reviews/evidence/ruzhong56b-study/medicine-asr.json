  "segments": [
    {
      "end": 1.34,
      "id": 0,
      "start": 0.22,
      "text": "大概这样"
    },
    {
      "end": 2.46,
      "id": 1,
      "start": 1.34,
      "text": "《解神秘经》"
    },
    {
      "end": 5.25,
      "id": 2,
      "start": 2.46,
      "text": "何文显示无有外境"
    },
    {
      "end": 9.91,
      "id": 3,
      "start": 5.25,
      "text": "色大神论云"
    },
    {
      "end": 11.19,
      "id": 4,
      "start": 9.91,
      "text": "四尊三母帝"
    },
    {
      "end": 15.14,
      "id": 5,
      "start": 11.19,
      "text": "所以就是变成无外境的吧"
    },
    {
      "end": 20.35,
      "id": 6,
      "start": 15.14,
      "text": "何能显示无有外境吗"
    },
    {
      "end": 21.59,
      "id": 7,
      "start": 20.35,
      "text": "对那显示者就"
    },
    {
      "end": 23.59,
      "id": 8,
      "start": 21.59,
      "text": "色大神论云的是这个"
    },
    {
      "end": 26.25,
      "id": 9,
      "start": 23.59,
      "text": "四尊三母帝所行影像"
    },
    {
      "end": 27.82,
      "id": 10,
      "start": 26.25,
      "text": "这样一个吗"
    },
    {
      "end": 30.92,
      "id": 11,
      "start": 27.82,
      "text": "三母帝跟他所行的影像"
    },
    {
      "end": 31.8,
      "id": 12,
      "start": 30.92,
      "text": "一个是三母帝"
    },
    {
      "end": 33.7,
      "id": 13,
      "start": 31.8,
      "text": "一个是他所行的影像"
    },
    {
      "end": 35.32,
      "id": 14,
      "start": 33.7,
      "text": "彼此心"
    },
    {
      "end": 37.42,
      "id": 15,
      "start": 35.32,
      "text": "就是这个静跟这个心"
    },
    {
      "end": 39.66,
      "id": 16,
      "start": 37.42,
      "text": "当言有义"
    },
    {
      "end": 41.0,
      "id": 17,
      "start": 39.66,
      "text": "当言无义"
    },
    {
      "end": 42.64,
      "id": 18,
      "start": 41.0,
      "text": "是义还是不是义"
    },
    {
      "end": 44.92,
      "id": 19,
      "start": 42.64,
      "text": "佛就告了个辞世"
    },
    {
      "end": 48.57,
      "id": 20,
      "start": 44.92,
      "text": "善男子要说他是无义"
    },
    {
      "end": 51.25,
      "id": 21,
      "start": 48.57,
      "text": "这样对吗"
    },
    {
      "end": 52.13,
      "id": 22,
      "start": 51.25,
      "text": "对所以为事"
    },
    {
      "end": 53.63,
      "id": 23,
      "start": 52.13,
      "text": "为事就是义这个"
    },
    {
      "end": 56.01,
      "id": 24,
      "start": 53.63,
      "text": "就是变成无义嘛"
    },
    {
      "end": 58.73,
      "id": 25,
      "start": 56.01,
      "text": "那无义的话就心啊"
    },
    {
      "end": 60.42,
      "id": 26,
      "start": 58.73,
      "text": "就外境就没有了"
    },
    {
      "end": 61.04,
      "id": 27,
      "start": 60.42,
      "text": "何以故呢"
    },
    {
      "end": 62.6,
      "id": 28,
      "start": 61.04,
      "text": "我说是所缘"
    },
    {
      "end": 63.86,
      "id": 29,
      "start": 62.6,
      "text": "是所现故"
    },
    {
      "end": 66.04,
      "id": 30,
      "start": 63.86,
      "text": "对因为是所缘"
    },
    {
      "end": 67.1,
      "id": 31,
      "start": 66.04,
      "text": "其实是是所现"
    },
    {
      "end": 69.75,
      "id": 32,
      "start": 67.1,
      "text": "这样"
    },
    {
      "end": 72.1,
      "id": 33,
      "start": 69.75,
      "text": "因此经文"
    },
    {
      "end": 75.34,
      "id": 34,
      "start": 72.1,
      "text": "对从此在为事来说"
    },
    {
      "end": 76.72,
      "id": 35,
      "start": 75.34,
      "text": "就是变成无外境的一个"
    },
    {
      "end": 78.6,
      "id": 36,
      "start": 76.72,
      "text": "佛经的该怎么讲"
    },
    {
      "end": 81.97,
      "id": 37,
      "start": 78.6,
      "text": "根据吗还是什么"
    },
    {
      "end": 84.37,
      "id": 38,
      "start": 81.97,
      "text": "这个可以当成一个根据了"
    },
    {
      "end": 88.37,
      "id": 39,
      "start": 84.37,
      "text": "始终与上述四亿"
    },
    {
      "end": 89.25,
      "id": 40,
      "start": 88.37,
      "text": "OK"
    },
    {
      "end": 90.03,
      "id": 41,
      "start": 89.25,
      "text": "四亿知道吗"
    },
    {
      "end": 90.29,
      "id": 42,
      "start": 90.03,
      "text": "对不对"
    },
    {
      "end": 92.35,
      "id": 43,
      "start": 90.29,
      "text": "那四亿"
    },
    {
      "end": 93.95,
      "id": 44,
      "start": 92.35,
      "text": "对反正上述的四亿"
    },
    {
      "end": 95.03,
      "id": 45,
      "start": 93.95,
      "text": "都是不了意"
    },
    {
      "end": 97.24,
      "id": 46,
      "start": 95.03,
      "text": "为事会认为是不了意"
    },
    {
      "end": 98.0,
      "id": 47,
      "start": 97.24,
      "text": "可是始终"
    },
    {
      "end": 100.54,
      "id": 48,
      "start": 98.0,
      "text": "这四亿就是不了意"
    },
    {
      "end": 103.04,
      "id": 49,
      "start": 100.54,
      "text": "不可说为比中"
    },
    {
      "end": 104.22,
      "id": 50,
      "start": 103.04,
      "text": "有者是了意"
    },
    {
      "end": 105.22,
      "id": 51,
      "start": 104.22,
      "text": "有者是不了意"
    },
    {
      "end": 106.23,
      "id": 52,
      "start": 105.22,
      "text": "这样对吗"
    },
    {
      "end": 107.27,
      "id": 53,
      "start": 106.23,
      "text": "通通都是不了意"
    },
    {
      "end": 109.7,
      "id": 54,
      "start": 107.27,
      "text": "OK"
    },
    {
      "end": 110.64,
      "id": 55,
      "start": 109.7,
      "text": "既然是不了意的话"
    },
    {
      "end": 112.5,
      "id": 56,
      "start": 110.64,
      "text": "其中究竟三圣者的话"
    },
    {
      "end": 114.38,
      "id": 57,
      "start": 112.5,
      "text": "究竟三圣这个部分"
    },
    {
      "end": 115.88,
      "id": 58,
      "start": 114.38,
      "text": "为什么就没有谈了"
    },
    {
      "end": 117.76,
      "id": 59,
      "start": 115.88,
      "text": "就是因为龙宿福萨"
    },
    {
      "end": 118.42,
      "id": 60,
      "start": 117.76,
      "text": "在极论"
    },
    {
      "end": 120.12,
      "id": 61,
      "start": 118.42,
      "text": "极经论"
    },
    {
      "end": 121.12,
      "id": 62,
      "start": 120.12,
      "text": "极经论"
    },
    {
      "end": 123.88,
      "id": 63,
      "start": 121.12,
      "text": "成立究竟一圣"
    },
    {
      "end": 125.55,
      "id": 64,
      "start": 123.88,
      "text": "在那个地方"
    },
    {
      "end": 129.34,
      "id": 65,
