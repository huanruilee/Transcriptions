  "segments": [
    {
      "end": 1.98,
      "id": 0,
      "start": 0.0,
      "text": "莫着言说"
    },
    {
      "end": 3.62,
      "id": 1,
      "start": 1.98,
      "text": "对"
    },
    {
      "end": 5.46,
      "id": 2,
      "start": 3.62,
      "text": "要一意"
    },
    {
      "end": 6.62,
      "id": 3,
      "start": 5.46,
      "text": "不能够着言"
    },
    {
      "end": 12.7,
      "id": 4,
      "start": 6.62,
      "text": "又云大会问于佛语经中说如来藏"
    },
    {
      "end": 14.85,
      "id": 5,
      "start": 12.7,
      "text": "对如来藏这样给吗"
    },
    {
      "end": 16.69,
      "id": 6,
      "start": 14.85,
      "text": "如来藏是了意了"
    },
    {
      "end": 18.24,
      "id": 7,
      "start": 16.69,
      "text": "如来藏是了意"
    },
    {
      "end": 19.14,
      "id": 8,
      "start": 18.24,
      "text": "可是就是变成"
    },
    {
      "end": 22.36,
      "id": 9,
      "start": 19.14,
      "text": "有的地方把如来藏说成是自信光明"
    },
    {
      "end": 23.64,
      "id": 10,
      "start": 22.36,
      "text": "本来清净"
    },
    {
      "end": 25.34,
      "id": 11,
      "start": 23.64,
      "text": "句主三十二相"
    },
    {
      "end": 26.93,
      "id": 12,
      "start": 25.34,
      "text": "这样给吗"
    },
    {
      "end": 28.03,
      "id": 13,
      "start": 26.93,
      "text": "八十岁好"
    },
    {
      "end": 30.18,
      "id": 14,
      "start": 28.03,
      "text": "这样的话就会变成不了意"
    },
    {
      "end": 33.13,
      "id": 15,
      "start": 30.18,
      "text": "这样给吗"
    },
    {
      "end": 35.81,
      "id": 16,
      "start": 33.13,
      "text": "因为如来藏就是如来的种子嘛"
    },
    {
      "end": 37.16,
      "id": 17,
      "start": 35.81,
      "text": "如来的"
    },
    {
      "end": 40.73,
      "id": 18,
      "start": 37.16,
      "text": "就是有点像是我们的基因的感觉"
    },
    {
      "end": 45.33,
      "id": 19,
      "start": 40.73,
      "text": "我们是不是生自己的基因啊"
    },
    {
      "end": 47.47,
      "id": 20,
      "start": 45.33,
      "text": "就是我们该怎么讲"
    },
    {
      "end": 48.07,
      "id": 21,
      "start": 47.47,
      "text": "我们的那个"
    },
    {
      "end": 55.94,
      "id": 22,
      "start": 48.07,
      "text": "对反正就是说如来的"
    },
    {
      "end": 58.38,
      "id": 23,
      "start": 55.94,
      "text": "如来的该怎么讲"
    },
    {
      "end": 61.19,
      "id": 24,
      "start": 58.38,
      "text": "如来的种子嘛"
    },
    {
      "end": 62.52,
      "id": 25,
      "start": 61.19,
      "text": "对不对"
    },
    {
      "end": 62.8,
      "id": 26,
      "start": 62.52,
      "text": "对啊"
    },
    {
      "end": 65.37,
      "id": 27,
      "start": 62.8,
      "text": "所以就是变成种子如来藏"
    },
    {
      "end": 68.46,
      "id": 28,
      "start": 65.37,
      "text": "这个不会是不了意"
    },
    {
      "end": 70.91,
      "id": 29,
      "start": 68.46,
      "text": "但是把如来藏说成是"
    },
    {
      "end": 71.31,
      "id": 30,
      "start": 70.91,
      "text": "对啊"
    },
    {
      "end": 72.25,
      "id": 31,
      "start": 71.31,
      "text": "可是就是每一中"
    },
    {
      "end": 75.07,
      "id": 32,
      "start": 72.25,
      "text": "每一派都会解释什么叫做如来藏"
    },
    {
      "end": 78.1,
      "id": 33,
      "start": 75.07,
      "text": "那有些中派"
    },
    {
      "end": 79.88,
      "id": 34,
      "start": 78.1,
      "text": "或者是说有些佛典当中的话"
    },
    {
      "end": 81.28,
      "id": 35,
      "start": 79.88,
      "text": "就把如来藏解释成"
    },
    {
      "end": 82.78,
      "id": 36,
      "start": 81.28,
      "text": "具备三十二相"
    },
    {
      "end": 84.78,
      "id": 37,
      "start": 82.78,
      "text": "而且是众生心中"
    },
    {
      "end": 88.21,
      "id": 38,
      "start": 84.78,
      "text": "就是有一尊佛像"
    },
    {
      "end": 90.95,
      "id": 39,
      "start": 88.21,
      "text": "那这种做法就变成不了意"
    },
    {
      "end": 91.45,
      "id": 40,
      "start": 90.95,
      "text": "这样的吗"
    },
    {
      "end": 91.99,
      "id": 41,
      "start": 91.45,
      "text": "对"
    },
    {
      "end": 92.69,
      "id": 42,
      "start": 91.99,
      "text": "所以一切"
    },
    {
      "end": 94.59,
      "id": 43,
      "start": 92.69,
      "text": "有情神中皆有"
    },
    {
      "end": 98.51,
      "id": 44,
      "start": 94.59,
      "text": "那什么样的方式有呢"
    },
    {
      "end": 105.64,
      "id": 45,
      "start": 98.51,
      "text": "就是说谈到如魔尼宝被构一禅过"
    },
    {
      "end": 108.21,
      "id": 46,
      "start": 105.64,
      "text": "对反正就是类似这样"
    },
    {
      "end": 113.51,
      "id": 47,
      "start": 108.21,
      "text": "如是此意被运出界之一所禅过嘛"
    },
    {
      "end": 115.09,
      "id": 48,
      "start": 113.51,
      "text": "对"
    },
    {
      "end": 116.49,
      "id": 49,
      "start": 115.09,
      "text": "所以而有构然"
    },
    {
      "end": 117.25,
      "id": 50,
      "start": 116.49,
      "text": "然是"
    },
    {
      "end": 118.38,
      "id": 51,
      "start": 117.25,
      "text": "对"
    },
    {
      "end": 121.88,
      "id": 52,
      "start": 118.38,
      "text": "又会说它是长恒兼固"
    },
    {
      "end": 122.78,
      "id": 53,
      "start": 121.88,
      "text": "对"
    },
    {
      "end": 124.36,
      "id": 54,
      "start": 122.78,
      "text": "所以重点就是说如来藏"
    },
    {
      "end": 126.54,
      "id": 55,
      "start": 124.36,
      "text": "具三十二相的如来藏"
    },
    {
      "end": 129.06,
      "id": 56,
      "start": 126.54,
      "text": "长恒兼固的如来藏"
    },
    {
      "end": 129.64,
      "id": 57,
      "start": 129.06,
      "text": "这些了"
    },
    {
      "end": 130.28,
      "id": 58,
      "start": 129.64,
      "text": "这样对吧"
    },
    {
      "end": 133.64,
      "id": 59,
      "start": 130.28,
      "text": "重点这样的时候就变成不了意"
    },
    {
      "end": 136.56,
      "id": 60,
      "start": 133.64,
      "text": "对佛有没有三十二相"
    },
    {
      "end": 136.9,
      "id": 61,
      "start": 136.56,
      "text": "有嘛"
    },
    {
      "end": 137.26,
      "id": 62,
      "start": 136.9,
      "text": "对不对"
    },
    {
      "end": 139.14,
      "id": 63,
      "start": 137.26,
      "text": "可是我们心中的如来藏"
    },
    {
      "end": 140.92,
      "id": 64,
      "start": 139.14,
      "text": "其实不会有三十二相"
    },
    {
      "end": 142.34,
      "id": 65,
      "start": 140.92,
      "text": "这样对吧"
    },
    {
      "end": 143.08,
      "id": 66,
      "start": 142.34,
      "text": "类似这样"
    },
    {
      "end": 143.92,
      "id": 67,
      "start": 143.08,
      "text": "对"
    },
    {
      "end": 144.2,
      "id": 68,
      "start": 143.92,
      "text": "所以"
    },
    {
      "end": 147.52,
      "id": 69,
      "start": 144.2,
      "text": "对这样的描述的时候"
    },
    {
      "end": 148.6,
      "id": 70,
      "start": 147.52,
      "text": "就是变成不了意"
    },
    {
      "end": 152.43,
      "id": 71,
      "start": 148.6,
      "text": "此如来藏以外的"
    },
    {
      "end": 153.77,
      "id": 72,
      "start": 152.43,
      "text": "所说的神我有何差异"
    },
    {
      "end": 155.27,
      "id": 73,
      "start": 153.77,
      "text": "这样对吧"
    },
    {
      "end": 155.43,
      "id": 74,
      "start": 155.27,
      "text": "对"
    },
    {
      "end": 156.09,
      "id": 75,
      "start": 155.43,
      "text": "所以就"
    },
    {
      "end": 159.6,
      "id": 76,
      "start": 156.09,
      "text": "总之"
    },
    {
      "end": 160.76,
      "id": 77,
