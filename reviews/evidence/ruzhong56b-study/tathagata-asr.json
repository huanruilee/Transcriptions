      "text": "所以这个大会蛮厉害的"
    },
    {
      "end": 185.98,
      "id": 93,
      "start": 181.9,
      "text": "大概就这样"
    },
    {
      "end": 187.5,
      "id": 94,
      "start": 185.98,
      "text": "对不对"
    },
    {
      "end": 187.76,
      "id": 95,
      "start": 187.5,
      "text": "对"
    },
    {
      "end": 189.9,
      "id": 96,
      "start": 187.76,
      "text": "对"
    },
    {
      "end": 191.38,
      "id": 97,
