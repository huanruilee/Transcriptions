      "text": "你问他一加一等于多少"
    },
    {
      "end": 218.08,
      "id": 114,
      "start": 217.16,
      "text": "他可能会说五嘛"
    },
    {
      "end": 218.42,
      "id": 115,
      "start": 218.08,
      "text": "对不对"
    },
    {
      "end": 220.45,
      "id": 116,
      "start": 218.42,
      "text": "接下来就是变成问我"
    },
    {
      "end": 221.73,
      "id": 117,
      "start": 220.45,
      "text": "一加一等于多少老师"
    },
    {
      "end": 222.89,
      "id": 118,
      "start": 221.73,
      "text": "一加一等于多少"
    },
    {
      "end": 224.05,
