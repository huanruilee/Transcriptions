      "text": "外道那个真的是如实言"
    },
    {
      "end": 241.62,
      "id": 128,
      "start": 240.68,
      "text": "他以为有神我"
    },
    {
      "end": 243.17,
      "id": 129,
      "start": 241.62,
      "text": "为了兼顾神我"
    },
    {
      "end": 243.65,
      "id": 130,
      "start": 243.17,
      "text": "对不对"
    },
    {
      "end": 245.58,
      "id": 131,
      "start": 243.65,
      "text": "就努力地描述他"
    },
    {
      "end": 246.64,
      "id": 132,
