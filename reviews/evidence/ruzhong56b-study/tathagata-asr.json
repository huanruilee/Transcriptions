      "text": "佛你在佛经中说如来藏"
    },
    {
      "end": 166.34,
      "id": 80,
      "start": 165.17,
      "text": "对不对"
    },
    {
      "end": 167.86,
      "id": 81,
      "start": 166.34,
      "text": "佛陀啊"
    },
    {
      "end": 169.42,
      "id": 82,
