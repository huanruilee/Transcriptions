    },
    {
      "end": 195.2,
      "id": 100,
      "start": 194.52,
      "text": "故于外道"
    },
    {
      "end": 196.18,
      "id": 101,
      "start": 195.2,
      "text": "之神我不同"
    },
    {
      "end": 196.92,
      "id": 102,
      "start": 196.18,
      "text": "你看"
    },
    {
      "end": 199.0,
      "id": 103,
