      "text": "你在佛经中说如来藏"
    },
    {
      "end": 170.28,
      "id": 83,
      "start": 169.42,
      "text": "有这个有那个"
    },
    {
      "end": 170.7,
      "id": 84,
      "start": 170.28,
      "text": "这样"
    },
    {
      "end": 171.8,
      "id": 85,
      "start": 170.7,
      "text": "这样对吧"
    },
    {
      "end": 171.94,
      "id": 86,
