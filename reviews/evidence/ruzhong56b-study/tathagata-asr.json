      "text": "我这个不是如实言"
    },
    {
      "end": 205.46,
      "id": 106,
      "start": 203.07,
      "text": "换一句话来说"
    },
    {
      "end": 207.2,
      "id": 107,
      "start": 205.46,
      "text": "外道讲的是如实言"
    },
    {
      "end": 208.66,
      "id": 108,
      "start": 207.2,
      "text": "所以不同"
    },
    {
      "end": 212.59,
