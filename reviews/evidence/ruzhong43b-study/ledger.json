      "sourceLast": 182,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study43B-p14-s1",
      "start": 1189.69,
      "end": 1229.74,
      "text": "【編者註・底本對讀】依官方影印本134頁補列所議課文；當堂夢喻科判，非逐字聽核的講者引文。「初又分三：戌一、夢喻不能成立識有自性，戌二、夢喻不能成立覺時無外境，戌三、夢喻成立一切法虛妄。今初」【底本對讀結束】夢喻不能成立識有自性，也不能成立覺時無外境；最後成立的是一切法虛妄、實有空。不能成立你想證的，反倒會成立我們說的諸法空，所以三個科判要分開，不把第二覺時無外境混成夢中根本沒有任何境。",
      "sourceSentenceIds": [
        "sent-183",
        "sent-184",
        "sent-185",
        "sent-186",
        "sent-187",
        "sent-188",
        "sent-189",
        "sent-190",
        "sent-191",
        "sent-192"
      ],
      "timingMethod": "source-window",
