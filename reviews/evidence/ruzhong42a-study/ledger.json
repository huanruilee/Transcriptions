        "sent-284"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 273,
      "sourceLast": 284,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p14-s1",
      "start": 1812.77,
      "end": 1908.92,
      "text": "依月稱的路線，人家問的是唯識那種：六識不現前時，另有第八識承載一切。這是佛依密意而說，非了義。所以限定這個問題，答沒有；無上密續同名的內容又是另一回事，不能混進來。宗大師有點像走這個路線。",
      "sourceSentenceIds": [
        "sent-285",
        "sent-286",
        "sent-287",
        "sent-288",
        "sent-289",
        "sent-290",
        "sent-291",
        "sent-292",
        "sent-293",
        "sent-294",
        "sent-295",
        "sent-296",
        "sent-297",
        "sent-298",
        "sent-299",
        "sent-300",
        "sent-301",
        "sent-302",
        "sent-303",
        "sent-304",
        "sent-305"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 285,
      "sourceLast": 305,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p14-s2",
      "start": 1910.17,
      "end": 1983.06,
      "text": "有的地方同名其實指第六意識，不能因此反問，既然也叫阿賴耶，為什麼又說沒有？我問有沒有tea，總不能因中文寫鐵，就拿金屬來答有。名字寫得一樣，所指已變。我們的立場大概是這樣。",
      "sourceSentenceIds": [
        "sent-306",
        "sent-307",
        "sent-308",
        "sent-309",
        "sent-310",
        "sent-311",
        "sent-312",
        "sent-313",
        "sent-314",
        "sent-315",
        "sent-316",
        "sent-317",
        "sent-318"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 306,
      "sourceLast": 318,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p15-s1",
      "start": 1984.36,
      "end": 2112.3,
      "text": "有些大德會說，勝義上統統無，世俗上統統有，引用密續或《法界贊》來說有。這是另一個方向：沒有你們那種，可有我們這種。為什麼中觀師說沒有，典籍卻有這字；別人說名言有，又為了什麼？自己可以考慮。說到薩迦，我又提米彭，接著問他不是薩迦吧？不知道。另一位薩迦大德是誰，我忘了。【編者註】保留人名、宗派的找詞與自限，不擴成全宗共同主張。",
      "sourceSentenceIds": [
        "sent-319",
        "sent-320",
        "sent-321",
        "sent-322",
        "sent-323",
        "sent-324",
        "sent-325",
        "sent-326",
        "sent-327",
        "sent-328",
        "sent-329",
        "sent-330",
        "sent-331",
        "sent-332",
        "sent-333",
        "sent-334",
        "sent-335",
        "sent-336",
        "sent-337",
        "sent-338",
        "sent-339"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 319,
      "sourceLast": 339,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p16-s1",
      "start": 2112.3,
      "end": 2206.8,
      "text": "再像噶舉，我覺得跟漢傳某些說法有點像。明心、見性，可以談心性的世俗面與勝義面，透過這些成佛，也可跟光明心相搭。但漢傳這方面，我接觸非常少，偶爾看到一些片段，沒有好好研究過。",
      "sourceSentenceIds": [
        "sent-340",
        "sent-341",
        "sent-342",
        "sent-343",
        "sent-344",
        "sent-345",
        "sent-346",
        "sent-347",
        "sent-348",
        "sent-349",
        "sent-350",
        "sent-351",
        "sent-352",
        "sent-353"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 340,
      "sourceLast": 353,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p16-s2",
      "start": 2207.77,
      "end": 2339.97,
      "text": "有一種說法談阿賴耶的染污面、清淨面：心本身明了、了別，沾染很多東西而迷惑；認識這一面，好像見本來面目。可是通達自心，不一定已解成通達心的勝義諦。我們說世俗面之外，還要進入空性、修空性，這與只在心的清淨面說成佛不同。你們自己查查，不要把我這裡的比較直接當成已定。",
      "sourceSentenceIds": [
        "sent-354",
        "sent-355",
        "sent-356",
        "sent-357",
        "sent-358",
        "sent-359",
        "sent-360",
        "sent-361",
        "sent-362",
        "sent-363",
        "sent-364",
        "sent-365",
        "sent-366",
        "sent-367",
        "sent-368",
        "sent-369",
        "sent-370",
        "sent-371",
        "sent-372"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 354,
      "sourceLast": 372,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p17-s1",
      "start": 2342.65,
      "end": 2470.28,
      "text": "明心見性有的地方也許解成空性，有的純往心的明了、了別去說；若是後者，我覺得跟噶舉某些說法像。那裡稱阿賴耶的，不是在講第八識。別人答有，宗大師答沒有，要如何選？我又說不知道——不是了，依宗大師的講法，要答沒有。我也不能把薩迦全部拉在一起，只是在說接觸到的那些大德及跟隨者。",
      "sourceSentenceIds": [
        "sent-373",
        "sent-374",
        "sent-375",
        "sent-376",
        "sent-377",
        "sent-378",
        "sent-379",
        "sent-380",
        "sent-381",
        "sent-382",
        "sent-383",
        "sent-384",
        "sent-385",
        "sent-386",
        "sent-387",
        "sent-388",
        "sent-389",
        "sent-390",
        "sent-391",
        "sent-392",
        "sent-393",
        "sent-394",
        "sent-395",
        "sent-396"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 373,
      "sourceLast": 396,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p17-s2",
      "start": 2479.31,
      "end": 2518.99,
      "text": "像到教室外晃很久，想喝tea，問有沒有茶，不能拿拿鐵來說有，乾脆答沒有。內容不同，不能靠同一個音就答有。",
      "sourceSentenceIds": [
        "sent-397",
        "sent-398",
        "sent-399",
        "sent-400",
        "sent-401",
        "sent-402",
        "sent-403"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 397,
      "sourceLast": 403,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p18-s1",
      "start": 2520.6,
      "end": 2590.92,
      "text": "《法界贊》似乎說勝義無、名言可有，密續又有同名內容。若是密續不共的概念，應該不能直接扯到顯教；若與不共概念關係不大，似乎也能沿用。這個說複雜也複雜，但主要像是在問怎麼分類、怎麼說這件事，沒有多嚴重。好了，接著消文。",
      "sourceSentenceIds": [
        "sent-404",
        "sent-405",
        "sent-406",
        "sent-407",
        "sent-408",
        "sent-409",
        "sent-410",
        "sent-411",
        "sent-412",
        "sent-413",
        "sent-414"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 404,
      "sourceLast": 414,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p19-s1",
      "start": 2594.56,
      "end": 2672.71,
      "text": "離意識外的異體，是不同組別的意思。眼識、耳識、第六意識，各可看作一組，心所也有一群；這裡說離六識另有異體阿賴耶。《般若十萬頌》等無量經典說識的數時，只說六識身，未再多說；因此佛經有建立、不建立阿賴耶的兩類。",
      "sourceSentenceIds": [
        "sent-415",
        "sent-416",
        "sent-417",
        "sent-418",
        "sent-419",
        "sent-420",
        "sent-421",
        "sent-422",
        "sent-423",
        "sent-424",
        "sent-425"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 415,
      "sourceLast": 425,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p20-s1",
      "start": 2674.26,
      "end": 2695.94,
      "text": "彌勒菩薩解經意，《辨中邊論》《莊嚴經論》《辨法法性論》這三處，建立阿賴耶識、破外境。這裡先照文字分清，不能只看到阿賴耶這個名字就混成同一套意思。",
      "sourceSentenceIds": [
        "sent-426",
        "sent-427",
        "sent-428",
        "sent-429"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 426,
      "sourceLast": 429,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p20-s2",
      "start": 2700.61,
      "end": 2808.62,
      "text": "《現觀莊嚴論》與《寶性論》，本文說不建立阿賴耶、不破外境。但現觀有唯識、自續、應成等好多大祖師解釋，往不同方向說，所以不好簡單判。它自己沒明講八識，要說它建立或否定，都難說；這裡說不建立，可以先按沒有這樣講去看，還要考慮各家註釋。",
      "sourceSentenceIds": [
        "sent-430",
        "sent-431",
        "sent-432",
        "sent-433",
        "sent-434",
        "sent-435",
        "sent-436",
        "sent-437",
        "sent-438",
        "sent-439",
        "sent-440",
        "sent-441",
        "sent-442",
        "sent-443",
        "sent-444",
        "sent-445",
        "sent-446",
        "sent-447"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 430,
      "sourceLast": 447,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p21-s1",
      "start": 2810.16,
      "end": 2880.54,
      "text": "不講阿賴耶，到底是不拿它來破外境，還是連外境也不破？下面還會出來，先不搶答。佛經有兩類，慈氏這些論看起來也有不同安排；又不能直接說兩種主張，前面三部有說，後面沒講，不建立與沒講先這樣理解。",
      "sourceSentenceIds": [
        "sent-448",
        "sent-449",
        "sent-450",
        "sent-451",
        "sent-452",
        "sent-453",
        "sent-454",
        "sent-455",
        "sent-456",
        "sent-457",
        "sent-458",
        "sent-459"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 448,
      "sourceLast": 459,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p22-s1",
      "start": 2881.57,
      "end": 3010.75,
      "text": "再看無著解《寶性論》，不作唯識宗釋，而作中觀宗釋。在西藏這樣說大概可以；臺灣好像另分如來藏思想、唯識思想、中觀思想，可能不容易接受。在這裡，唯識可把如來藏義歸入唯識，中觀可歸中觀，不一定另立第三類。漢傳這個先不談，這裡重點是本文說無著把《寶性論》解成中觀。【編者註】這是當堂分類比較，不作對所有漢藏學派的已核實總判。",
      "sourceSentenceIds": [
        "sent-460",
        "sent-461",
        "sent-462",
        "sent-463",
        "sent-464",
        "sent-465",
        "sent-466",
        "sent-467",
        "sent-468",
        "sent-469",
        "sent-470",
        "sent-471",
        "sent-472",
        "sent-473",
        "sent-474",
        "sent-475",
        "sent-476",
        "sent-477",
        "sent-478",
        "sent-479",
        "sent-480"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 460,
      "sourceLast": 480,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p23-s1",
      "start": 3012.7,
      "end": 3091.79,
      "text": "相關祖師有得意不得句、得句不得意、兩個都得卻沒得弟子等說法。懂意思但文筆不好、寫錯；或者句子漂亮卻沒懂；無著則是兩個都得，卻弟子都講唯識，而從《寶性論》看自己的意思是中觀。我是在用這個說法講這裡，先抓他以中觀釋《寶性論》這點。【編者註】這是講者引述的傳承譬說，未作獨立歷史核定。",
      "sourceSentenceIds": [
        "sent-481",
        "sent-482",
        "sent-483",
        "sent-484",
        "sent-485",
        "sent-486",
        "sent-487",
        "sent-488",
        "sent-489",
        "sent-490",
        "sent-491"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 481,
      "sourceLast": 491,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p24-s1",
      "start": 3091.79,
      "end": 3271.87,
      "text": "這裡要注意：無著為成立阿賴耶識引《阿毗達摩經》，到了《寶性論釋》，卻用同一經證一切有情都有法性種性。別人問，你那邊不遺餘力成立阿賴耶，這裡怎麼又不那樣解？回答要看引經的意趣，不一定就是在證那個識。【編者註・存疑】原稿反覆作《辨法法性論》並連到無著，底本128頁此句作《攝大乘論》，末尾又有設大乘音；論名與作者接句待聽核，不把混讀作確定書目事實。",
      "sourceSentenceIds": [
        "sent-492",
        "sent-493",
        "sent-494",
        "sent-495",
        "sent-496",
        "sent-497",
        "sent-498",
        "sent-499",
        "sent-500",
        "sent-501",
        "sent-502",
        "sent-503",
        "sent-504",
        "sent-505",
        "sent-506",
        "sent-507",
        "sent-508",
        "sent-509",
        "sent-510",
        "sent-511",
        "sent-512",
        "sent-513",
        "sent-514"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 492,
      "sourceLast": 514,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p24-s2",
      "start": 3273.95,
      "end": 3325.15,
      "text": "這邊其實是證法性、如來藏；法性指空性，種性、如來藏從這個意趣說。就像上次青蛙與鬼故事，我想著青蛙，講出一堆鬼的名字，所依與表面詞可以不同。",
      "sourceSentenceIds": [
        "sent-515",
        "sent-516",
        "sent-517",
        "sent-518",
        "sent-519",
        "sent-520",
        "sent-521",
        "sent-522"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 515,
      "sourceLast": 522,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p25-s1",
      "start": 3336.75,
      "end": 3371.95,
      "text": "這裡界與藏兩個字：一切有情有如來界藏，卻不能自知；又引無始時來界、一切法等依，由此有諸趣及涅槃證得。六道與涅槃都在談這個意趣。【編者註】依128頁核界、藏等字，不補成錄音未清的完整經文段落。",
      "sourceSentenceIds": [
        "sent-523",
        "sent-524",
        "sent-525",
        "sent-526",
        "sent-527"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 523,
      "sourceLast": 527,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p25-s2",
      "start": 3373.73,
      "end": 3462.21,
      "text": "說阿賴耶時，用海與波浪，一切由海來、歸海藏；但這裡不是有個實體倉庫，而是緣起即空、空即緣起，色即是空、空即是色。一切法自性空，輪迴與涅槃都依這個說；兩種講法像的地方在這裡，不是把空性變成製造萬法的實體。",
      "sourceSentenceIds": [
        "sent-528",
        "sent-529",
        "sent-530",
        "sent-531",
        "sent-532",
        "sent-533",
        "sent-534",
        "sent-535",
        "sent-536",
        "sent-537",
        "sent-538",
        "sent-539",
        "sent-540"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 528,
      "sourceLast": 540,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study42A-p26-s1",
      "start": 3464.51,
      "end": 3507.11,
      "text": "月稱說阿賴耶識意趣是依空性而說，這裡就與之極相符合。月稱解釋佛為何說阿賴耶；無著這裡則也面對彌勒的論與自己成立阿賴耶的說法，大概是這個狀態。我們先休息一下。",
      "sourceSentenceIds": [
        "sent-541",
        "sent-542",
        "sent-543",
        "sent-544",
        "sent-545",
        "sent-546",
        "sent-547",
        "sent-548"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 541,
      "sourceLast": 548,
      "editorialRole": "source-bound-study-guide"
    }
  ]
}
