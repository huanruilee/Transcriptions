      "text": "不圆"
    },
    {
      "end": 153.09,
      "id": 42,
      "start": 150.35,
      "text": "因为像讲那个"
    },
    {
      "end": 154.57,
      "id": 43,
      "start": 153.09,
      "text": "自信自向这些的时候"
    },
    {
      "end": 156.62,
      "id": 44,
      "start": 154.57,
      "text": "它的一个特色就是说"
    },
    {
      "end": 157.66,
      "id": 45,
