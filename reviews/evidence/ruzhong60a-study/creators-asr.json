      "text": "能夠給我們"
    },
    {
      "end": 301.0,
      "id": 136,
      "start": 298.8,
      "text": "要說給我們嘛"
    },
    {
      "end": 302.5,
      "id": 137,
      "start": 301.0,
      "text": "或者說要說讓我們"
    },
    {
      "end": 307.96,
      "id": 138,
      "start": 302.5,
      "text": "往列邊去想通我們的這個圓起的想法"
    },
    {
      "end": 312.48,
