  "segments": [
    {
      "end": 2.5,
      "id": 0,
      "start": 0.7,
      "text": "就很麻煩了 就是這樣"
    },
    {
      "end": 5.96,
      "id": 1,
      "start": 2.5,
      "text": "所以近代科學政治就是說"
    },
    {
      "end": 8.66,
      "id": 2,
      "start": 5.96,
      "text": "我們的心其實也是來自於色成"
    },
    {
      "end": 11.75,
      "id": 3,
      "start": 8.66,
      "text": "色法 依於色法"
    },
    {
      "end": 16.62,
      "id": 4,
      "start": 11.75,
      "text": "所以它的最終的東西都是一些色成"
    },
    {
      "end": 19.25,
      "id": 5,
      "start": 16.62,
      "text": "由色成創建了一切一切"
    },
    {
      "end": 25.95,
      "id": 6,
      "start": 19.25,
      "text": "對 就是有幾個東西"
    },
    {
      "end": 29.54,
      "id": 7,
      "start": 25.95,
      "text": "對對對對 相續運原成"
    },
    {
      "end": 31.44,
      "id": 8,
      "start": 29.54,
      "text": "那個在哪裡 任解經 對"
    },
    {
      "end": 36.82,
      "id": 9,
      "start": 31.44,
      "text": "你念一下 你念一下看看就好了"
    },
    {
      "end": 39.94,
      "id": 10,
      "start": 36.82,
      "text": "第一個是什麼"
    },
    {
      "end": 47.69,
      "id": 11,
      "start": 39.94,
      "text": "對 對 對"
    },
    {
      "end": 50.5,
      "id": 12,
      "start": 47.69,
      "text": "我說為是心嘛"
    },
    {
      "end": 52.6,
      "id": 13,
      "start": 50.5,
      "text": "佛教講的是說我說為是心"
    },
    {
      "end": 57.1,
      "id": 14,
      "start": 52.6,
      "text": "先看著 我先看著"
    },
    {
      "end": 59.94,
      "id": 15,
      "start": 57.1,
      "text": "我說為是心的意思就是說"
    },
    {
      "end": 61.74,
      "id": 16,
      "start": 59.94,
      "text": "對我們來說說是心"
    },
    {
      "end": 64.01,
      "id": 17,
      "start": 61.74,
      "text": "或者是說說是業"
    },
    {
      "end": 66.04,
      "id": 18,
      "start": 64.01,
      "text": "反正就是說在據神論裡頭的話"
    },
    {
      "end": 69.74,
      "id": 19,
      "start": 66.04,
      "text": "就是業別 識別由業生"
    },
    {
      "end": 73.32,
      "id": 20,
      "start": 69.74,
      "text": "所以由業生跟由心創造"
    },
    {
      "end": 75.66,
      "id": 21,
      "start": 73.32,
      "text": "其實就還可以的了"
    },
    {
      "end": 77.26,
      "id": 22,
      "start": 75.66,
      "text": "就是同一個方向 對不對"
    },
    {
      "end": 78.77,
      "id": 23,
      "start": 77.26,
      "text": "雖然業跟心不一樣"
    },
    {
      "end": 81.12,
      "id": 24,
      "start": 78.77,
      "text": "但是問題是說就差不多了"
    },
    {
      "end": 83.1,
      "id": 25,
      "start": 81.12,
      "text": "這樣跟著"
    },
    {
      "end": 85.64,
      "id": 26,
      "start": 83.1,
      "text": "所以我們不是大自在天所創造的"
    },
    {
      "end": 87.74,
      "id": 27,
      "start": 85.64,
      "text": "我們不是主張大自在天"
    },
    {
      "end": 90.5,
      "id": 28,
      "start": 87.74,
      "text": "可是我們也可以說是人造所創造的"
    },
    {
      "end": 92.9,
      "id": 29,
      "start": 90.5,
      "text": "這個可以的了"
    },
    {
      "end": 93.6,
      "id": 30,
      "start": 92.9,
      "text": "這樣可以嗎"
    },
    {
      "end": 94.8,
      "id": 31,
      "start": 93.6,
      "text": "人家是上帝創造"
    },
    {
      "end": 98.09,
      "id": 32,
      "start": 94.8,
      "text": "我們是我們自己創造的"
    },
    {
      "end": 98.83,
      "id": 33,
      "start": 98.09,
      "text": "這樣可以嗎"
    },
    {
      "end": 102.4,
      "id": 34,
      "start": 98.83,
      "text": "這個可以講喔"
    },
    {
      "end": 104.2,
      "id": 35,
      "start": 102.4,
      "text": "佛教會不會講一個就是說"
    },
    {
      "end": 105.42,
      "id": 36,
      "start": 104.2,
      "text": "某一個人"
    },
    {
      "end": 106.52,
      "id": 37,
      "start": 105.42,
      "text": "不能說某一個人吧"
    },
    {
      "end": 107.22,
      "id": 38,
      "start": 106.52,
      "text": "就是說"
    },
    {
      "end": 110.66,
      "id": 39,
      "start": 107.22,
      "text": "普得切諾創造世界的這樣一個狀態"
    },
    {
      "end": 111.62,
      "id": 40,
      "start": 110.66,
      "text": "這個是正確的了"
    },
    {
      "end": 112.2,
      "id": 41,
      "start": 111.62,
      "text": "是了"
    },
    {
      "end": 114.49,
      "id": 42,
      "start": 112.89,
      "text": "因為識別由業生嘛對不對"
    },
    {
      "end": 116.16,
      "id": 43,
      "start": 114.49,
      "text": "既然是業生的話"
    },
    {
      "end": 117.56,
      "id": 44,
      "start": 116.16,
      "text": "任解禁也是說有心嘛"
    },
    {
      "end": 118.72,
      "id": 45,
      "start": 117.56,
      "text": "我說是有心"
    },
    {
      "end": 120.5,
      "id": 46,
      "start": 118.72,
      "text": "為是心"
    },
    {
      "end": 121.5,
      "id": 47,
      "start": 120.5,
      "text": "為是心了"
    },
    {
      "end": 124.98,
      "id": 48,
      "start": 121.5,
      "text": "所以就是變成是人創造"
    },
    {
      "end": 126.38,
      "id": 49,
      "start": 124.98,
      "text": "不能說是人吧"
    },
    {
      "end": 128.38,
      "id": 50,
      "start": 126.38,
      "text": "就是說是普得切諾創造的"
    },
    {
      "end": 130.44,
      "id": 51,
      "start": 128.38,
      "text": "這個沒人跟你造麻煩"
    },
    {
      "end": 131.61,
      "id": 52,
      "start": 130.44,
      "text": "這樣可以嗎"
    },
    {
      "end": 132.23,
      "id": 53,
      "start": 131.61,
      "text": "講這句話"
    },
    {
      "end": 133.33,
      "id": 54,
      "start": 132.23,
      "text": "如果有人造麻煩的話"
    },
    {
      "end": 136.51,
      "id": 55,
      "start": 133.33,
      "text": "那就讓他解釋一下"
    },
    {
      "end": 138.21,
      "id": 56,
      "start": 136.51,
      "text": "識別有業生啊對不對"
    },
    {
      "end": 139.55,
      "id": 57,
      "start": 138.21,
      "text": "我說為是心啊"
    },
    {
      "end": 141.61,
      "id": 58,
      "start": 139.55,
      "text": "這一類的到底在說什麼"
    },
    {
      "end": 143.25,
      "id": 59,
      "start": 141.61,
      "text": "就是這麼一個狀態嘛"
    },
    {
      "end": 144.41,
      "id": 60,
      "start": 143.25,
      "text": "在佛教來說"
    },
    {
      "end": 146.12,
      "id": 61,
      "start": 144.41,
      "text": "造物主吧"
    },
    {
      "end": 148.25,
      "id": 62,
      "start": 146.12,
      "text": "造物是誰造的"
    },
    {
      "end": 149.94,
      "id": 63,
      "start": 148.25,
      "text": "其實就是有心"
    },
    {
      "end": 151.24,
      "id": 64,
      "start": 149.94,
      "text": "有業"
    },
    {
      "end": 152.24,
      "id": 65,
      "start": 151.24,
      "text": "有不得切諾"
    },
    {
      "end": 153.08,
      "id": 66,
      "start": 152.24,
      "text": "可以的了"
    },
    {
      "end": 154.02,
      "id": 67,
      "start": 153.08,
      "text": "這個沒什麼不可以"
    },
    {
      "end": 154.62,
      "id": 68,
      "start": 154.02,
      "text": "這樣可以嗎"
    },
    {
      "end": 157.2,
      "id": 69,
      "start": 154.62,
      "text": "大概這樣"
    },
    {
      "end": 159.1,
      "id": 70,
      "start": 157.2,
      "text": "所以合不合理"
    },
    {
      "end": 159.7,
      "id": 71,
      "start": 159.1,
      "text": "大概這樣"
    },
    {
      "end": 162.1,
      "id": 72,
      "start": 159.7,
      "text": "那其中就是我們科學的講法"
    },
    {
      "end": 164.18,
      "id": 73,
      "start": 162.1,
      "text": "當年是誰講的誰知道"
    },
    {
      "end": 166.06,
      "id": 74,
      "start": 164.18,
      "text": "現在科學家是講由那個"
    },
    {
      "end": 167.65,
      "id": 75,
      "start": 166.06,
      "text": "那邊是微塵嘛"
    },
    {
      "end": 171.89,
      "id": 76,
      "start": 167.65,
      "text": "塵的塵"
    },
    {
      "end": 174.9,
      "id": 77,
      "start": 171.89,
      "text": "這個其實就是我們現代科技的講法"
    },
    {
      "end": 176.84,
      "id": 78,
      "start": 174.9,
      "text": "這樣可以嗎"
    },
    {
      "end": 178.18,
      "id": 79,
      "start": 176.84,
      "text": "由塵怎麼建造"
    },
    {
      "end": 178.88,
      "id": 80,
      "start": 178.18,
      "text": "當年的講法"
    },
    {
      "end": 180.38,
      "id": 81,
      "start": 178.88,
      "text": "可能用當年的講法"
    },
    {
      "end": 182.4,
      "id": 82,
      "start": 180.38,
      "text": "跟現代科學完全就不一樣"
    },
    {
      "end": 183.2,
      "id": 83,
      "start": 182.4,
      "text": "但不管怎麼樣"
    },
    {
      "end": 186.4,
      "id": 84,
      "start": 183.2,
      "text": "這兩者都在說有微塵膀炸"
    },
    {
      "end": 187.3,
      "id": 85,
      "start": 186.4,
      "text": "還有什麼"
    },
    {
      "end": 190.55,
      "id": 86,
      "start": 187.3,
      "text": "相需"
    },
    {
      "end": 195.11,
      "id": 87,
      "start": 190.55,
      "text": "圓"
    },
    {
      "end": 200.91,
      "id": 88,
      "start": 195.11,
      "text": "所以總之就變成"
    },
    {
      "end": 206.24,
      "id": 89,
      "start": 200.91,
      "text": "要講的是什麼呢"
    },
    {
      "end": 207.34,
      "id": 90,
      "start": 206.24,
      "text": "就是說"
    },
    {
      "end": 208.67,
      "id": 91,
      "start": 207.34,
      "text": "有圓吧"
    },
    {
      "end": 209.8,
      "id": 92,
      "start": 208.67,
      "text": "圓起"
    },
    {
      "end": 212.99,
      "id": 93,
      "start": 209.8,
      "text": "圓的時候圓而生"
    },
    {
      "end": 217.05,
      "id": 94,
      "start": 212.99,
      "text": "那這些如果走向一個不圓而生"
    },
    {
      "end": 220.32,
      "id": 95,
      "start": 217.05,
      "text": "其實這個為什麼會最終會變成一個要破的"
    },
    {
      "end": 221.62,
      "id": 96,
      "start": 220.32,
      "text": "要破的地方"
    },
    {
      "end": 223.77,
      "id": 97,
      "start": 221.62,
      "text": "就是他們講的是一個不圓嘛"
    },
    {
      "end": 225.45,
      "id": 98,
      "start": 223.77,
      "text": "對不對"
    },
    {
      "end": 225.95,
      "id": 99,
      "start": 225.45,
      "text": "這樣對不對"
    },
    {
      "end": 226.95,
      "id": 100,
      "start": 225.95,
      "text": "總之我覺得就是說"
    },
    {
      "end": 228.25,
      "id": 101,
      "start": 226.95,
      "text": "我在講三個東西"
    },
    {
      "end": 228.93,
      "id": 102,
      "start": 228.25,
      "text": "第一"
    },
    {
      "end": 229.83,
      "id": 103,
      "start": 228.93,
      "text": "圓起圓起的時候"
    },
    {
      "end": 232.21,
      "id": 104,
      "start": 229.83,
      "text": "其實會牽涉到英國圓起嘛"
    },
    {
      "end": 233.41,
      "id": 105,
