      "start": 290.92,
      "text": "什麼的話"
    },
    {
      "end": 292.82,
      "id": 131,
      "start": 291.32,
      "text": "那就不會走向一起"
    },
    {
      "end": 295.26,
      "id": 132,
      "start": 292.82,
      "text": "這樣可以嗎"
    },
    {
      "end": 296.1,
