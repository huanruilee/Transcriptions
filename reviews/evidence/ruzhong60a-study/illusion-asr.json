      "text": "缘而有的话"
    },
    {
      "end": 230.76,
      "id": 95,
      "start": 227.14,
      "text": "就会缘起这样的"
    },
    {
      "end": 232.7,
      "id": 96,
      "start": 230.76,
      "text": "所以不缘而起"
    },
    {
      "end": 233.54,
      "id": 97,
      "start": 232.7,
      "text": "这个就没了"
    },
    {
      "end": 235.76,
      "id": 98,
      "start": 233.54,
      "text": "OK缘起"
    },
    {
      "end": 236.54,
      "id": 99,
