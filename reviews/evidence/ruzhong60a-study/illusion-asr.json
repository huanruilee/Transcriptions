  "segments": [
    {
      "end": 1.82,
      "id": 0,
      "start": 0.06,
      "text": "什么叫做限为自相"
    },
    {
      "end": 2.54,
      "id": 1,
      "start": 1.82,
      "text": "不是自相有"
    },
    {
      "end": 3.72,
      "id": 2,
      "start": 2.54,
      "text": "在我们看来"
    },
    {
      "end": 6.2,
      "id": 3,
      "start": 3.72,
      "text": "它就是跟我的心没有关系的一个存在"
    },
    {
      "end": 7.56,
      "id": 4,
      "start": 6.2,
      "text": "它是存在"
    },
    {
      "end": 8.5,
      "id": 5,
      "start": 7.56,
      "text": "它的存在是"
    },
    {
      "end": 11.68,
      "id": 6,
      "start": 8.5,
      "text": "它的存在跟我的心没有关系了"
    },
    {
      "end": 13.76,
      "id": 7,
      "start": 11.68,
      "text": "就是有音也好"
    },
    {
      "end": 14.48,
      "id": 8,
      "start": 13.76,
      "text": "有果也好"
    },
    {
      "end": 15.4,
      "id": 9,
      "start": 14.48,
      "text": "有自分也好"
    },
    {
      "end": 18.08,
      "id": 10,
      "start": 15.4,
      "text": "反正是从它那边让它存在的"
    },
    {
      "end": 20.03,
      "id": 11,
      "start": 18.08,
      "text": "不是我让它存在的"
    },
    {
      "end": 22.16,
      "id": 12,
      "start": 20.03,
      "text": "不是我们的分别让它存在的"
    },
    {
      "end": 22.54,
      "id": 13,
      "start": 22.16,
      "text": "对不对"
    },
    {
      "end": 27.71,
      "id": 14,
      "start": 22.54,
      "text": "对可是事实上是我的分别让它存在的"
    },
    {
      "end": 30.58,
      "id": 15,
      "start": 27.71,
      "text": "所以就是说前提是它是存在的"
    },
    {
      "end": 33.38,
      "id": 16,
      "start": 30.58,
      "text": "可是不像我们想象当中那样的一个存在"
    },
    {
      "end": 35.04,
      "id": 17,
      "start": 33.38,
      "text": "我们想象当中"
    },
    {
      "end": 36.66,
      "id": 18,
      "start": 35.04,
      "text": "或者是我们限到的那个存在是"
    },
    {
      "end": 39.53,
      "id": 19,
      "start": 36.66,
      "text": "由近上面存在的存在"
    },
    {
      "end": 43.64,
      "id": 20,
      "start": 39.53,
      "text": "事实上是我们安利让它存在的存在"
    },
    {
      "end": 46.57,
      "id": 21,
      "start": 43.64,
      "text": "这样可以吗"
    },
    {
      "end": 50.12,
      "id": 22,
      "start": 46.57,
      "text": "对所以就是变成"
    },
    {
      "end": 53.63,
      "id": 23,
      "start": 50.12,
      "text": "这个就叫做虚妄了"
    },
    {
      "end": 54.15,
      "id": 24,
      "start": 53.63,
      "text": "一切法"
    },
    {
      "end": 55.93,
      "id": 25,
      "start": 54.15,
      "text": "虚妄的意思就是这样"
    },
    {
      "end": 56.35,
      "id": 26,
      "start": 55.93,
      "text": "对不对"
    },
    {
      "end": 59.23,
      "id": 27,
      "start": 56.35,
      "text": "所以虚妄要定在这样一个状态上"
    },
    {
      "end": 60.11,
      "id": 28,
      "start": 59.23,
      "text": "这样可以吗"
    },
    {
      "end": 63.3,
      "id": 29,
      "start": 60.11,
      "text": "如果把虚妄了解成这样一个状态的话"
    },
    {
      "end": 66.46,
      "id": 30,
      "start": 63.3,
      "text": "就有点像是了解了最比较终极的一个虚妄"
    },
    {
      "end": 68.32,
      "id": 31,
      "start": 66.46,
      "text": "因为它是无常"
    },
    {
      "end": 69.22,
      "id": 32,
      "start": 68.32,
      "text": "刹那生命"
    },
    {
      "end": 71.28,
      "id": 33,
      "start": 69.22,
      "text": "所以虚妄这个也是OK的了"
    },
    {
      "end": 76.35,
      "id": 34,
      "start": 71.28,
      "text": "对我们中国的那个虚妄很多是这样"
    },
    {
      "end": 79.44,
      "id": 35,
      "start": 76.35,
      "text": "对反正就是一切事业啦什么什么"
    },
    {
      "end": 81.08,
      "id": 36,
      "start": 79.44,
      "text": "最后快要往生对不对"
    },
    {
      "end": 83.58,
      "id": 37,
      "start": 81.08,
      "text": "一切都是虚妄如梦魂泡影"
    },
    {
      "end": 85.88,
      "id": 38,
      "start": 83.58,
      "text": "对他是在讲那个无常"
    },
    {
      "end": 89.86,
      "id": 39,
      "start": 85.88,
      "text": "对当时很重要的事情"
    },
    {
      "end": 91.52,
      "id": 40,
      "start": 89.86,
      "text": "其实也不重要啊"
    },
    {
      "end": 94.83,
      "id": 41,
      "start": 91.52,
      "text": "大概就是这样一个状态了对不对"
    },
    {
      "end": 102.4,
      "id": 42,
      "start": 94.83,
      "text": "对所以就变成虚妄可以跟无常来讲这个虚妄"
    },
    {
      "end": 106.04,
      "id": 43,
      "start": 102.4,
      "text": "但问题是那个没有走到一个最终极的一个虚妄了"
    },
    {
      "end": 110.36,
      "id": 44,
      "start": 106.04,
      "text": "总之刚刚这个就是中国讲的这样一个虚妄"
    },
    {
      "end": 111.0,
      "id": 45,
      "start": 110.36,
      "text": "这样可以吗"
    },
    {
      "end": 111.64,
      "id": 46,
      "start": 111.0,
      "text": "嗯"
    },
    {
      "end": 113.32,
      "id": 47,
      "start": 111.64,
      "text": "嗯还有就是说自分缘起"
    },
    {
      "end": 119.13,
      "id": 48,
      "start": 113.32,
      "text": "还有就是说像像如果是为是的话"
    },
    {
      "end": 121.05,
      "id": 49,
      "start": 119.13,
      "text": "一体空的这样一个虚妄嘛对不对"
    },
    {
      "end": 123.6,
      "id": 50,
      "start": 121.05,
      "text": "对这些都可以讲"
    },
    {
      "end": 126.0,
      "id": 51,
      "start": 123.6,
      "text": "可是就是说我们今天讲的这个虚妄就是说"
    },
    {
      "end": 127.88,
      "id": 52,
      "start": 126.0,
      "text": "像这方面的一个虚妄这样可以吗"
    },
    {
      "end": 132.23,
      "id": 53,
      "start": 127.88,
      "text": "对所以就变成存在前提"
    },
    {
      "end": 134.09,
      "id": 54,
      "start": 132.23,
      "text": "对品质的存在"
    },
    {
      "end": 136.05,
      "id": 55,
      "start": 134.09,
      "text": "那个是完全的一个前提"
    },
    {
      "end": 138.08,
      "id": 56,
      "start": 136.05,
      "text": "它是怎么存在的"
    },
    {
      "end": 140.11,
      "id": 57,
      "start": 138.08,
      "text": "由因存在"
    },
    {
      "end": 141.65,
      "id": 58,
      "start": 140.11,
      "text": "OK这样可以吗"
    },
    {
      "end": 142.91,
      "id": 59,
      "start": 141.65,
      "text": "由自分而存在OK"
    },
    {
      "end": 147.93,
      "id": 60,
      "start": 142.91,
      "text": "对那是不是有分别让它存在"
    },
    {
      "end": 149.05,
      "id": 61,
      "start": 147.93,
      "text": "也是OK的"
    },
    {
      "end": 152.22,
      "id": 62,
      "start": 149.05,
      "text": "都是这样这样可以吗"
    },
    {
      "end": 153.42,
      "id": 63,
      "start": 152.22,
      "text": "对所以就变成"
    },
    {
      "end": 156.55,
      "id": 64,
      "start": 153.42,
      "text": "总之缘跟起"
    },
    {
      "end": 159.53,
      "id": 65,
      "start": 156.55,
      "text": "谈到这个缘的时候是不是就是变成"
    },
    {
      "end": 161.38,
      "id": 66,
      "start": 159.53,
      "text": "不缘而存在"
    },
    {
      "end": 163.18,
      "id": 67,
      "start": 161.38,
      "text": "会不会破坏掉这个部分"
    },
    {
      "end": 169.5,
      "id": 68,
      "start": 163.18,
      "text": "它是缘而"
    },
    {
      "end": 171.33,
      "id": 69,
      "start": 169.5,
      "text": "它是缘而有嘛对不对"
    },
    {
      "end": 173.07,
      "id": 70,
      "start": 171.33,
      "text": "缘而起"
    },
    {
      "end": 177.62,
      "id": 71,
      "start": 173.07,
      "text": "这个时候就是不缘而有这个会被破坏掉了"
    },
    {
      "end": 181.45,
      "id": 72,
      "start": 177.62,
      "text": "所以这个会打击到自相有自信有等等等等"
    },
    {
      "end": 183.94,
      "id": 73,
      "start": 181.45,
      "text": "到到一切一切"
    },
    {
      "end": 185.44,
      "id": 74,
      "start": 183.94,
      "text": "只要是藏意自在的我空"
    },
    {
      "end": 186.7,
      "id": 75,
      "start": 185.44,
      "text": "不是了藏意自在的我"
    },
    {
      "end": 189.19,
      "id": 76,
      "start": 186.7,
      "text": "会打击到藏意自在的我"
    },
    {
      "end": 190.67,
      "id": 77,
      "start": 189.19,
      "text": "也会打击到多的自私的我"
    },
    {
      "end": 191.87,
      "id": 78,
      "start": 190.67,
      "text": "也会打到实有"
    },
    {
      "end": 195.24,
      "id": 79,
      "start": 191.87,
      "text": "也会打到自信有自相有"
    },
    {
      "end": 197.94,
      "id": 80,
      "start": 195.24,
      "text": "因为这些都会牵扯到不缘而有"
    },
    {
      "end": 201.27,
      "id": 81,
      "start": 197.94,
      "text": "所以我们在讲中观的时候就是讲来讲去"
    },
    {
      "end": 202.13,
      "id": 82,
      "start": 201.27,
      "text": "就是说这样的话"
    },
    {
      "end": 205.27,
      "id": 83,
      "start": 202.13,
      "text": "它就会跟这个不会不缘了嘛"
    },
    {
      "end": 207.36,
      "id": 84,
      "start": 205.27,
      "text": "这样可以吗"
    },
    {
      "end": 209.95,
      "id": 85,
      "start": 207.36,
      "text": "因为跟这个是有缘的"
    },
    {
      "end": 211.46,
      "id": 86,
      "start": 209.95,
      "text": "互相有那个"
    },
    {
      "end": 213.65,
      "id": 87,
      "start": 211.46,
      "text": "有怎么讲"
    },
    {
      "end": 215.53,
      "id": 88,
      "start": 213.65,
      "text": "有依赖还是怎么之类的"
    },
    {
      "end": 218.3,
      "id": 89,
      "start": 215.53,
      "text": "所以它就不会是自信有之类的"
    },
    {
      "end": 219.99,
      "id": 90,
      "start": 218.3,
      "text": "会常常讲这个嘛对不对"
    },
    {
      "end": 221.89,
      "id": 91,
      "start": 219.99,
      "text": "对啊就是缘起嘛"
    },
    {
      "end": 223.77,
      "id": 92,
      "start": 221.89,
      "text": "只要是缘而有"
    },
    {
      "end": 226.1,
      "id": 93,
      "start": 223.77,
      "text": "不管是缘哪一个"
    },
    {
      "end": 227.14,
      "id": 94,
