      "text": "同时断两边"
    },
    {
      "end": 263.92,
      "id": 112,
      "start": 261.42,
      "text": "对那怎么个断长边"
    },
    {
      "end": 267.45,
      "id": 113,
      "start": 263.92,
      "text": "牵涉到的是怎么断长边"
    },
    {
      "end": 268.71,
      "id": 114,
      "start": 267.45,
      "text": "就是像刚才的样子"
    },
    {
      "end": 269.11,
      "id": 115,
      "start": 268.71,
      "text": "这样可以吗"
    },
    {
      "end": 270.23,
      "id": 116,
      "start": 269.11,
      "text": "缘起"
    },
    {
      "end": 274.27,
      "id": 117,
      "start": 270.23,
      "text": "对因为这个的有是一缘而起的"
    },
    {
      "end": 277.13,
      "id": 118,
      "start": 274.27,
      "text": "这样可以吗"
    },
    {
      "end": 278.71,
      "id": 119,
      "start": 277.13,
      "text": "那好好的想一缘而起"
    },
    {
      "end": 279.91,
