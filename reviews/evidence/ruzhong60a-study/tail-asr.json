  "segments": [
    {
      "end": 2.04,
      "id": 0,
      "start": 1.24,
      "text": "本来是什么"
    },
    {
      "end": 3.12,
      "id": 1,
      "start": 2.04,
      "text": "可是知为什么"
    },
    {
      "end": 4.42,
      "id": 2,
      "start": 3.12,
      "text": "知为什么另外什么"
    },
    {
      "end": 6.52,
      "id": 3,
      "start": 4.42,
      "text": "这样对吗"
    },
    {
      "end": 7.86,
      "id": 4,
      "start": 6.52,
      "text": "对那也有正解"
    },
    {
      "end": 10.12,
      "id": 5,
      "start": 7.86,
      "text": "所以三圣的圣人也好"
    },
    {
      "end": 10.62,
      "id": 6,
      "start": 10.12,
      "text": "什么也好"
    },
    {
      "end": 12.58,
      "id": 7,
      "start": 10.62,
      "text": "他们走向了一个正解"
    },
    {
      "end": 16.08,
      "id": 8,
      "start": 12.58,
      "text": "对所以以这个正解"
    },
    {
      "end": 18.32,
      "id": 9,
      "start": 16.08,
      "text": "该怎么讲"
    },
    {
      "end": 21.66,
      "id": 10,
      "start": 18.32,
      "text": "相关的就会变成修行"
    },
    {
      "end": 24.82,
      "id": 11,
      "start": 21.66,
      "text": "而且是说修"
    },
    {
      "end": 26.2,
      "id": 12,
      "start": 24.82,
      "text": "那个该怎么讲"
    },
    {
      "end": 28.56,
      "id": 13,
      "start": 26.2,
      "text": "佛讲的修行这样"
    },
    {
      "end": 30.4,
      "id": 14,
      "start": 28.56,
      "text": "跟这个没有关系的话"
    },
    {
      "end": 32.54,
      "id": 15,
      "start": 30.4,
      "text": "其实就虽然或许是一个"
    },
    {
      "end": 34.68,
      "id": 16,
      "start": 32.54,
      "text": "蛮好的造教部落之类的"
    },
    {
      "end": 35.5,
      "id": 17,
      "start": 34.68,
      "text": "好的一个行为"
    },
    {
      "end": 36.85,
      "id": 18,
      "start": 35.5,
      "text": "但是没办法说"
    },
    {
      "end": 39.27,
      "id": 19,
      "start": 36.85,
      "text": "它是跟佛法有关系的"
    },
    {
      "end": 40.63,
      "id": 20,
      "start": 39.27,
      "text": "或者说就没关系了"
    },
    {
      "end": 41.61,
      "id": 21,
      "start": 40.63,
      "text": "对不对"
    },
    {
      "end": 44.18,
      "id": 22,
      "start": 41.61,
      "text": "对所以总之讲半天"
    },
    {
      "end": 45.5,
      "id": 23,
      "start": 44.18,
      "text": "讲的是什么呢"
    },
    {
      "end": 47.68,
      "id": 24,
      "start": 45.5,
      "text": "就是说知见的错跟对"
    },
    {
      "end": 50.13,
      "id": 25,
      "start": 47.68,
      "text": "分别对不对"
    },
    {
      "end": 51.17,
      "id": 26,
      "start": 50.13,
      "text": "分别执着"
    },
    {
      "end": 53.41,
      "id": 27,
      "start": 51.17,
      "text": "分别邪子什么之类的"
    },
    {
      "end": 55.34,
      "id": 28,
      "start": 53.41,
      "text": "就没有错了"
    },
    {
      "end": 56.64,
      "id": 29,
      "start": 55.34,
      "text": "就是会加一些邪"
    },
    {
      "end": 58.44,
      "id": 30,
      "start": 56.64,
      "text": "邪什么之类的"
    },
    {
      "end": 59.22,
      "id": 31,
      "start": 58.44,
      "text": "但是问题是说"
    },
    {
      "end": 61.22,
      "id": 32,
      "start": 59.22,
      "text": "看过去的时候"
    },
    {
      "end": 63.06,
      "id": 33,
      "start": 61.22,
      "text": "好像就是说错解跟对解这样"
    },
    {
      "end": 66.2,
      "id": 34,
      "start": 63.06,
      "text": "对最终就是说这样可以"
    },
    {
      "end": 67.48,
      "id": 35,
      "start": 66.2,
      "text": "对所以是不是很奇怪"
    },
    {
      "end": 71.67,
      "id": 36,
      "start": 67.48,
      "text": "人家我们会说"
    },
    {
      "end": 72.93,
      "id": 37,
      "start": 71.67,
      "text": "无极神太极"
    },
    {
      "end": 74.07,
      "id": 38,
      "start": 72.93,
      "text": "太极神什么天地"
    },
    {
      "end": 75.78,
      "id": 39,
      "start": 74.07,
      "text": "就蛮厉害的嘛"
    },
    {
      "end": 76.1,
      "id": 40,
      "start": 75.78,
      "text": "对不对"
    },
    {
      "end": 79.38,
      "id": 41,
      "start": 76.1,
      "text": "就要拉大自在什么之类的"
    },
    {
      "end": 81.96,
      "id": 42,
      "start": 79.38,
      "text": "对可是佛教讲的是有心"
    },
    {
      "end": 84.56,
      "id": 43,
      "start": 81.96,
      "text": "心的话就是说错解的一个心"
    },
    {
      "end": 85.54,
      "id": 44,
      "start": 84.56,
      "text": "跟对解的一个心"
    },
    {
      "end": 88.52,
      "id": 45,
      "start": 85.54,
      "text": "创造出完全不同的两个宇宙"
    },
    {
      "end": 91.33,
      "id": 46,
      "start": 88.52,
      "text": "源头就"
    },
    {
      "end": 93.67,
      "id": 47,
      "start": 91.33,
      "text": "这个源头会怎么样"
    },
    {
      "end": 97.5,
      "id": 48,
      "start": 93.67,
      "text": "奇怪还是不奇怪"
    },
    {
      "end": 103.36,
      "id": 49,
      "start": 97.5,
      "text": "问题是事实上是不管它了"
    },
    {
      "end": 105.93,
      "id": 50,
      "start": 103.36,
      "text": "就是说我们讲的这些课"
    },
    {
      "end": 109.16,
      "id": 51,
      "start": 105.93,
      "text": "讲的是不是这个样子"
    },
    {
      "end": 109.7,
      "id": 52,
      "start": 109.16,
      "text": "这样可以吗"
    },
    {
      "end": 112.7,
      "id": 53,
      "start": 109.7,
      "text": "事实上它背后讲的是这样一个状态了"
    },
    {
      "end": 120.2,
      "id": 54,
      "start": 112.7,
      "text": "对所以这个就是分别所造成的"
    },
    {
      "end": 123.74,
      "id": 55,
      "start": 120.2,
      "text": "该怎么讲它的果吗"
    },
    {
      "end": 124.28,
      "id": 56,
