      "text": "对不对"
    },
    {
      "end": 146.42,
      "id": 65,
      "start": 145.96,
      "text": "还是什么"
    },
    {
      "end": 147.26,
      "id": 66,
      "start": 146.42,
      "text": "缘起"
    },
    {
      "end": 149.02,
      "id": 67,
      "start": 147.26,
      "text": "缘起的这个观点就"
    },
    {
      "end": 151.83,
      "id": 68,
      "start": 149.02,
      "text": "就带来了一切的美好吗"
    },
    {
      "end": 152.31,
