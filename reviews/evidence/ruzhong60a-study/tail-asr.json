      "text": "还是什么"
    },
    {
      "end": 154.31,
      "id": 70,
      "start": 152.31,
      "text": "类似这样的一个意思"
    },
    {
      "end": 157.0,
      "id": 71,
      "start": 154.31,
      "text": "对所以"
    },
    {
      "end": 160.75,
      "id": 72,
