  "segments": [
    {
      "end": 7.66,
      "id": 0,
      "start": 0.95,
      "text": "大概這樣"
    },
    {
      "end": 13.19,
      "id": 1,
      "start": 7.66,
      "text": "所以大概這樣"
    },
    {
      "end": 16.7,
      "id": 2,
      "start": 15.7,
      "text": "今天那個不複雜了"
    },
    {
      "end": 20.89,
      "id": 3,
      "start": 16.7,
      "text": "所以也是消了蠻多頁吧"
    },
    {
      "end": 24.57,
      "id": 4,
      "start": 20.89,
      "text": "說不複雜其實也是"
    },
    {
      "end": 28.32,
      "id": 5,
      "start": 24.57,
      "text": "像剛剛提到的一兩個地方吧"
    },
    {
      "end": 33.05,
      "id": 6,
      "start": 28.32,
      "text": "要一些概念其實蠻重要對不對"
    },
    {
      "end": 46.76,
      "id": 7,
      "start": 33.05,
      "text": "還沒有講吧"
    },
    {
      "end": 48.9,
      "id": 8,
      "start": 46.76,
      "text": "我好像還沒講吧"
    },
    {
      "end": 52.89,
      "id": 9,
      "start": 48.9,
      "text": "就是最後那個"
    },
    {
      "end": 56.07,
      "id": 10,
      "start": 52.89,
      "text": "那個還沒有講"
    },
    {
      "end": 59.23,
      "id": 11,
      "start": 56.07,
      "text": "過了"
    },
    {
      "end": 60.23,
      "id": 12,
      "start": 59.23,
      "text": "沒有了"
    },
    {
      "end": 62.23,
      "id": 13,
      "start": 60.23,
      "text": "沒有沒有念過"
    },
    {
      "end": 63.23,
      "id": 14,
      "start": 62.23,
      "text": "真的"
    },
    {
      "end": 65.23,
      "id": 15,
      "start": 63.23,
      "text": "我跟他講"
    },
    {
      "end": 67.23,
      "id": 16,
      "start": 65.23,
      "text": "他這裡最後一句的批"
    },
    {
      "end": 69.23,
      "id": 17,
      "start": 67.23,
      "text": "是在批那個"
    },
    {
      "end": 71.23,
      "id": 18,
      "start": 69.23,
      "text": "那個叫做為市是"
    },
    {
      "end": 74.23,
      "id": 19,
      "start": 71.23,
      "text": "妨礙了世間民言的這個區塊嗎"
    },
    {
      "end": 76.23,
      "id": 20,
      "start": 74.23,
      "text": "他主要是要批判這一塊"
    },
    {
      "end": 80.23,
      "id": 21,
      "start": 76.23,
      "text": "所以他前面講那麼多的"
    },
    {
      "end": 82.23,
      "id": 22,
      "start": 80.23,
      "text": "依世間"
    },
    {
      "end": 84.23,
      "id": 23,
      "start": 82.23,
      "text": "程序而安利的東西"
    },
    {
      "end": 86.23,
      "id": 24,
      "start": 84.23,
      "text": "也要去跟著去"
    },
    {
      "end": 88.23,
      "id": 25,
      "start": 86.23,
      "text": "安利的話其實就是"
    },
    {
      "end": 90.23,
      "id": 26,
      "start": 88.23,
      "text": "主要是在破這個為市"
    },
    {
      "end": 92.95,
      "id": 27,
      "start": 90.23,
      "text": "講無外境這一塊"
    },
    {
      "end": 93.95,
      "id": 28,
      "start": 92.95,
      "text": "講說"
    },
    {
      "end": 94.95,
      "id": 29,
      "start": 93.95,
      "text": "那講無外境其實就是"
    },
    {
      "end": 95.95,
      "id": 30,
      "start": 94.95,
      "text": "違反了所謂"
    },
    {
      "end": 97.95,
      "id": 31,
      "start": 95.95,
      "text": "事先民言安利的這一塊"
    },
    {
      "end": 98.95,
      "id": 32,
      "start": 97.95,
      "text": "對"
    },
    {
      "end": 99.95,
      "id": 33,
      "start": 98.95,
      "text": "無外境的話就是變成"
    },
    {
      "end": 101.95,
      "id": 34,
      "start": 99.95,
      "text": "外境的很多很多論文也會被破壞"
    },
    {
      "end": 104.16,
      "id": 35,
      "start": 101.95,
      "text": "這個區塊當中"
    },
    {
      "end": 105.66,
      "id": 36,
      "start": 104.16,
      "text": "好"
    },
    {
      "end": 107.41,
      "id": 37,
      "start": 105.66,
      "text": "我們講到這邊"
    },
    {
      "end": 108.41,
      "id": 38,
      "start": 107.41,
      "text": "那這邊"
    }
  ],
