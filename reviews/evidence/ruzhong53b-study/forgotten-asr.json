  "segments": [
    {
      "end": 0.9,
      "id": 0,
      "start": 0.0,
      "text": "对不对"
    },
    {
      "end": 3.54,
      "id": 1,
      "start": 0.9,
      "text": "对可是这个就没有这方面这样"
    },
    {
      "end": 7.96,
      "id": 2,
      "start": 3.54,
      "text": "如影山律一经就谈到"
    },
    {
      "end": 9.9,
      "id": 3,
      "start": 7.96,
      "text": "世间与我争我不与世争"
    },
    {
      "end": 11.78,
      "id": 4,
      "start": 9.9,
      "text": "世间说有者我亦说亦"
    },
    {
      "end": 13.52,
      "id": 5,
      "start": 11.78,
      "text": "世间说无者我亦说无"
    },
    {
      "end": 18.48,
      "id": 6,
      "start": 13.52,
      "text": "问题是说世间不会说有空"
    },
    {
      "end": 20.15,
      "id": 7,
      "start": 18.48,
      "text": "不会说空了"
    },
    {
      "end": 20.81,
      "id": 8,
      "start": 20.15,
      "text": "自信空"
    },
    {
      "end": 26.06,
      "id": 9,
      "start": 20.81,
      "text": "我们为什么就一直强调自信空"
    },
    {
      "end": 37.69,
      "id": 10,
      "start": 26.06,
      "text": "对啊所以这个我忘记了"
    },
    {
      "end": 39.79,
      "id": 11,
      "start": 37.69,
      "text": "总之这个要有一点转折"
    },
    {
      "end": 42.3,
      "id": 12,
      "start": 39.79,
      "text": "我今天不会转了"
    },
    {
      "end": 46.18,
      "id": 13,
      "start": 42.3,
      "text": "对就是变成世间与我亦"
    },
    {
      "end": 47.18,
      "id": 14,
      "start": 46.18,
      "text": "我不与世间亦"
    },
    {
      "end": 48.94,
      "id": 15,
      "start": 47.18,
      "text": "世间说有者我亦说亦"
    },
    {
      "end": 50.52,
      "id": 16,
      "start": 48.94,
      "text": "世间说无者我亦说无"
    },
    {
      "end": 51.62,
      "id": 17,
      "start": 50.52,
      "text": "这个并不是这样"
    },
    {
      "end": 55.22,
      "id": 18,
      "start": 51.62,
      "text": "像该怎么讲"
    },
    {
      "end": 58.63,
      "id": 19,
      "start": 55.22,
      "text": "实力是无为了什么等等等等"
    },
    {
      "end": 61.9,
      "id": 20,
      "start": 58.63,
      "text": "或者是佛果的很多很多东西"
    },
    {
      "end": 63.76,
      "id": 21,
      "start": 61.9,
      "text": "那个世间是说无的了"
    },
    {
      "end": 66.04,
      "id": 22,
      "start": 63.76,
      "text": "问题是我们会说有嘛对不对"
    },
    {
      "end": 68.57,
      "id": 23,
      "start": 66.04,
      "text": "很多很多实有的东西吧"
    },
    {
      "end": 69.85,
      "id": 24,
      "start": 68.57,
      "text": "反正就自信啊这些"
    },
    {
      "end": 71.89,
      "id": 25,
      "start": 69.85,
      "text": "要说自信到不能这样说"
    },
    {
      "end": 73.43,
      "id": 26,
      "start": 71.89,
      "text": "我还是什么的"
    },
    {
      "end": 75.02,
      "id": 27,
      "start": 73.43,
      "text": "自信啊什么之类的"
    },
    {
      "end": 76.04,
      "id": 28,
      "start": 75.02,
      "text": "世间会说有了"
    },
    {
      "end": 78.16,
      "id": 29,
      "start": 76.04,
      "text": "因为世间世俗嘛"
    },
    {
      "end": 79.96,
      "id": 30,
      "start": 78.16,
      "text": "世间看到的全部都是自信"
    },
    {
      "end": 80.34,
      "id": 31,
      "start": 79.96,
      "text": "对不对"
    },
    {
      "end": 81.43,
      "id": 32,
      "start": 80.34,
      "text": "会说有"
    },
    {
      "end": 83.57,
      "id": 33,
      "start": 81.43,
      "text": "但是问题是我们并不会说有"
    },
    {
      "end": 85.17,
      "id": 34,
      "start": 83.57,
      "text": "这样子吗"
    },
    {
      "end": 86.35,
      "id": 35,
      "start": 85.17,
      "text": "所以所以呢"
    },
    {
      "end": 90.4,
      "id": 36,
      "start": 86.35,
      "text": "这个意思不是世间说有者我亦说有"
    },
    {
      "end": 91.84,
      "id": 37,
      "start": 90.4,
      "text": "世间说无者我亦说无"
    },
    {
      "end": 92.8,
      "id": 38,
      "start": 91.84,
      "text": "不是这个意思"
    },
    {
      "end": 96.52,
      "id": 39,
      "start": 92.8,
      "text": "那这个意思要调成什么呢"
    },
    {
      "end": 101.62,
      "id": 40,
      "start": 96.52,
      "text": "总之也有一个讲法"
    },
    {
      "end": 102.28,
      "id": 41,
      "start": 101.62,
      "text": "我不会讲"
    },
    {
      "end": 104.04,
      "id": 42,
      "start": 102.28,
      "text": "它有一个稍微的转折"
    },
    {
      "end": 105.16,
      "id": 43,
      "start": 104.04,
      "text": "总之讲的就是那个了"
    },
    {
      "end": 106.0,
      "id": 44,
      "start": 105.16,
      "text": "像上面所说"
    },
    {
      "end": 107.86,
      "id": 45,
      "start": 106.0,
      "text": "其实明眼成许"
    },
    {
      "end": 109.96,
      "id": 46,
      "start": 107.86,
      "text": "他们怎么成许"
    },
    {
      "end": 110.86,
      "id": 47,
      "start": 109.96,
      "text": "我们就怎么接受"
    },
    {
      "end": 114.37,
      "id": 48,
      "start": 110.86,
      "text": "我们的那个我们的这些明眼的案例"
    },
    {
      "end": 116.37,
      "id": 49,
      "start": 114.37,
      "text": "完全就是基于他们的那个程序"
    },
    {
      "end": 117.63,
      "id": 50,
      "start": 116.37,
      "text": "这样可以吗"
    },
    {
      "end": 119.13,
      "id": 51,
      "start": 117.63,
      "text": "他的有就是我们的有"
    },
    {
      "end": 120.61,
      "id": 52,
      "start": 119.13,
      "text": "他无我们就没有"
    },
    {
      "end": 122.38,
      "id": 53,
      "start": 120.61,
      "text": "这边全部都"
    },
    {
      "end": 124.12,
      "id": 54,
      "start": 122.38,
      "text": "就是剩余跟世俗两个"
    },
    {
      "end": 126.17,
      "id": 55,
      "start": 124.12,
      "text": "世俗这个部分的话"
    },
    {
      "end": 128.39,
      "id": 56,
      "start": 126.17,
      "text": "就是说看他怎么那个嘛"
    },
    {
      "end": 130.01,
      "id": 57,
      "start": 128.39,
      "text": "怎么案例我们就怎么接受嘛"
    },
    {
      "end": 130.73,
      "id": 58,
      "start": 130.01,
      "text": "我们没有"
    },
    {
      "end": 133.67,
      "id": 59,
      "start": 130.73,
      "text": "我们没有其他动到什么"
    },
    {
      "end": 135.41,
      "id": 60,
      "start": 133.67,
      "text": "完全没有任何的调整"
    },
    {
      "end": 137.36,
      "id": 61,
      "start": 135.41,
      "text": "其实意思是这个"
    },
    {
      "end": 137.96,
      "id": 62,
      "start": 137.36,
      "text": "这样可以吗"
    },
    {
      "end": 138.6,
      "id": 63,
      "start": 137.96,
      "text": "所以那个"
    },
    {
      "end": 141.05,
      "id": 64,
      "start": 138.6,
      "text": "这段文的时候"
    },
    {
      "end": 142.85,
      "id": 65,
      "start": 141.05,
      "text": "会稍微的加几个字"
    },
    {
      "end": 143.75,
      "id": 66,
