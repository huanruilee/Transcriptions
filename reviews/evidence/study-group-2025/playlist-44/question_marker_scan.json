{
  "schema": "study-group-question-marker-scan/v1",
  "sourceSegments": 4199,
  "matchedMarkerCount": 109,
  "segments": [
    {
      "id": "seg-0033",
      "start": 118.26,
      "end": 123.26,
      "text": "令各种苦乐感受得以显现"
    },
    {
      "id": "seg-0034",
      "start": 123.26,
      "end": 126.15,
      "text": "这里带出两个"
    },
    {
      "id": "seg-0035",
      "start": 126.15,
      "end": 128.31,
      "text": "值得我们心思的问题"
    },
    {
      "id": "seg-0036",
      "start": 128.31,
      "end": 132.71,
      "text": "第一 我们内心五花八门的念头"
    },
    {
      "id": "seg-0037",
      "start": 132.71,
      "end": 136.67,
      "text": "分别执着不同事物各种想法"
    },
    {
      "id": "seg-0067",
      "start": 263.44,
      "end": 267.16,
      "text": "如果仅仅压抑结果"
    },
    {
      "id": "seg-0068",
      "start": 267.16,
      "end": 270.28,
      "text": "根源的因没有断除"
    },
    {
      "id": "seg-0069",
      "start": 270.28,
      "end": 274,
      "text": "问题迟早会再次出现"
    },
    {
      "id": "seg-0070",
      "start": 274,
      "end": 276.84,
      "text": "就像外道透过禅定"
    },
    {
      "id": "seg-0071",
      "start": 276.84,
      "end": 279.64,
      "text": "我们暂时压敷烦恼"
    },
    {
      "id": "seg-0107",
      "start": 385.09,
      "end": 387.67,
      "text": "因此司法院"
    },
    {
      "id": "seg-0108",
      "start": 387.67,
      "end": 390.45,
      "text": "尤其诸法无我"
    },
    {
      "id": "seg-0109",
      "start": 390.45,
      "end": 395.33,
      "text": "便是分辨内外道最重要的标准"
    },
    {
      "id": "seg-0110",
      "start": 395.33,
      "end": 399.71,
      "text": "判断一个人是不是真正的佛弟子"
    },
    {
      "id": "seg-0111",
      "start": 399.71,
      "end": 404.83,
      "text": "可以从见解与行其两个层面来衡量"
    },
    {
      "id": "seg-0112",
      "start": 404.83,
      "end": 406.99,
      "text": "在见解上"
    },
    {
      "id": "seg-0120",
      "start": 421.25,
      "end": 422.13,
      "text": "识心地"
    },
    {
      "id": "seg-0121",
      "start": 422.13,
      "end": 423.47,
      "text": "诸法无我"
    },
    {
      "id": "seg-0122",
      "start": 423.47,
      "end": 427.31,
      "text": "不是单纯拿我是佛弟子做理由"
    },
    {
      "id": "seg-0123",
      "start": 427.31,
      "end": 429.17,
      "text": "就不去思辨"
    },
    {
      "id": "seg-0124",
      "start": 429.17,
      "end": 431.33,
      "text": "在形式上"
    },
    {
      "id": "seg-0190",
      "start": 598.58,
      "end": 600.98,
      "text": "谢谢大家"
    },
    {
      "id": "seg-0191",
      "start": 600.98,
      "end": 602.44,
      "text": "好 谢谢新安"
    },
    {
      "id": "seg-0192",
      "start": 602.44,
      "end": 605.26,
      "text": "那我们今天的题目总共有三题"
    },
    {
      "id": "seg-0193",
      "start": 605.26,
      "end": 607.52,
      "text": "分别是从第五个段落"
    },
    {
      "id": "seg-0194",
      "start": 607.52,
      "end": 608.94,
      "text": "跟第六个段落出来"
    },
    {
      "id": "seg-0195",
      "start": 608.94,
      "end": 611.4,
      "text": "那我们就依序来讨论"
    },
    {
      "id": "seg-0196",
      "start": 611.4,
      "end": 616.44,
      "text": "那第一题等一下有五号十号十四号"
    },
    {
      "id": "seg-0197",
      "start": 616.44,
      "end": 621.28,
      "text": "五号十号十四号的同学来回答"
    },
    {
      "id": "seg-0198",
      "start": 621.28,
      "end": 622.88,
      "text": "那我先把题目念一下"
    },
    {
      "id": "seg-0199",
      "start": 622.88,
      "end": 628.23,
      "text": "第一题持续升起热寿是否会损福报"
    },
    {
      "id": "seg-0200",
      "start": 628.23,
      "end": 631.17,
      "text": "请问以下想法合酒合理"
    },
    {
      "id": "seg-0201",
      "start": 631.17,
      "end": 633.01,
      "text": "花虎一会"
    },
    {
      "id": "seg-0202",
      "start": 633.43,
      "end": 636.23,
      "text": "由于热寿是善业的果报"
    },
    {
      "id": "seg-0210",
      "start": 653.71,
      "end": 655.67,
      "text": "例如解决饥饿后"
    },
    {
      "id": "seg-0211",
      "start": 655.67,
      "end": 657.43,
      "text": "所获得的饱足感"
    },
    {
      "id": "seg-0212",
      "start": 657.43,
      "end": 659.98,
      "text": "并不会损福报"
    },
    {
      "id": "seg-0213",
      "start": 659.98,
      "end": 664.3,
      "text": "但若在过程中挥霍浪费"
    },
    {
      "id": "seg-0214",
      "start": 664.3,
      "end": 665.56,
      "text": "甚至造恶"
    },
    {
      "id": "seg-0215",
      "start": 665.56,
      "end": 667.38,
      "text": "才会损福报"
    },
    {
      "id": "seg-0216",
      "start": 667.38,
      "end": 668.38,
      "text": "瓜糊三"
    },
    {
      "id": "seg-0217",
      "start": 668.38,
      "end": 669.28,
      "text": "不一定"
    },
    {
      "id": "seg-0218",
      "start": 669.28,
      "end": 673.14,
      "text": "例如在行善时若心生欢喜"
    },
    {
      "id": "seg-0219",
      "start": 673.14,
      "end": 674.63,
      "text": "譬如热瘦"
    },
    {
      "id": "seg-0220",
      "start": 674.63,
      "end": 677.79,
      "text": "不仅不会减损福报"
    },
    {
      "id": "seg-0221",
      "start": 677.79,
      "end": 679.37,
      "text": "还能增加善业"
    },
    {
      "id": "seg-0222",
      "start": 679.37,
      "end": 680.85,
      "text": "累积福报"
    },
    {
      "id": "seg-0223",
      "start": 680.85,
      "end": 683.11,
      "text": "然后我们针对这题"
    },
    {
      "id": "seg-0224",
      "start": 683.11,
      "end": 685.23,
      "text": "我们就三个题目就一起答"
    },
    {
      "id": "seg-0225",
      "start": 685.23,
      "end": 687.47,
      "text": "那针对这三个题目"
    },
    {
      "id": "seg-0226",
      "start": 687.47,
      "end": 690.07,
      "text": "魏同学您的想法是如何呢"
    },
    {
      "id": "seg-0227",
      "start": 690.07,
      "end": 693.81,
      "text": "那就请您一一的针对每一个小题进行回答"
    },
    {
      "id": "seg-0228",
      "start": 693.81,
      "end": 698.29,
      "text": "那我们就先请新帝"
    },
    {
      "id": "seg-0229",
      "start": 698.29,
      "end": 701.65,
      "text": "好的师兄"
    },
    {
      "id": "seg-0230",
      "start": 701.65,
      "end": 703.53,
      "text": "这个题目呢"
    },
    {
      "id": "seg-0231",
      "start": 703.53,
      "end": 705.05,
      "text": "我承许第一题"
    },
    {
      "id": "seg-0232",
      "start": 705.05,
      "end": 706.17,
      "text": "因为呢"
    },
    {
      "id": "seg-0233",
      "start": 706.17,
      "end": 707.51,
      "text": "首先我承许"
    },
    {
      "id": "seg-0234",
      "start": 707.51,
      "end": 710.69,
      "text": "就是持续的升起乐寿"
    },
    {
      "id": "seg-0235",
      "start": 710.69,
      "end": 713.73,
      "text": "会那个损福报"
    },
    {
      "id": "seg-0236",
      "start": 713.73,
      "end": 716.17,
      "text": "而且这个里边第一道题呢"
    },
    {
      "id": "seg-0237",
      "start": 716.17,
      "end": 716.73,
      "text": "就说不"
    },
    {
      "id": "seg-0256",
      "start": 753.49,
      "end": 754.75,
      "text": "只有挥霍呀"
    },
    {
      "id": "seg-0257",
      "start": 754.75,
      "end": 756.07,
      "text": "甚至造恶啊"
    },
    {
      "id": "seg-0258",
      "start": 756.07,
      "end": 757.03,
      "text": "才会损福报"
    },
    {
      "id": "seg-0259",
      "start": 757.03,
      "end": 758.01,
      "text": "我不太同意"
    },
    {
      "id": "seg-0260",
      "start": 758.01,
      "end": 760.17,
      "text": "然后第三个呢"
    },
    {
      "id": "seg-0301",
      "start": 823.09,
      "end": 824.79,
      "text": "从这个角度来说"
    },
    {
      "id": "seg-0302",
      "start": 824.79,
      "end": 827.59,
      "text": "它就是之前的善业减少"
    },
    {
      "id": "seg-0303",
      "start": 827.59,
      "end": 829.7,
      "text": "而损福报"
    },
    {
      "id": "seg-0304",
      "start": 829.7,
      "end": 830.68,
      "text": "好"
    },
    {
      "id": "seg-0305",
      "start": 830.68,
      "end": 832,
      "text": "想问一下"
    },
    {
      "id": "seg-0348",
      "start": 925.3,
      "end": 927.62,
      "text": "就是那个以往的业"
    },
    {
      "id": "seg-0349",
      "start": 927.62,
      "end": 930.08,
      "text": "赶得那个福报的果"
    },
    {
      "id": "seg-0350",
      "start": 930.08,
      "end": 933.38,
      "text": "应该都是指的是之后延伸的问题"
    },
    {
      "id": "seg-0351",
      "start": 933.38,
      "end": 935.42,
      "text": "这是我的想法跟补充"
    },
    {
      "id": "seg-0352",
      "start": 935.42,
      "end": 935.66,
      "text": "以上"
    },
    {
      "id": "seg-0374",
      "start": 987.51,
      "end": 989.91,
      "text": "首先我有两个点要补充一下"
    },
    {
      "id": "seg-0375",
      "start": 989.91,
      "end": 994.03,
      "text": "第一点是如果说感受到乐寿"
    },
    {
      "id": "seg-0376",
      "start": 994.03,
      "end": 995.73,
      "text": "就是在损福报的话"
    },
    {
      "id": "seg-0377",
      "start": 995.73,
      "end": 996.59,
      "text": "那我想问一下"
    },
    {
      "id": "seg-0378",
      "start": 996.59,
      "end": 998.75,
      "text": "那些作为禅定的修行者"
    },
    {
      "id": "seg-0387",
      "start": 1010.05,
      "end": 1011.15,
      "text": "大家去打坐呢"
    },
    {
      "id": "seg-0388",
      "start": 1011.15,
      "end": 1011.73,
      "text": "这第一个"
    },
    {
      "id": "seg-0389",
      "start": 1011.73,
      "end": 1012.99,
      "text": "第二个问题是"
    },
    {
      "id": "seg-0390",
      "start": 1012.99,
      "end": 1014.13,
      "text": "我觉得是这样的"
    },
    {
      "id": "seg-0391",
      "start": 1014.13,
      "end": 1015.39,
      "text": "就是说升起乐寿"
    },
    {
      "id": "seg-0451",
      "start": 1104.95,
      "end": 1109.28,
      "text": "如果产生了快乐的感受的时候"
    },
    {
      "id": "seg-0452",
      "start": 1109.28,
      "end": 1110.62,
      "text": "就是在减福报的话"
    },
    {
      "id": "seg-0453",
      "start": 1110.62,
      "end": 1111.66,
      "text": "损福报的话"
    },
    {
      "id": "seg-0454",
      "start": 1111.66,
      "end": 1113.34,
      "text": "那为什么还要去修缠定"
    },
    {
      "id": "seg-0455",
      "start": 1113.34,
      "end": 1115.14,
      "text": "另外一个就是讲到"
    },
    {
      "id": "seg-0465",
      "start": 1127.77,
      "end": 1130.48,
      "text": "产生快乐感受"
    },
    {
      "id": "seg-0466",
      "start": 1130.48,
      "end": 1131.46,
      "text": "那些人就能够"
    },
    {
      "id": "seg-0467",
      "start": 1131.46,
      "end": 1132.84,
      "text": "特别会去损福报"
    },
    {
      "id": "seg-0468",
      "start": 1132.84,
      "end": 1134.4,
      "text": "那这样子来说"
    },
    {
      "id": "seg-0469",
      "start": 1134.4,
      "end": 1135.4,
      "text": "是不是就会有一些"
    },
    {
      "id": "seg-0480",
      "start": 1153.4,
      "end": 1156.07,
      "text": "法师各位同学大家晚安"
    },
    {
      "id": "seg-0481",
      "start": 1156.07,
      "end": 1156.69,
      "text": "我是孟杰"
    },
    {
      "id": "seg-0482",
      "start": 1156.69,
      "end": 1159.05,
      "text": "就是关于第一题的话"
    },
    {
      "id": "seg-0483",
      "start": 1159.05,
      "end": 1159.49,
      "text": "就是"
    },
    {
      "id": "seg-0484",
      "start": 1159.49,
      "end": 1165.02,
      "text": "就是我觉得就是如果说"
    },
    {
      "id": "seg-0491",
      "start": 1175.14,
      "end": 1177.79,
      "text": "是合理的"
    },
    {
      "id": "seg-0492",
      "start": 1177.79,
      "end": 1179.23,
      "text": "可是如果说"
    },
    {
      "id": "seg-0493",
      "start": 1179.23,
      "end": 1182.31,
      "text": "以题目讲的持续升级"
    },
    {
      "id": "seg-0494",
      "start": 1182.31,
      "end": 1184.15,
      "text": "热受是否会显示符号"
    },
    {
      "id": "seg-0495",
      "start": 1184.15,
      "end": 1185.31,
      "text": "因为我不知道这个持续"
    },
    {
      "id": "seg-0552",
      "start": 1311.37,
      "end": 1314.78,
      "text": "但是基本上来讲"
    },
    {
      "id": "seg-0553",
      "start": 1314.78,
      "end": 1317.38,
      "text": "我们就业果的道理来说的话"
    },
    {
      "id": "seg-0554",
      "start": 1317.38,
      "end": 1319.66,
      "text": "这个角度应该是没有问题"
    },
    {
      "id": "seg-0555",
      "start": 1319.66,
      "end": 1322.2,
      "text": "看起来是这样子"
    },
    {
      "id": "seg-0556",
      "start": 1322.2,
      "end": 1324.14,
      "text": "可是我就会想到说"
    },
    {
      "id": "seg-0619",
      "start": 1430.05,
      "end": 1431.51,
      "text": "心生欢喜"
    },
    {
      "id": "seg-0620",
      "start": 1431.51,
      "end": 1432.57,
      "text": "它就是一种热受"
    },
    {
      "id": "seg-0621",
      "start": 1432.57,
      "end": 1434.97,
      "text": "不仅不会减损福报"
    },
    {
      "id": "seg-0622",
      "start": 1434.97,
      "end": 1436.73,
      "text": "还能增加善业"
    },
    {
      "id": "seg-0623",
      "start": 1436.73,
      "end": 1437.85,
      "text": "这点你会觉得"
    },
    {
      "id": "seg-0739",
      "start": 1645.82,
      "end": 1646.78,
      "text": "是的"
    },
    {
      "id": "seg-0740",
      "start": 1646.78,
      "end": 1648.54,
      "text": "师兄"
    },
    {
      "id": "seg-0741",
      "start": 1648.54,
      "end": 1651.56,
      "text": "我倒是对第三题会有一些疑问"
    },
    {
      "id": "seg-0742",
      "start": 1651.56,
      "end": 1655,
      "text": "刚才制宣法师的例子还是比较清楚"
    },
    {
      "id": "seg-0743",
      "start": 1655,
      "end": 1656.32,
      "text": "但是对于这个例子"
    },
    {
      "id": "seg-0801",
      "start": 1785.48,
      "end": 1787.58,
      "text": "那个数字应该就是减少"
    },
    {
      "id": "seg-0802",
      "start": 1787.58,
      "end": 1789.04,
      "text": "这是量子减少"
    },
    {
      "id": "seg-0803",
      "start": 1789.04,
      "end": 1789.86,
      "text": "这一点没有问题"
    },
    {
      "id": "seg-0804",
      "start": 1789.86,
      "end": 1791.98,
      "text": "但是后续会往哪边跑"
    },
    {
      "id": "seg-0805",
      "start": 1791.98,
      "end": 1793.8,
      "text": "这个部分基本上来说"
    },
    {
      "id": "seg-0806",
      "start": 1793.8,
      "end": 1795.12,
      "text": "有太多的因缘"
    },
    {
      "id": "seg-0807",
      "start": 1795.12,
      "end": 1799.44,
      "text": "会有这方面的影响"
    },
    {
      "id": "seg-0808",
      "start": 1799.44,
      "end": 1802.3,
      "text": "但我的问题就是"
    },
    {
      "id": "seg-0809",
      "start": 1802.3,
      "end": 1804.54,
      "text": "如果说它是因为观念的转变"
    },
    {
      "id": "seg-0810",
      "start": 1804.54,
      "end": 1805.82,
      "text": "而产生了快乐"
    },
    {
      "id": "seg-0814",
      "start": 1812.38,
      "end": 1814.78,
      "text": "它如果每一次都会快乐的话"
    },
    {
      "id": "seg-0815",
      "start": 1814.78,
      "end": 1817.24,
      "text": "那它的这个账户余额还会减少吗"
    },
    {
      "id": "seg-0816",
      "start": 1817.24,
      "end": 1820.55,
      "text": "我是这个问题"
    },
    {
      "id": "seg-0817",
      "start": 1820.55,
      "end": 1821.19,
      "text": "好"
    },
    {
      "id": "seg-0818",
      "start": 1821.19,
      "end": 1823.84,
      "text": "不是说我热受增加"
    },
    {
      "id": "seg-0830",
      "start": 1841.36,
      "end": 1849.04,
      "text": "首先我还是要再次说明"
    },
    {
      "id": "seg-0831",
      "start": 1849.04,
      "end": 1850.88,
      "text": "我个人"
    },
    {
      "id": "seg-0832",
      "start": 1850.88,
      "end": 1853.86,
      "text": "对于损福报这一词"
    },
    {
      "id": "seg-0833",
      "start": 1853.86,
      "end": 1857.46,
      "text": "我不觉得这是一个"
    },
    {
      "id": "seg-0834",
      "start": 1857.46,
      "end": 1858.92,
      "text": "负面的描述"
    },
    {
      "id": "seg-0835",
      "start": 1858.92,
      "end": 1861.28,
      "text": "所谓的损福报"
    },
    {
      "id": "seg-0836",
      "start": 1861.28,
      "end": 1862.84,
      "text": "就是福报减损"
    },
    {
      "id": "seg-0837",
      "start": 1862.84,
      "end": 1864.74,
      "text": "福报变少了"
    },
    {
      "id": "seg-0864",
      "start": 1950.4,
      "end": 1952.81,
      "text": "持续生起苦受"
    },
    {
      "id": "seg-0865",
      "start": 1952.81,
      "end": 1954.07,
      "text": "就是在消业障"
    },
    {
      "id": "seg-0866",
      "start": 1954.07,
      "end": 1958.41,
      "text": "所以如果这个问题"
    },
    {
      "id": "seg-0867",
      "start": 1958.41,
      "end": 1960.35,
      "text": "他只是在问说"
    },
    {
      "id": "seg-0868",
      "start": 1960.35,
      "end": 1962.61,
      "text": "我们持续升起乐寿"
    },
    {
      "id": "seg-0875",
      "start": 1978.07,
      "end": 1980.05,
      "text": "他随喜自己"
    },
    {
      "id": "seg-0876",
      "start": 1980.05,
      "end": 1983.48,
      "text": "那在这样的情况下"
    },
    {
      "id": "seg-0877",
      "start": 1983.48,
      "end": 1984.88,
      "text": "他会不会损福报"
    },
    {
      "id": "seg-0878",
      "start": 1984.88,
      "end": 1987.82,
      "text": "我们并不是要讨论这方面的问题"
    },
    {
      "id": "seg-0879",
      "start": 1987.82,
      "end": 1991.24,
      "text": "而是说即便在行善时"
    },
    {
      "id": "seg-0880",
      "start": 1991.24,
      "end": 1994.58,
      "text": "当事人的心中生起了欢喜"
    },
    {
      "id": "seg-0881",
      "start": 1994.58,
      "end": 1997.24,
      "text": "他感受到了乐寿"
    },
    {
      "id": "seg-0882",
      "start": 1997.24,
      "end": 1999.66,
      "text": "但请问那个乐寿是怎么来的"
    },
    {
      "id": "seg-0883",
      "start": 1999.66,
      "end": 2002.26,
      "text": "他在行善的时候"
    },
    {
      "id": "seg-0884",
      "start": 2002.26,
      "end": 2004.14,
      "text": "为什么会生起欢喜心"
    },
    {
      "id": "seg-0902",
      "start": 2052.61,
      "end": 2053.55,
      "text": "那只是说"
    },
    {
      "id": "seg-0903",
      "start": 2053.55,
      "end": 2056.99,
      "text": "那他心生欢喜之后"
    },
    {
      "id": "seg-0904",
      "start": 2056.99,
      "end": 2060.3,
      "text": "你在题目当中说"
    },
    {
      "id": "seg-0905",
      "start": 2060.3,
      "end": 2064.85,
      "text": "心生欢喜不仅不会减损福报"
    },
    {
      "id": "seg-0906",
      "start": 2064.85,
      "end": 2067.93,
      "text": "还能增加善业累积福报"
    },
    {
      "id": "seg-0907",
      "start": 2067.93,
      "end": 2068.87,
      "text": "这未必吧"
    },
    {
      "id": "seg-0941",
      "start": 2149.86,
      "end": 2153.8,
      "text": "在动机良善的情况下"
    },
    {
      "id": "seg-0942",
      "start": 2153.8,
      "end": 2157.14,
      "text": "随喜自己和他人所造的善业"
    },
    {
      "id": "seg-0943",
      "start": 2157.14,
      "end": 2158.8,
      "text": "那这样没有问题"
    },
    {
      "id": "seg-0944",
      "start": 2158.8,
      "end": 2161.44,
      "text": "他可以增加善业累积福报"
    },
    {
      "id": "seg-0945",
      "start": 2161.44,
      "end": 2162.42,
      "text": "这没有问题"
    },
    {
      "id": "seg-0946",
      "start": 2162.42,
      "end": 2168.7,
      "text": "所以我觉得刚才"
    },
    {
      "id": "seg-0947",
      "start": 2168.98,
      "end": 2171.94,
      "text": "制选法是举的那个例子是合理的"
    },
    {
      "id": "seg-0966",
      "start": 2230.32,
      "end": 2232.2,
      "text": "持续的升起乐寿"
    },
    {
      "id": "seg-0967",
      "start": 2232.2,
      "end": 2235.31,
      "text": "是否会让福报减损"
    },
    {
      "id": "seg-0968",
      "start": 2235.31,
      "end": 2237.45,
      "text": "我觉得这没有问题吧"
    },
    {
      "id": "seg-0969",
      "start": 2237.45,
      "end": 2247.11,
      "text": "那如果不是从这个角度来解释损福报的话"
    },
    {
      "id": "seg-0970",
      "start": 2247.11,
      "end": 2250.79,
      "text": "那各位平常是怎么解释损福报这三个字"
    },
    {
      "id": "seg-0971",
      "start": 2250.79,
      "end": 2255.99,
      "text": "损福报的损不就是减损减少的意思吗"
    },
    {
      "id": "seg-0972",
      "start": 2256.54,
      "end": 2261.36,
      "text": "难不成一定要生起称心才叫损福报吗"
    },
    {
      "id": "seg-0973",
      "start": 2261.36,
      "end": 2267.76,
      "text": "生起称心那应该不能称为损福报"
    },
    {
      "id": "seg-0974",
      "start": 2267.76,
      "end": 2270.88,
      "text": "那个叫摧坏善根"
    },
    {
      "id": "seg-0975",
      "start": 2270.88,
      "end": 2273.12,
      "text": "那个叫造作恶业"
    },
    {
      "id": "seg-1015",
      "start": 2414.9,
      "end": 2418.14,
      "text": "这才是关键所在"
    },
    {
      "id": "seg-1016",
      "start": 2418.14,
      "end": 2419.38,
      "text": "不要觉得说"
    },
    {
      "id": "seg-1017",
      "start": 2419.38,
      "end": 2422.18,
      "text": "损福报这个听起来很负面"
    },
    {
      "id": "seg-1018",
      "start": 2422.18,
      "end": 2423.12,
      "text": "很抱歉"
    },
    {
      "id": "seg-1019",
      "start": 2423.12,
      "end": 2429.2,
      "text": "我们从早到晚都在损福报"
    },
    {
      "id": "seg-1020",
      "start": 2429.2,
      "end": 2431.52,
      "text": "对吧"
    },
    {
      "id": "seg-1021",
      "start": 2431.52,
      "end": 2433.3,
      "text": "吃的用的"
    },
    {
      "id": "seg-1084",
      "start": 2635.39,
      "end": 2638.98,
      "text": "至于刚才有同学问到说"
    },
    {
      "id": "seg-1085",
      "start": 2638.98,
      "end": 2641.88,
      "text": "禅宗为什么会鼓励大家打坐"
    },
    {
      "id": "seg-1086",
      "start": 2641.88,
      "end": 2643.88,
      "text": "这不是在损福报吗"
    },
    {
      "id": "seg-1087",
      "start": 2643.88,
      "end": 2647.1,
      "text": "这个问题就跟选项三是一模一样"
    },
    {
      "id": "seg-1088",
      "start": 2647.1,
      "end": 2651.86,
      "text": "世尊也会要我们行善断恶"
    },
    {
      "id": "seg-1089",
      "start": 2651.86,
      "end": 2655.38,
      "text": "世尊也会希望我们经常生起欢喜心"
    },
    {
      "id": "seg-1090",
      "start": 2655.38,
      "end": 2657.7,
      "text": "难道是希望我们损福报吗"
    },
    {
      "id": "seg-1091",
      "start": 2657.7,
      "end": 2658.1,
      "text": "不是"
    },
    {
      "id": "seg-1092",
      "start": 2658.1,
      "end": 2663.3,
      "text": "而是说你做那件事情"
    },
    {
      "id": "seg-1098",
      "start": 2673.46,
      "end": 2675.98,
      "text": "你做这件事情之后"
    },
    {
      "id": "seg-1099",
      "start": 2675.98,
      "end": 2678.52,
      "text": "他是会增加福报"
    },
    {
      "id": "seg-1100",
      "start": 2678.52,
      "end": 2680.16,
      "text": "还是减损福报"
    },
    {
      "id": "seg-1101",
      "start": 2680.16,
      "end": 2682.49,
      "text": "那就因人而已"
    },
    {
      "id": "seg-1102",
      "start": 2682.49,
      "end": 2684.74,
      "text": "那就因人而已"
    },
    {
      "id": "seg-1107",
      "start": 2690.68,
      "end": 2696.73,
      "text": "我们很难透过外在的行为表现来说"
    },
    {
      "id": "seg-1108",
      "start": 2696.73,
      "end": 2699.69,
      "text": "这个人是在累积福报"
    },
    {
      "id": "seg-1109",
      "start": 2699.69,
      "end": 2701.97,
      "text": "还是在损福报"
    },
    {
      "id": "seg-1110",
      "start": 2701.97,
      "end": 2703.47,
      "text": "我觉得这个没有办法判断"
    },
    {
      "id": "seg-1111",
      "start": 2703.47,
      "end": 2705.29,
      "text": "这个没有办法判断"
    },
    {
      "id": "seg-1120",
      "start": 2726.05,
      "end": 2727.59,
      "text": "你造下的就是恶意"
    },
    {
      "id": "seg-1121",
      "start": 2727.59,
      "end": 2730.77,
      "text": "所以以邪恶的动机去打坐"
    },
    {
      "id": "seg-1122",
      "start": 2730.77,
      "end": 2736.56,
      "text": "那这个就是损福报的代表性例子"
    },
    {
      "id": "seg-1123",
      "start": 2736.56,
      "end": 2740.19,
      "text": "它不仅损福报而同时造恶意"
    },
    {
      "id": "seg-1124",
      "start": 2740.19,
      "end": 2744.94,
      "text": "所以还问到说什么"
    },
    {
      "id": "seg-1125",
      "start": 2744.94,
      "end": 2749.47,
      "text": "那我们用正面的角度去看事情"
    },
    {
      "id": "seg-1126",
      "start": 2749.47,
      "end": 2750.95,
      "text": "是不是在损福报"
    },
    {
      "id": "seg-1127",
      "start": 2750.95,
      "end": 2753.63,
      "text": "当然如果我们可以用正面的角度"
    },
    {
      "id": "seg-1128",
      "start": 2753.63,
      "end": 2754.39,
      "text": "在看事情"
    },
    {
      "id": "seg-1160",
      "start": 2840.6,
      "end": 2843.62,
      "text": "还是说我们能够藉由这个机会"
    },
    {
      "id": "seg-1161",
      "start": 2843.62,
      "end": 2846.4,
      "text": "去创造出更大的善业"
    },
    {
      "id": "seg-1162",
      "start": 2846.4,
      "end": 2849.64,
      "text": "这个才是我们需要关注的问题"
    },
    {
      "id": "seg-1163",
      "start": 2849.64,
      "end": 2853.53,
      "text": "刚才同学们的问题"
    },
    {
      "id": "seg-1164",
      "start": 2853.53,
      "end": 2854.59,
      "text": "我都有回答到"
    },
    {
      "id": "seg-1165",
      "start": 2854.59,
      "end": 2856.87,
      "text": "还是有问题没有回答到"
    },
    {
      "id": "seg-1166",
      "start": 2856.87,
      "end": 2861.58,
      "text": "都回答到了"
    },
    {
      "id": "seg-1167",
      "start": 2861.58,
      "end": 2864.61,
      "text": "都有"
    },
    {
      "id": "seg-1169",
      "start": 2866.53,
      "end": 2868.37,
      "text": "感谢法师"
    },
    {
      "id": "seg-1170",
      "start": 2868.37,
      "end": 2870.73,
      "text": "法师我对第三个小问"
    },
    {
      "id": "seg-1171",
      "start": 2870.73,
      "end": 2872.07,
      "text": "有一个问题"
    },
    {
      "id": "seg-1172",
      "start": 2872.07,
      "end": 2874.89,
      "text": "我们对于"
    },
    {
      "id": "seg-1173",
      "start": 2874.89,
      "end": 2877.43,
      "text": "平常我们能接触到的"
    },
    {
      "id": "seg-1348",
      "start": 3284.56,
      "end": 3286.34,
      "text": "来 宗师请说"
    },
    {
      "id": "seg-1349",
      "start": 3286.34,
      "end": 3290.29,
      "text": "法师 您刚才讲的我都听懂了"
    },
    {
      "id": "seg-1350",
      "start": 3290.29,
      "end": 3292.39,
      "text": "但是我就想问您一个问题"
    },
    {
      "id": "seg-1351",
      "start": 3292.39,
      "end": 3295.37,
      "text": "就是说您说就是我们当下的热寿"
    },
    {
      "id": "seg-1352",
      "start": 3295.37,
      "end": 3298.95,
      "text": "持续的热寿其实都是在损福报"
    },
    {
      "id": "seg-1353",
      "start": 3298.95,
      "end": 3299.83,
      "text": "福报在递减"
    },
    {
      "id": "seg-1354",
      "start": 3299.83,
      "end": 3301.57,
      "text": "那我是不是可以理解为"
    },
    {
      "id": "seg-1373",
      "start": 3333.59,
      "end": 3334.53,
      "text": "越来越舒服"
    },
    {
      "id": "seg-1374",
      "start": 3334.53,
      "end": 3335.29,
      "text": "那如果说"
    },
    {
      "id": "seg-1375",
      "start": 3335.29,
      "end": 3336.39,
      "text": "我的问题就是"
    },
    {
      "id": "seg-1376",
      "start": 3336.39,
      "end": 3337.55,
      "text": "越来越舒服"
    },
    {
      "id": "seg-1377",
      "start": 3337.55,
      "end": 3339.61,
      "text": "这跟你过往的善业有什么关系"
    },
    {
      "id": "seg-1411",
      "start": 3401.92,
      "end": 3402.18,
      "text": "不好意思"
    },
    {
      "id": "seg-1412",
      "start": 3402.18,
      "end": 3405.12,
      "text": "高贵先不要再问"
    },
    {
      "id": "seg-1413",
      "start": 3405.12,
      "end": 3406.44,
      "text": "我们先讨论下面的问题"
    },
    {
      "id": "seg-1414",
      "start": 3406.44,
      "end": 3406.76,
      "text": "以上"
    },
    {
      "id": "seg-1415",
      "start": 3406.76,
      "end": 3408.95,
      "text": "好 谢谢老师"
    },
    {
      "id": "seg-1445",
      "start": 3462.66,
      "end": 3466.06,
      "text": "6号7号15号的同学来回答"
    },
    {
      "id": "seg-1446",
      "start": 3466.06,
      "end": 3467.36,
      "text": "那我来念一遍"
    },
    {
      "id": "seg-1447",
      "start": 3467.36,
      "end": 3472.65,
      "text": "第二题关于贪是否为形成乐寿的住院"
    },
    {
      "id": "seg-1448",
      "start": 3472.65,
      "end": 3475.49,
      "text": "请问以下想法何者合理"
    },
    {
      "id": "seg-1449",
      "start": 3475.49,
      "end": 3476.67,
      "text": "关乎一是"
    },
    {
      "id": "seg-1450",
      "start": 3476.67,
      "end": 3478.79,
      "text": "小明很喜欢吃披萨"
    },
    {
      "id": "seg-1541",
      "start": 3682.38,
      "end": 3683.28,
      "text": "其实说法"
    },
    {
      "id": "seg-1542",
      "start": 3683.28,
      "end": 3685.12,
      "text": "自己的讲法就是说"
    },
    {
      "id": "seg-1543",
      "start": 3685.12,
      "end": 3686.14,
      "text": "我们的题目是问"
    },
    {
      "id": "seg-1544",
      "start": 3686.14,
      "end": 3689.24,
      "text": "贪是否为形成热寿的住缘"
    },
    {
      "id": "seg-1545",
      "start": 3689.24,
      "end": 3690.84,
      "text": "这时候应该要回答"
    },
    {
      "id": "seg-1649",
      "start": 3896.41,
      "end": 3898.37,
      "text": "不太一样的同学呢"
    },
    {
      "id": "seg-1650",
      "start": 3898.37,
      "end": 3900.23,
      "text": "或者有想要补充的部分吗"
    },
    {
      "id": "seg-1651",
      "start": 3900.23,
      "end": 3903.05,
      "text": "或者是针对题目的叙述"
    },
    {
      "id": "seg-1652",
      "start": 3903.05,
      "end": 3904.83,
      "text": "你有一些不一样的解释"
    },
    {
      "id": "seg-1653",
      "start": 3904.83,
      "end": 3906.01,
      "text": "有请善元"
    },
    {
      "id": "seg-1696",
      "start": 4017.74,
      "end": 4019.6,
      "text": "师兄好"
    },
    {
      "id": "seg-1697",
      "start": 4019.6,
      "end": 4021.58,
      "text": "我的想法是这样子"
    },
    {
      "id": "seg-1698",
      "start": 4021.58,
      "end": 4023.3,
      "text": "如果要对这个题目"
    },
    {
      "id": "seg-1699",
      "start": 4023.3,
      "end": 4026.04,
      "text": "先做一个那个结论的话"
    },
    {
      "id": "seg-1700",
      "start": 4026.04,
      "end": 4029.1,
      "text": "就是说贪是否为形成乐寿的住院"
    },
    {
      "id": "seg-1709",
      "start": 4049.83,
      "end": 4053.93,
      "text": "我在还不知道那个对象的时候"
    },
    {
      "id": "seg-1710",
      "start": 4053.93,
      "end": 4055.49,
      "text": "我要怎么摊"
    },
    {
      "id": "seg-1711",
      "start": 4055.49,
      "end": 4058.27,
      "text": "那如果以第一题来讲的话"
    },
    {
      "id": "seg-1712",
      "start": 4058.27,
      "end": 4060.39,
      "text": "就是说我很喜欢吃披萨"
    },
    {
      "id": "seg-1713",
      "start": 4060.39,
      "end": 4062.69,
      "text": "那因为是我过去的一个经验"
    },
    {
      "id": "seg-2280",
      "start": 5419.24,
      "end": 5422.96,
      "text": "他在贪念的推动下吃了披萨"
    },
    {
      "id": "seg-2281",
      "start": 5422.96,
      "end": 5424.86,
      "text": "感到格外开心"
    },
    {
      "id": "seg-2282",
      "start": 5424.86,
      "end": 5427.64,
      "text": "请问这个例子"
    },
    {
      "id": "seg-2283",
      "start": 5427.64,
      "end": 5429.64,
      "text": "有没有办法说明"
    },
    {
      "id": "seg-2284",
      "start": 5429.64,
      "end": 5432.92,
      "text": "贪是形成热瘦的祝愿"
    },
    {
      "id": "seg-2403",
      "start": 5718.82,
      "end": 5721.67,
      "text": "而产生了更强的热受"
    },
    {
      "id": "seg-2404",
      "start": 5721.67,
      "end": 5723.8,
      "text": "是"
    },
    {
      "id": "seg-2405",
      "start": 5723.8,
      "end": 5725.66,
      "text": "这应该没有问题吧"
    },
    {
      "id": "seg-2406",
      "start": 5725.66,
      "end": 5727.82,
      "text": "没有"
    },
    {
      "id": "seg-2407",
      "start": 5727.82,
      "end": 5730.56,
      "text": "所以如果我把例子"
    },
    {
      "id": "seg-2460",
      "start": 5871.7,
      "end": 5873.56,
      "text": "他会生起乐寿"
    },
    {
      "id": "seg-2461",
      "start": 5873.56,
      "end": 5875.18,
      "text": "感到格外开心"
    },
    {
      "id": "seg-2462",
      "start": 5875.18,
      "end": 5875.9,
      "text": "没有问题"
    },
    {
      "id": "seg-2463",
      "start": 5875.9,
      "end": 5877.62,
      "text": "但贪久了"
    },
    {
      "id": "seg-2464",
      "start": 5877.62,
      "end": 5879.98,
      "text": "多吃几片之后"
    },
    {
      "id": "seg-2477",
      "start": 5913.38,
      "end": 5916.98,
      "text": "如果让他继续延伸下去"
    },
    {
      "id": "seg-2478",
      "start": 5916.98,
      "end": 5920.92,
      "text": "他也有可能成为苦受的因缘"
    },
    {
      "id": "seg-2479",
      "start": 5920.92,
      "end": 5922.04,
      "text": "我觉得这没有问题"
    },
    {
      "id": "seg-2480",
      "start": 5922.04,
      "end": 5925.05,
      "text": "为什么"
    },
    {
      "id": "seg-2481",
      "start": 5925.05,
      "end": 5929.32,
      "text": "毕竟我们所感到的热受"
    },
    {
      "id": "seg-2486",
      "start": 5941.19,
      "end": 5941.99,
      "text": "苦苦"
    },
    {
      "id": "seg-2487",
      "start": 5941.99,
      "end": 5946.3,
      "text": "这两者都可以是堪的果"
    },
    {
      "id": "seg-2488",
      "start": 5946.3,
      "end": 5948.25,
      "text": "这没有问题"
    },
    {
      "id": "seg-2489",
      "start": 5948.25,
      "end": 5954.11,
      "text": "而不会说贪形成了乐寿"
    },
    {
      "id": "seg-2490",
      "start": 5954.11,
      "end": 5956.25,
      "text": "它是乐寿的因"
    },
    {
      "id": "seg-2520",
      "start": 6038.7,
      "end": 6040.1,
      "text": "为什么不是"
    },
    {
      "id": "seg-2521",
      "start": 6040.1,
      "end": 6045.16,
      "text": "没有贪也有可能升起热寿"
    },
    {
      "id": "seg-2522",
      "start": 6045.16,
      "end": 6047.92,
      "text": "那问题是"
    },
    {
      "id": "seg-2523",
      "start": 6047.92,
      "end": 6051.34,
      "text": "在我们刚才所举的那个例子"
    },
    {
      "id": "seg-2524",
      "start": 6051.34,
      "end": 6052.92,
      "text": "也就是小明跟小美"
    },
    {
      "id": "seg-2597",
      "start": 6228.73,
      "end": 6233.81,
      "text": "当然阿罗汉是我们必须要讨论的一个例子"
    },
    {
      "id": "seg-2598",
      "start": 6233.81,
      "end": 6238.37,
      "text": "但同时也不要忘了"
    },
    {
      "id": "seg-2599",
      "start": 6238.37,
      "end": 6242.29,
      "text": "这个问题真正要讨论的对象是我们自己"
    },
    {
      "id": "seg-2600",
      "start": 6242.29,
      "end": 6246.03,
      "text": "我们到底是怎么受用武欲"
    },
    {
      "id": "seg-2601",
      "start": 6246.03,
      "end": 6251.02,
      "text": "我们为什么会对武欲产生贪念"
    },
    {
      "id": "seg-2871",
      "start": 6890.63,
      "end": 6891.79,
      "text": "好你说"
    },
    {
      "id": "seg-2872",
      "start": 6891.79,
      "end": 6893.15,
      "text": "就是我"
    },
    {
      "id": "seg-2873",
      "start": 6893.15,
      "end": 6896.25,
      "text": "因为本来在这个题目"
    },
    {
      "id": "seg-2874",
      "start": 6896.25,
      "end": 6898.35,
      "text": "在谈的是热寿跟贪"
    },
    {
      "id": "seg-2875",
      "start": 6898.35,
      "end": 6900.47,
      "text": "的因果关系"
    },
    {
      "id": "seg-2925",
      "start": 7002.22,
      "end": 7005.5,
      "text": "以上"
    },
    {
      "id": "seg-2926",
      "start": 7005.5,
      "end": 7007.08,
      "text": "其实我有点"
    },
    {
      "id": "seg-2927",
      "start": 7007.08,
      "end": 7010.84,
      "text": "抓不住你的问题"
    },
    {
      "id": "seg-2928",
      "start": 7010.84,
      "end": 7012.7,
      "text": "也就是针对刮胡寺这个地方"
    },
    {
      "id": "seg-2929",
      "start": 7012.7,
      "end": 7014.28,
      "text": "刮胡寺你成不成许"
    },
    {
      "id": "seg-2997",
      "start": 7135.21,
      "end": 7135.55,
      "text": "对"
    },
    {
      "id": "seg-2998",
      "start": 7135.55,
      "end": 7137.31,
      "text": "我就有点抓不住"
    },
    {
      "id": "seg-2999",
      "start": 7137.31,
      "end": 7138.91,
      "text": "您刚刚的问题"
    },
    {
      "id": "seg-3000",
      "start": 7138.91,
      "end": 7140.51,
      "text": "可能有点没听懂"
    },
    {
      "id": "seg-3001",
      "start": 7140.51,
      "end": 7140.71,
      "text": "是"
    },
    {
      "id": "seg-3040",
      "start": 7217.15,
      "end": 7217.75,
      "text": "这里呢"
    },
    {
      "id": "seg-3041",
      "start": 7217.75,
      "end": 7219.69,
      "text": "就有一个苦引发贪念的"
    },
    {
      "id": "seg-3042",
      "start": 7219.69,
      "end": 7220.39,
      "text": "一个问题"
    },
    {
      "id": "seg-3043",
      "start": 7220.39,
      "end": 7223.03,
      "text": "那又基于之前呢"
    },
    {
      "id": "seg-3044",
      "start": 7223.03,
      "end": 7224.07,
      "text": "他在便利店"
    },
    {
      "id": "seg-3095",
      "start": 7317.81,
      "end": 7321.33,
      "text": "他当下的苦苦"
    },
    {
      "id": "seg-3096",
      "start": 7321.33,
      "end": 7322.15,
      "text": "有请法师"
    },
    {
      "id": "seg-3097",
      "start": 7322.15,
      "end": 7326.36,
      "text": "其实这两个问题"
    },
    {
      "id": "seg-3098",
      "start": 7326.36,
      "end": 7329.42,
      "text": "他会放在一起"
    },
    {
      "id": "seg-3099",
      "start": 7329.42,
      "end": 7333.16,
      "text": "其实是有他的原因的"
    },
    {
      "id": "seg-3141",
      "start": 7460.4,
      "end": 7463.26,
      "text": "而非贪是乐寿的祝愿"
    },
    {
      "id": "seg-3142",
      "start": 7463.26,
      "end": 7465.82,
      "text": "从最初升起的角度来说的话"
    },
    {
      "id": "seg-3143",
      "start": 7465.82,
      "end": 7466.62,
      "text": "我觉得没有问题"
    },
    {
      "id": "seg-3144",
      "start": 7466.62,
      "end": 7469.24,
      "text": "从最初升起的角度"
    },
    {
      "id": "seg-3145",
      "start": 7469.24,
      "end": 7471.12,
      "text": "那这时候会有同学问"
    },
    {
      "id": "seg-3166",
      "start": 7534.69,
      "end": 7536.09,
      "text": "我觉得这就没有关联"
    },
    {
      "id": "seg-3167",
      "start": 7536.09,
      "end": 7539.44,
      "text": "当然也可以往那个方向去分析"
    },
    {
      "id": "seg-3168",
      "start": 7539.94,
      "end": 7542.4,
      "text": "但这个题目他想要问的应该不是这个"
    },
    {
      "id": "seg-3169",
      "start": 7542.4,
      "end": 7545.42,
      "text": "选项四刚好是相反"
    },
    {
      "id": "seg-3170",
      "start": 7545.42,
      "end": 7548.68,
      "text": "选项四他举了一个他熟悉的对境"
    },
    {
      "id": "seg-3188",
      "start": 7602.76,
      "end": 7603.8,
      "text": "他就会感到乐受"
    },
    {
      "id": "seg-3189",
      "start": 7603.8,
      "end": 7605.98,
      "text": "他想要说的应该是这个意思"
    },
    {
      "id": "seg-3190",
      "start": 7605.98,
      "end": 7608.28,
      "text": "这样的描述是没有问题的"
    },
    {
      "id": "seg-3191",
      "start": 7608.28,
      "end": 7611.47,
      "text": "所以这两个例子放在一起"
    },
    {
      "id": "seg-3192",
      "start": 7611.47,
      "end": 7613.87,
      "text": "我觉得他想要对比的就是"
    },
    {
      "id": "seg-3218",
      "start": 7683.35,
      "end": 7686.37,
      "text": "1号 4号 16号"
    },
    {
      "id": "seg-3219",
      "start": 7686.37,
      "end": 7689.79,
      "text": "1号 4号 16号的同学来回答"
    },
    {
      "id": "seg-3220",
      "start": 7689.79,
      "end": 7692.17,
      "text": "那我先把题目念一遍"
    },
    {
      "id": "seg-3221",
      "start": 7692.17,
      "end": 7696.7,
      "text": "关于我们心中的各种起心动念"
    },
    {
      "id": "seg-3222",
      "start": 7696.7,
      "end": 7698.66,
      "text": "是否都是同一条序理"
    },
    {
      "id": "seg-3223",
      "start": 7698.66,
      "end": 7701.68,
      "text": "请问一下想法何者正确"
    },
    {
      "id": "seg-3224",
      "start": 7701.68,
      "end": 7702.3,
      "text": "关乎一"
    },
    {
      "id": "seg-3225",
      "start": 7702.3,
      "end": 7702.66,
      "text": "是"
    },
    {
      "id": "seg-3337",
      "start": 8012.91,
      "end": 8015.71,
      "text": "会是后一面响着闹钟的"
    },
    {
      "id": "seg-3338",
      "start": 8015.71,
      "end": 8016.45,
      "text": "等无见缘"
    },
    {
      "id": "seg-3339",
      "start": 8016.45,
      "end": 8017.01,
      "text": "这没有问题"
    },
    {
      "id": "seg-3340",
      "start": 8017.01,
      "end": 8021.42,
      "text": "而且他基本上来说"
    },
    {
      "id": "seg-3341",
      "start": 8021.42,
      "end": 8022.68,
      "text": "因为没有其他"
    },
    {
      "id": "seg-3355",
      "start": 8055.66,
      "end": 8061.24,
      "text": "完了好像又不太对"
    },
    {
      "id": "seg-3356",
      "start": 8061.24,
      "end": 8066.08,
      "text": "感觉有点点不太确定"
    },
    {
      "id": "seg-3357",
      "start": 8066.08,
      "end": 8069.41,
      "text": "说等无见缘应该没问题了"
    },
    {
      "id": "seg-3358",
      "start": 8069.41,
      "end": 8070.17,
      "text": "可以"
    },
    {
      "id": "seg-3359",
      "start": 8070.17,
      "end": 8072.99,
      "text": "但是进取音的话"
    },
    {
      "id": "seg-3556",
      "start": 8590.02,
      "end": 8594.46,
      "text": "那它就是一个截然不同的分别之"
    },
    {
      "id": "seg-3557",
      "start": 8594.46,
      "end": 8596.72,
      "text": "我倒不会这样看"
    },
    {
      "id": "seg-3558",
      "start": 8596.72,
      "end": 8602.64,
      "text": "我觉得题目当中所说的这三种分别之"
    },
    {
      "id": "seg-3559",
      "start": 8602.64,
      "end": 8608.02,
      "text": "都只不过是对境做出合理判断的分别之"
    },
    {
      "id": "seg-3560",
      "start": 8608.02,
      "end": 8614.79,
      "text": "他都是对静做出合理判断的分别制"
    },
    {
      "id": "seg-3562",
      "start": 8617.41,
      "end": 8620.66,
      "text": "前者是后者的静取音"
    },
    {
      "id": "seg-3563",
      "start": 8620.66,
      "end": 8622.48,
      "text": "他们是同一条序流"
    },
    {
      "id": "seg-3564",
      "start": 8622.48,
      "end": 8625.23,
      "text": "这个有什么严重的问题吗"
    },
    {
      "id": "seg-3565",
      "start": 8625.23,
      "end": 8630.79,
      "text": "如果有严重的过失的话"
    },
    {
      "id": "seg-3566",
      "start": 8630.79,
      "end": 8632.29,
      "text": "同学们可以提出来"
    },
    {
      "id": "seg-3567",
      "start": 8632.29,
      "end": 8635.03,
      "text": "我倒是觉得这没什么太大的问题吧"
    },
    {
      "id": "seg-3568",
      "start": 8635.03,
      "end": 8639.32,
      "text": "根支没有问题"
    },
    {
      "id": "seg-3569",
      "start": 8639.32,
      "end": 8641.16,
      "text": "看着闹钟"
    },
    {
      "id": "seg-3570",
      "start": 8641.16,
      "end": 8642.7,
      "text": "看着讲记"
    },
    {
      "id": "seg-3572",
      "start": 8644.94,
      "end": 8647.4,
      "text": "他们可以是同一条序流"
    },
    {
      "id": "seg-3573",
      "start": 8647.4,
      "end": 8649.56,
      "text": "前者是后者的进取因"
    },
    {
      "id": "seg-3574",
      "start": 8649.56,
      "end": 8650.84,
      "text": "这应该没有问题"
    },
    {
      "id": "seg-3575",
      "start": 8650.84,
      "end": 8654.16,
      "text": "分别之为什么不可以"
    },
    {
      "id": "seg-3576",
      "start": 8654.16,
      "end": 8656.62,
      "text": "到目前为止"
    },
    {
      "id": "seg-3597",
      "start": 8705.57,
      "end": 8708.53,
      "text": "但前者都只是后者的聚生源"
    },
    {
      "id": "seg-3598",
      "start": 8708.53,
      "end": 8711.59,
      "text": "那如果说前者是后者的聚生源"
    },
    {
      "id": "seg-3599",
      "start": 8711.59,
      "end": 8713.99,
      "text": "那请问后者的进取因是什么"
    },
    {
      "id": "seg-3600",
      "start": 8713.99,
      "end": 8717.4,
      "text": "比方说先看到闹钟"
    },
    {
      "id": "seg-3601",
      "start": 8717.4,
      "end": 8718.6,
      "text": "再看到讲记"
    },
    {
      "id": "seg-3939",
      "start": 9573.75,
      "end": 9574.43,
      "text": "好像"
    },
    {
      "id": "seg-3940",
      "start": 9574.43,
      "end": 9578.46,
      "text": "好像有一点困难度"
    },
    {
      "id": "seg-3941",
      "start": 9578.46,
      "end": 9580.82,
      "text": "这个问题"
    },
    {
      "id": "seg-3942",
      "start": 9580.82,
      "end": 9582.42,
      "text": "我倒建议同学们"
    },
    {
      "id": "seg-3943",
      "start": 9582.42,
      "end": 9585.3,
      "text": "不要这么早下定论"
    },
    {
      "id": "seg-3944",
      "start": 9585.3,
      "end": 9586.78,
      "text": "这个问题没有这么容易"
    },
    {
      "id": "seg-3945",
      "start": 9586.78,
      "end": 9592.24,
      "text": "所以应该要先思考的是"
    },
    {
      "id": "seg-3946",
      "start": 9592.24,
      "end": 9595.8,
      "text": "我们心绪当中各种认知"
    },
    {
      "id": "seg-3953",
      "start": 9612.89,
      "end": 9617.15,
      "text": "他存放着无时以来所积累的善恶业"
    },
    {
      "id": "seg-3954",
      "start": 9617.15,
      "end": 9619.23,
      "text": "至今都未曾中断"
    },
    {
      "id": "seg-3955",
      "start": 9619.23,
      "end": 9621.53,
      "text": "到目前为止应该没有什么问题"
    },
    {
      "id": "seg-3956",
      "start": 9621.53,
      "end": 9624.43,
      "text": "他写主要的意志"
    },
    {
      "id": "seg-3957",
      "start": 9624.43,
      "end": 9630.21,
      "text": "但依附在这个意志上的贪嗔慈悲等念头"
    },
    {
      "id": "seg-4000",
      "start": 9757.99,
      "end": 9762.07,
      "text": "贪嗔慈悲都有各自的叙流"
    },
    {
      "id": "seg-4001",
      "start": 9762.07,
      "end": 9765.88,
      "text": "那他们又不是主要的意志"
    },
    {
      "id": "seg-4002",
      "start": 9765.88,
      "end": 9768.8,
      "text": "那请问主要的意志扮演什么角色"
    },
    {
      "id": "seg-4003",
      "start": 9768.8,
      "end": 9772.5,
      "text": "主要的意志只扮演着"
    },
    {
      "id": "seg-4004",
      "start": 9772.5,
      "end": 9774.64,
      "text": "存放善恶业的角色"
    },
    {
      "id": "seg-4027",
      "start": 9837.49,
      "end": 9840.78,
      "text": "所生起的贪"
    },
    {
      "id": "seg-4028",
      "start": 9840.78,
      "end": 9846.32,
      "text": "可以成为看到蟑螂生起撑的进取因"
    },
    {
      "id": "seg-4029",
      "start": 9846.32,
      "end": 9852.3,
      "text": "这个乍看之下似乎没有什么问题"
    },
    {
      "id": "seg-4030",
      "start": 9852.3,
      "end": 9855.58,
      "text": "以我们的情绪反应来看的话"
    },
    {
      "id": "seg-4031",
      "start": 9855.58,
      "end": 9855.84,
      "text": "为什么"
    },
    {
      "id": "seg-4058",
      "start": 9918.84,
      "end": 9920.52,
      "text": "而且这两个念头"
    },
    {
      "id": "seg-4059",
      "start": 9920.52,
      "end": 9923.82,
      "text": "彼此之间是有关联的"
    },
    {
      "id": "seg-4060",
      "start": 9923.82,
      "end": 9926.6,
      "text": "但问题是"
    },
    {
      "id": "seg-4061",
      "start": 9926.6,
      "end": 9929.18,
      "text": "光是有前后的关系"
    },
    {
      "id": "seg-4062",
      "start": 9929.18,
      "end": 9931.14,
      "text": "彼此之间有关联"
    },
    {
      "id": "seg-4090",
      "start": 9993.95,
      "end": 9995.75,
      "text": "是不同的序流的话"
    },
    {
      "id": "seg-4091",
      "start": 9995.75,
      "end": 9999.16,
      "text": "他就可以用另外一套去说明"
    },
    {
      "id": "seg-4092",
      "start": 9999.16,
      "end": 10002.26,
      "text": "讨论这个问题"
    },
    {
      "id": "seg-4093",
      "start": 10002.26,
      "end": 10004.86,
      "text": "最终最终"
    },
    {
      "id": "seg-4094",
      "start": 10004.86,
      "end": 10006.7,
      "text": "就是要解决"
    },
    {
      "id": "seg-4095",
      "start": 10006.7,
      "end": 10008.92,
      "text": "我职跟无我会之间的关联"
    },
    {
      "id": "seg-4096",
      "start": 10008.92,
      "end": 10013.9,
      "text": "这是最终需要思考的问题"
    },
    {
      "id": "seg-4097",
      "start": 10013.9,
      "end": 10017.82,
      "text": "为什么无我会可以断除我职"
    },
    {
      "id": "seg-4098",
      "start": 10017.82,
      "end": 10021.59,
      "text": "他们之间到底是什么关系"
    },
    {
      "id": "seg-4104",
      "start": 10032.57,
      "end": 10036.19,
      "text": "如果我职跟无我会的序流"
    },
    {
      "id": "seg-4105",
      "start": 10036.19,
      "end": 10037.69,
      "text": "别别无关"
    },
    {
      "id": "seg-4106",
      "start": 10037.69,
      "end": 10041.57,
      "text": "请问无我会是怎么断除我职的"
    },
    {
      "id": "seg-4107",
      "start": 10041.57,
      "end": 10044.07,
      "text": "有没有可能是"
    },
    {
      "id": "seg-4108",
      "start": 10044.07,
      "end": 10046.75,
      "text": "无我会的力量大到某种程度"
    },
    {
      "id": "seg-4133",
      "start": 10096.1,
      "end": 10099.23,
      "text": "为什么会有这样的关联"
    },
    {
      "id": "seg-4134",
      "start": 10099.23,
      "end": 10100.41,
      "text": "所以要讨论的"
    },
    {
      "id": "seg-4135",
      "start": 10100.41,
      "end": 10102.41,
      "text": "最终要讨论的是这个问题"
    },
    {
      "id": "seg-4136",
      "start": 10102.41,
      "end": 10104.75,
      "text": "至于其他的"
    },
    {
      "id": "seg-4137",
      "start": 10104.75,
      "end": 10106.45,
      "text": "那个导师比较"
    },
    {
      "id": "seg-4140",
      "start": 10109.86,
      "end": 10112.88,
      "text": "最重要的是还是要思考"
    },
    {
      "id": "seg-4141",
      "start": 10112.88,
      "end": 10116.22,
      "text": "为什么生起无我会能够断除我之"
    },
    {
      "id": "seg-4142",
      "start": 10116.22,
      "end": 10119.24,
      "text": "所以这个问题"
    },
    {
      "id": "seg-4143",
      "start": 10119.24,
      "end": 10121.7,
      "text": "我建议同学们可以放在心中思考"
    },
    {
      "id": "seg-4144",
      "start": 10121.7,
      "end": 10123.48,
      "text": "放在心中思考"
    }
  ]
}
