        "sent-148",
        "sent-149",
        "sent-150"
      ],
      "timingMethod": "source-window",
      "sourceFirst": 129,
      "sourceLast": 150,
      "editorialRole": "source-bound-study-guide"
    },
    {
      "id": "study47B-p12-s1",
      "start": 996.43,
      "end": 1116.38,
      "text": "宗大師的解決方式，是人見水的那一分，鬼沒看到；鬼見的那一分，人沒看到；天人那一分，兩者也沒看到。水不是膿血，也不是甘露，各見各的一分。但以前很多說法會說，同一碗水被人看成什麼、被鬼看成什麼，這樣不能直接把它處理成你見一部分、我見另一部分。很多經典又會這樣說，感覺就很麻煩。",
      "sourceSentenceIds": [
        "sent-151",
        "sent-152",
        "sent-153",
        "sent-154",
        "sent-155",
        "sent-156",
        "sent-157",
        "sent-158",
        "sent-159",
        "sent-160",
        "sent-161",
        "sent-162",
        "sent-163",
        "sent-164",
        "sent-165",
