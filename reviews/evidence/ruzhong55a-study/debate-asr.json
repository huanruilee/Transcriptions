{
  "duration": 300.0,
  "language": "zh",
  "rtf": 0.011221167389885522,
  "segments": [
    {
      "end": 3.65,
      "id": 0,
      "start": 1.11,
      "text": "對,那個是可以啦,總之大概這樣"
    },
    {
      "end": 9.13,
      "id": 1,
      "start": 3.65,
      "text": "嗯,嗯"
    },
    {
      "end": 21.89,
      "id": 2,
      "start": 9.13,
      "text": "老師請問一下那個"
    },
    {
      "end": 25.86,
      "id": 3,
      "start": 21.89,
      "text": "他這邊說心已斷折,業即非有"
    },
    {
      "end": 29.44,
      "id": 4,
      "start": 25.86,
      "text": "無可行嗎?"
    },
    {
      "end": 31.17,
      "id": 5,
      "start": 29.44,
      "text": "嗯?"
    },
    {
      "end": 33.11,
      "id": 6,
      "start": 31.17,
      "text": "心已斷折,折是"
    },
    {
      "end": 36.09,
      "id": 7,
      "start": 33.11,
      "text": "這個心折是無可行嗎?"
    },
    {
      "end": 40.82,
      "id": 8,
      "start": 36.09,
      "text": "嗯,或許"
    },
    {
      "end": 43.86,
      "id": 9,
      "start": 40.82,
      "text": "但是或許也可以說整體是心吧"
    },
    {
      "end": 45.91,
      "id": 10,
      "start": 43.86,
      "text": "如果沒有心的話"
    },
    {
      "end": 47.72,
      "id": 11,
      "start": 45.91,
      "text": "業也就沒有了"
    },
    {
      "end": 48.22,
      "id": 12,
      "start": 47.72,
      "text": "這樣"
    },
    {
      "end": 51.7,
      "id": 13,
      "start": 48.22,
      "text": "那這樣佛有心嗎?"
    },
    {
      "end": 52.52,
      "id": 14,
      "start": 51.7,
      "text": "佛當然有心啊"
    },
    {
      "end": 54.02,
      "id": 15,
      "start": 52.52,
      "text": "佛還在招業就對了"
    },
    {
      "end": 56.56,
      "id": 16,
      "start": 54.02,
      "text": "是啊,沒有啊"
    },
    {
      "end": 57.26,
      "id": 17,
      "start": 56.56,
      "text": "可是"
    },
    {
      "end": 58.92,
      "id": 18,
      "start": 57.26,
      "text": "心已斷折"
    },
    {
      "end": 62.52,
      "id": 19,
      "start": 58.92,
      "text": "業即非有,要有心者,難能造業"
    },
    {
      "end": 64.06,
      "id": 20,
      "start": 62.52,
      "text": "這句話要怎麼樣去"
    },
    {
      "end": 65.06,
      "id": 21,
      "start": 64.06,
      "text": "也就是說"
    },
    {
      "end": 68.28,
      "id": 22,
      "start": 65.06,
      "text": "所以說這句話要理解成有心的才能造業"
    },
    {
      "end": 70.72,
      "id": 23,
      "start": 68.28,
      "text": "但不是所有有心的都能造業"
    },
    {
      "end": 71.22,
      "id": 24,
      "start": 70.72,
      "text": "對啊"
    },
    {
      "end": 73.96,
      "id": 25,
      "start": 71.22,
      "text": "那這樣有什麼樣的是心已斷折"
    },
    {
      "end": 76.06,
      "id": 26,
      "start": 73.96,
      "text": "貧子"
    },
    {
      "end": 81.04,
      "id": 27,
      "start": 76.06,
      "text": "是普特切羅"
    },
    {
      "end": 85.73,
      "id": 28,
      "start": 81.04,
      "text": "所以他這邊在講說一切眾生皆從業生"
    },
    {
      "end": 89.19,
      "id": 29,
      "start": 85.73,
      "text": "然後心已斷折,業即非有"
    },
    {
      "end": 91.57,
      "id": 30,
      "start": 89.19,
      "text": "是說"
    },
    {
      "end": 92.35,
      "id": 31,
      "start": 91.57,
      "text": "設法"
    },
    {
      "end": 94.41,
      "id": 32,
      "start": 92.35,
      "text": "設法就不會"
    },
    {
      "end": 96.14,
      "id": 33,
      "start": 94.41,
      "text": "不是從業生"
    },
    {
      "end": 97.47,
      "id": 34,
      "start": 96.14,
      "text": "是這個意思哦"
    },
    {
      "end": 98.33,
      "id": 35,
      "start": 97.47,
      "text": "什麼意思"
    },
    {
      "end": 99.87,
      "id": 36,
      "start": 98.33,
      "text": "總之沒有心的話就不會有業"
    },
    {
      "end": 100.57,
      "id": 37,
      "start": 99.87,
      "text": "就是這樣"
    },
    {
      "end": 105.66,
      "id": 38,
      "start": 100.57,
      "text": "那要說誰沒有心當然就是平著"
    },
    {
      "end": 116.53,
      "id": 39,
      "start": 105.66,
      "text": "總之以上的話就是變成"
    },
    {
      "end": 120.64,
      "id": 40,
      "start": 116.53,
      "text": "為事可能還是可以有一點想法嘛"
    },
    {
      "end": 123.1,
      "id": 41,
      "start": 120.64,
      "text": "就是變成為事為事嘛對不對"
    },
    {
      "end": 125.65,
      "id": 42,
      "start": 123.1,
      "text": "又沒有來你講到為業"
    },
    {
      "end": 128.36,
      "id": 43,
      "start": 125.65,
      "text": "所以這個行嘛這樣"
    },
    {
      "end": 129.06,
      "id": 44,
      "start": 128.36,
      "text": "那"
    },
    {
      "end": 132.94,
      "id": 45,
      "start": 129.06,
      "text": "就做個這方面的一個年結這樣"
    },
    {
      "end": 143.98,
      "id": 46,
      "start": 132.94,
      "text": "心已斷"
    },
    {
      "end": 146.49,
      "id": 47,
      "start": 143.98,
      "text": "如果本來就沒有心何謂心已斷"
    },
    {
      "end": 147.93,
      "id": 48,
      "start": 146.49,
      "text": "何來心已斷"
    },
    {
      "end": 150.54,
      "id": 49,
      "start": 147.93,
      "text": "心已斷的意思就是沒有心的意思了"
    },
    {
      "end": 155.32,
      "id": 50,
      "start": 150.54,
      "text": "對"
    },
    {
      "end": 158.43,
      "id": 51,
      "start": 155.32,
      "text": "三邦吧"
    },
    {
      "end": 158.83,
      "id": 52,
      "start": 158.43,
      "text": "這樣"
    },
    {
      "end": 167.9,
      "id": 53,
      "start": 158.83,
      "text": "如果是人的話可以這樣"
    },
    {
      "end": 169.3,
      "id": 54,
      "start": 167.9,
      "text": "如果是普特切羅的話"
    },
    {
      "end": 171.74,
      "id": 55,
      "start": 169.3,
      "text": "但是貧子的話就是一開始就是斷了"
    },
    {
      "end": 178.25,
      "id": 56,
      "start": 171.74,
      "text": "是啊是啊"
    },
    {
      "end": 187.72,
      "id": 57,
      "start": 178.25,
      "text": "死掉的時候啊"
    },
    {
      "end": 188.68,
      "id": 58,
      "start": 187.72,
      "text": "那個時候沒有啊"
    },
    {
      "end": 207.13,
      "id": 59,
      "start": 188.68,
      "text": "我們死掉的時候可能"
    },
    {
      "end": 209.67,
      "id": 60,
      "start": 207.13,
      "text": "嗯"
    },
    {
      "end": 210.31,
      "id": 61,
      "start": 209.67,
      "text": "對啊"
    },
    {
      "end": 211.3,
      "id": 62,
      "start": 210.31,
      "text": "對啊"
    },
    {
      "end": 214.62,
      "id": 63,
      "start": 211.3,
      "text": "這個死掉的時候就是那個肢體有心還是什麼意思啊"
    },
    {
      "end": 218.28,
      "id": 64,
      "start": 214.62,
      "text": "還是說那個下一輩子那個人有心"
    },
    {
      "end": 219.28,
      "id": 65,
      "start": 218.28,
      "text": "哪一個有心"
    },
    {
      "end": 223.85,
      "id": 66,
      "start": 219.28,
      "text": "那個不是死掉的有心啊"
    },
    {
      "end": 231.29,
      "id": 67,
      "start": 223.85,
      "text": "喜不是有心了"
    },
    {
      "end": 234.72,
      "id": 68,
      "start": 231.29,
      "text": "對下一輩子的那個死還是有心了"
    },
    {
      "end": 243.02,
      "id": 69,
      "start": 234.72,
      "text": "就沒有怪怪的了"
    },
    {
      "end": 251.6,
      "id": 70,
      "start": 243.02,
      "text": "有時候會討論就是說像你的煩惱"
    },
    {
      "end": 252.8,
      "id": 71,
      "start": 251.6,
      "text": "我是永斷的了"
    },
    {
      "end": 255.46,
      "id": 72,
      "start": 252.8,
      "text": "永斷你的煩惱"
    },
    {
      "end": 260.02,
      "id": 73,
      "start": 255.46,
      "text": "跟我明明就是永斷的嘛對不對"
    },
    {
      "end": 262.36,
      "id": 74,
      "start": 260.02,
      "text": "從貪真辭到一切煩惱"
    },
    {
      "end": 263.36,
      "id": 75,
      "start": 262.36,
      "text": "一切所知障"
    },
    {
      "end": 266.25,
      "id": 76,
      "start": 263.36,
      "text": "雖然我永斷了你的一切的煩惱"
    },
    {
      "end": 268.25,
      "id": 77,
      "start": 266.25,
      "text": "但是問題是說我還是不會稱佛"
    },
    {
      "end": 273.65,
      "id": 78,
      "start": 268.25,
      "text": "我要永斷我自己的煩惱跟所知"
    },
    {
      "end": 275.25,
      "id": 79,
      "start": 273.65,
      "text": "我才會稱佛嘛"
    },
    {
      "end": 277.45,
      "id": 80,
      "start": 275.25,
      "text": "所以就是變成可以講這個斷的了"
    },
    {
      "end": 279.87,
      "id": 81,
      "start": 277.45,
      "text": "我是永斷你的煩惱"
    },
    {
      "end": 282.3,
      "id": 82,
      "start": 279.87,
      "text": "平時是永斷我們的煩惱"
    },
    {
      "end": 285.08,
      "id": 83,
      "start": 282.3,
      "text": "這個是可以講的"
    },
    {
      "end": 287.08,
      "id": 84,
      "start": 285.08,
      "text": "這個沒什麼不可以講的了"
    },
    {
      "end": 299.18,
      "id": 85,
      "start": 287.08,
      "text": "一斤說十二有直接一一心"
    },
    {
      "end": 299.98,
      "id": 86,
      "start": 299.18,
      "text": "顯為至於"
    }
  ],
