      "text": "若许献起真实之"
    },
    {
      "end": 18.47,
      "id": 6,
      "start": 16.81,
      "text": "行者五蕴皆非有"
    },
    {
      "end": 21.88,
      "id": 7,
      "start": 19.64,
      "text": "所以就是变成依世间"
    },
    {
      "end": 24.62,
      "id": 8,
