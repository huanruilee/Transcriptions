  "segments": [
    {
      "end": 1.59,
      "id": 0,
      "start": 0.89,
      "text": "大概是这样"
    },
    {
      "end": 2.29,
      "id": 1,
      "start": 1.59,
      "text": "总之这个"
    },
    {
      "end": 8.66,
      "id": 2,
      "start": 2.29,
      "text": "此事说为事实许心色二法"
    },
    {
      "end": 9.92,
      "id": 3,
      "start": 8.66,
      "text": "有无不同者"
    },
    {
      "end": 15.7,
      "id": 4,
      "start": 9.92,
      "text": "其所无的色为无外色"
    },
    {
      "end": 22.86,
      "id": 5,
      "start": 15.7,
      "text": "他们所讲无外所取"
    },
    {
      "end": 25.24,
      "id": 6,
      "start": 22.86,
      "text": "由种子辨是清等"
    },
    {
      "end": 26.42,
      "id": 7,
      "start": 25.24,
      "text": "他们会这样讲吗"
    },
    {
      "end": 26.74,
      "id": 8,
      "start": 26.42,
      "text": "对不对"
    },
    {
      "end": 30.9,
      "id": 9,
      "start": 26.74,
      "text": "总之由种子所辨了"
    },
    {
      "end": 36.62,
      "id": 10,
      "start": 30.9,
      "text": "无外所取由自己的种子辨是清等"
    },
    {
      "end": 39.74,
      "id": 11,
      "start": 36.62,
      "text": "是就是虽无清等外色"
    },
    {
      "end": 44.55,
      "id": 12,
      "start": 39.74,
      "text": "所无色使与所破上"
    },
    {
      "end": 47.31,
      "id": 13,
      "start": 44.55,
      "text": "加鉴别什么的"
    },
    {
      "end": 53.42,
      "id": 14,
      "start": 47.31,
      "text": "是又云固别为之不破所知"
    },
    {
      "end": 58.33,
      "id": 15,
      "start": 53.42,
      "text": "更以一门名不破外计"
    },
    {
      "end": 61.8,
      "id": 16,
      "start": 58.33,
      "text": "所破色是色"
    },
    {
      "end": 63.7,
      "id": 17,
      "start": 61.8,
      "text": "反正就是说为事为事"
    },
    {
      "end": 66.93,
      "id": 18,
      "start": 63.7,
      "text": "这个破的是外设"
    },
    {
      "end": 67.91,
      "id": 19,
      "start": 66.93,
      "text": "这样的一个说法"
    },
    {
      "end": 70.54,
      "id": 20,
      "start": 67.91,
      "text": "不是非是经意识"
    },
    {
      "end": 72.64,
      "id": 21,
      "start": 70.54,
      "text": "皆是破色"
    },
    {
      "end": 74.32,
      "id": 22,
      "start": 72.64,
      "text": "即是破外经故"
    },
    {
      "end": 76.34,
      "id": 23,
      "start": 74.32,
      "text": "若不如是解的话"
    },
    {
      "end": 83.29,
      "id": 24,
      "start": 76.34,
      "text": "但依闻者则事云固别为之不破所知"
    },
    {
      "end": 86.39,
      "id": 25,
      "start": 83.29,
      "text": "意应所为事中"
    },
    {
      "end": 89.91,
      "id": 26,
      "start": 86.39,
      "text": "须为之破所知心也"
    },
    {
      "end": 95.92,
      "id": 27,
      "start": 89.91,
      "text": "若为为事中不许有色者"
    },
    {
      "end": 98.16,
      "id": 28,
      "start": 95.92,
      "text": "则为事中你阿赖也是死"
    },
    {
      "end": 99.77,
      "id": 29,
      "start": 98.16,
      "text": "这样可以吗"
    },
    {
      "end": 106.5,
      "id": 30,
      "start": 99.77,
      "text": "色大圣论就谈到"
    },
    {
      "end": 108.86,
      "id": 31,
      "start": 106.5,
      "text": "父子皆生相续以"
    },
    {
      "end": 111.97,
      "id": 32,
      "start": 108.86,
      "text": "若利益首是"
    },
    {
      "end": 115.31,
      "id": 33,
      "start": 111.97,
      "text": "直受色根益不可得"
    },
    {
      "end": 118.19,
      "id": 34,
      "start": 115.31,
      "text": "你看就出现了一个色根"
    },
    {
      "end": 119.69,
      "id": 35,
      "start": 118.19,
      "text": "讲阿赖也是的时候"
    },
    {
      "end": 123.0,
      "id": 36,
      "start": 119.69,
      "text": "幼云若利益首是"
    },
    {
      "end": 126.17,
      "id": 37,
      "start": 123.0,
      "text": "事以明色"
    },
    {
      "end": 127.62,
      "id": 38,
      "start": 126.17,
      "text": "这样可以吗"
    },
    {
      "end": 128.66,
      "id": 39,
      "start": 127.62,
      "text": "更那个"
    },
    {
      "end": 130.98,
      "id": 40,
      "start": 128.66,
      "text": "父相依"
    },
    {
      "end": 131.8,
      "id": 41,
      "start": 130.98,
      "text": "譬如"
    },
    {
      "end": 133.75,
      "id": 42,
      "start": 131.8,
      "text": "什么"
    },
    {
      "end": 135.37,
      "id": 43,
      "start": 133.75,
      "text": "如树相依而转"
    },
    {
      "end": 136.61,
      "id": 44,
      "start": 135.37,
      "text": "此意不成"
    },
    {
      "end": 137.17,
      "id": 45,
      "start": 136.61,
      "text": "这样可以吗"
    },
    {
      "end": 140.84,
      "id": 46,
      "start": 137.17,
      "text": "所以也谈到了个色"
    },
    {
      "end": 141.16,
      "id": 47,
      "start": 140.84,
      "text": "对"
    },
    {
      "end": 142.02,
      "id": 48,
      "start": 141.16,
      "text": "所以就变成"
    },
    {
      "end": 145.09,
      "id": 49,
      "start": 142.02,
      "text": "这些事须的就对了"
    },
    {
      "end": 146.31,
      "id": 50,
      "start": 145.09,
      "text": "应皆成相为"
    },
    {
      "end": 147.77,
      "id": 51,
      "start": 146.31,
      "text": "反正就是说"
    },
    {
      "end": 149.35,
      "id": 52,
      "start": 147.77,
      "text": "已许有色法"
    },
    {
      "end": 152.57,
      "id": 53,
      "start": 149.35,
      "text": "既须许有外经故"
    },
    {
      "end": 153.23,
      "id": 54,
      "start": 152.57,
      "text": "这样可以吗"
    },
    {
      "end": 155.22,
      "id": 55,
      "start": 153.23,
      "text": "对反正就是说"
    },
    {
      "end": 156.18,
      "id": 56,
      "start": 155.22,
      "text": "设法跟外经故一样"
    },
    {
      "end": 156.6,
      "id": 57,
      "start": 156.18,
      "text": "就对了"
    },
    {
      "end": 157.18,
      "id": 58,
      "start": 156.6,
      "text": "以事当之"
    },
    {
      "end": 160.66,
      "id": 59,
      "start": 157.18,
      "text": "谁许以原为"
    },
    {
      "end": 162.79,
      "id": 60,
      "start": 160.66,
      "text": "以事为原生"
    },
    {
      "end": 163.59,
      "id": 61,
      "start": 162.79,
      "text": "名色等"
    },
    {
      "end": 166.42,
      "id": 62,
      "start": 163.59,
      "text": "不许许有外经"
    },
    {
      "end": 169.61,
      "id": 63,
      "start": 166.42,
      "text": "为此而说"
    },
    {
      "end": 170.65,
      "id": 64,
      "start": 169.61,
      "text": "名为师中"
    },
    {
      "end": 171.97,
      "id": 65,
      "start": 170.65,
      "text": "不共建立时"
    },
    {
      "end": 176.09,
      "id": 66,
      "start": 171.97,
      "text": "多作如是说故"
    },
    {
      "end": 179.29,
      "id": 67,
      "start": 176.09,
      "text": "既有圣教"
    },
    {
      "end": 180.75,
      "id": 68,
      "start": 179.29,
      "text": "意义了达"
    },
    {
      "end": 181.85,
      "id": 69,
      "start": 180.75,
      "text": "内心外经"
    },
    {
      "end": 182.59,
      "id": 70,
      "start": 181.85,
      "text": "有无相"
    },
    {
      "end": 186.27,
      "id": 71,
      "start": 182.59,
      "text": "大概这样"
    },
    {
      "end": 197.12,
      "id": 72,
      "start": 186.27,
      "text": "反正就是说"
    },
    {
      "end": 198.5,
      "id": 73,
      "start": 197.12,
      "text": "怎么讲"
    },
    {
      "end": 199.38,
      "id": 74,
      "start": 198.5,
      "text": "圣教吧"
    },
    {
      "end": 201.59,
      "id": 75,
