      "text": "嗯"
    },
    {
      "end": 152.58,
      "id": 46,
      "start": 149.75,
      "text": "其中都无作者受者"
    },
    {
      "end": 153.98,
      "id": 47,
      "start": 152.58,
      "text": "彼腹作实验"
    },
    {
      "end": 155.9,
      "id": 48,
      "start": 153.98,
      "text": "什么什么这样"
    },
    {
      "end": 156.7,
      "id": 49,
      "start": 155.9,
      "text": "嗯"
    },
    {
      "end": 161.51,
      "id": 50,
      "start": 156.7,
      "text": "总之这个地方解释的时候"
    },
    {
      "end": 162.51,
      "id": 51,
      "start": 161.51,
      "text": "会有解释那个呢"
    },
    {
      "end": 163.31,
      "id": 52,
      "start": 162.51,
      "text": "就是说"
    },
    {
      "end": 165.27,
      "id": 53,
      "start": 163.31,
      "text": "要说世间万物吗"
    },
    {
      "end": 166.07,
      "id": 54,
