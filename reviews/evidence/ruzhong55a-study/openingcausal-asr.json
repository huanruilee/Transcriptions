      "text": "结晶啊"
    },
    {
      "end": 124.11,
      "id": 37,
      "start": 121.05,
      "text": "上次任结晶已经讲过了的样子对不对"
    },
    {
      "end": 127.03,
      "id": 38,
      "start": 124.11,
      "text": "那到底怎么回事啊"
    },
    {
      "end": 131.66,
      "id": 39,
      "start": 127.03,
      "text": "是伯伎凡"
    },
    {
      "end": 132.66,
