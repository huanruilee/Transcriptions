      "text": "而有这样"
    },
    {
      "end": 188.27,
      "id": 63,
      "start": 183.18,
      "text": "那有应而有这个里面的话就是变成"
    },
    {
      "end": 190.61,
      "id": 64,
      "start": 188.27,
      "text": "像造物主"
    },
    {
      "end": 193.55,
      "id": 65,
