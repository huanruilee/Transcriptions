      "text": "这样可以吗"
    },
    {
      "end": 196.45,
      "id": 67,
      "start": 195.45,
      "text": "第二个的话就是说"
    },
    {
      "end": 199.85,
      "id": 68,
      "start": 196.45,
      "text": "非造物主就是说像叶这样"
    },
    {
      "end": 201.03,
      "id": 69,
      "start": 199.85,
      "text": "对"
    },
    {
      "end": 202.63,
      "id": 70,
