      "text": "类似这样一个状态"
    },
    {
      "end": 34.08,
      "id": 15,
      "start": 33.48,
      "text": "对不对"
    },
    {
      "end": 38.15,
      "id": 16,
      "start": 34.08,
      "text": "对所以这边是在讲什么"
    },
    {
      "end": 39.95,
