      "text": "怎么讲"
    },
    {
      "end": 65.68,
      "id": 25,
      "start": 56.6,
      "text": "嗯"
    },
    {
      "end": 67.28,
      "id": 26,
      "start": 65.68,
      "text": "十弟经应该是有"
    },
    {
      "end": 70.64,
      "id": 27,
