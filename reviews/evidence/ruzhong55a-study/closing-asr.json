  "segments": [
    {
      "end": 5.31,
      "id": 0,
      "start": 0.0,
      "text": "从般若经中佛具则彼等对法具说有"
    },
    {
      "end": 7.58,
      "id": 1,
      "start": 5.31,
      "text": "这样可以吗"
    },
    {
      "end": 10.61,
      "id": 2,
      "start": 7.58,
      "text": "对 照的话像般若经"
    },
    {
      "end": 12.62,
      "id": 3,
      "start": 10.61,
      "text": "色根性都知"
    },
    {
      "end": 14.4,
      "id": 4,
      "start": 12.62,
      "text": "具法的话都说有"
    },
    {
      "end": 16.29,
      "id": 5,
      "start": 14.4,
      "text": "色等五欲"
    },
    {
      "end": 20.63,
      "id": 6,
      "start": 16.29,
      "text": "佛有般若经中具则其自行故"
    },
    {
      "end": 24.19,
      "id": 7,
      "start": 20.63,
      "text": "如与须菩提色自行故"
    },
    {
      "end": 25.65,
      "id": 8,
      "start": 24.19,
      "text": "乃至四自行故这样"
    },
    {
      "end": 30.58,
      "id": 9,
      "start": 25.65,
      "text": "对法中则有志向共向等门"
    },
    {
      "end": 32.94,
      "id": 10,
      "start": 30.58,
      "text": "据说五欲为有"
    },
    {
      "end": 35.85,
      "id": 11,
      "start": 32.94,
      "text": "如是颂约"
    },
    {
      "end": 38.19,
      "id": 12,
      "start": 35.85,
      "text": "二地次地重破坏"
    },
    {
      "end": 40.97,
      "id": 13,
      "start": 38.19,
      "text": "如物以则中不成"
    },
    {
      "end": 57.1,
      "id": 14,
      "start": 40.97,
      "text": "二地的次地重破坏"
    },
    {
      "end": 72.18,
      "id": 15,
      "start": 57.1,
      "text": "这个如物"
    },
    {
      "end": 73.72,
      "id": 16,
      "start": 72.18,
      "text": "这个物指的是石油"
    },
    {
      "end": 76.07,
      "id": 17,
      "start": 73.72,
      "text": "对 所以"
    },
    {
      "end": 79.36,
      "id": 18,
      "start": 76.07,
      "text": "校正都二次地重"
    },
    {
      "end": 80.48,
      "id": 19,
      "start": 79.36,
      "text": "二次地"
    },
    {
      "end": 83.18,
      "id": 20,
      "start": 80.48,
      "text": "总之就是说像上面所说的话"
    },
    {
      "end": 85.44,
      "id": 21,
      "start": 83.18,
      "text": "两种次地应该会遭到破坏"
    },
    {
      "end": 85.92,
      "id": 22,
      "start": 85.44,
      "text": "对不对"
    },
    {
      "end": 87.99,
      "id": 23,
      "start": 85.92,
      "text": "即便破坏了"
    },
    {
      "end": 91.8,
      "id": 24,
      "start": 87.99,
      "text": "能够达成它的所求益"
    },
    {
      "end": 93.49,
      "id": 25,
      "start": 91.8,
      "text": "或许也是一个办法"
    },
    {
      "end": 94.8,
      "id": 26,
      "start": 93.49,
      "text": "总之就是"
    },
    {
      "end": 96.69,
      "id": 27,
      "start": 94.8,
      "text": "如物指的是石油"
    },
    {
      "end": 99.96,
      "id": 28,
      "start": 96.69,
      "text": "但是你们想要达成的那个"
    },
    {
      "end": 101.34,
      "id": 29,
      "start": 99.96,
      "text": "以他其之石油"
    },
    {
      "end": 102.44,
      "id": 30,
      "start": 101.34,
      "text": "或者是内心石油"
    },
    {
      "end": 104.09,
      "id": 31,
      "start": 102.44,
      "text": "这个还是不成"
    },
    {
      "end": 105.42,
      "id": 32,
      "start": 104.09,
      "text": "这样"
    },
    {
      "end": 109.21,
      "id": 33,
      "start": 105.42,
      "text": "事供他终是破坏上来所说"
    },
    {
      "end": 110.51,
      "id": 34,
      "start": 109.21,
      "text": "外经内心"
    },
    {
      "end": 114.25,
      "id": 35,
      "start": 110.51,
      "text": "圣意具有事所具有的这个次地"
    },
    {
      "end": 118.62,
      "id": 36,
      "start": 114.25,
      "text": "圣教以正理所成立之二次地"
    },
    {
      "end": 119.84,
      "id": 37,
      "start": 118.62,
      "text": "这样"
    },
    {
      "end": 121.64,
      "id": 38,
      "start": 119.84,
      "text": "他终的时候会破坏这个"
    },
    {
      "end": 124.17,
      "id": 39,
