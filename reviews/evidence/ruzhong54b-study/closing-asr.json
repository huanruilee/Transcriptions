  "segments": [
    {
      "end": 2.46,
      "id": 0,
      "start": 1.56,
      "text": "大概这样"
    },
    {
      "end": 3.96,
      "id": 1,
      "start": 2.46,
      "text": "我没有办法太专注"
    },
    {
      "end": 7.38,
      "id": 2,
      "start": 3.96,
      "text": "也没有办法讲得很什么的感觉"
    },
    {
      "end": 8.86,
      "id": 3,
      "start": 7.38,
      "text": "但是这些如果可能的话"
    },
    {
      "end": 10.2,
      "id": 4,
      "start": 8.86,
      "text": "就是要非常非常的专注"
    },
    {
      "end": 13.49,
      "id": 5,
      "start": 10.2,
      "text": "这样可以吗"
    },
    {
      "end": 13.71,
      "id": 6,
      "start": 13.49,
      "text": "对"
    },
    {
      "end": 19.1,
      "id": 7,
      "start": 13.71,
      "text": "所以有些人真的是非常专注的了"
    },
    {
      "end": 20.77,
      "id": 8,
      "start": 19.1,
      "text": "像对"
    },
    {
      "end": 24.23,
      "id": 9,
      "start": 20.77,
      "text": "对那种情况很多了"
    },
    {
      "end": 27.1,
      "id": 10,
      "start": 24.23,
      "text": "我有一个那个学长"
    },
    {
      "end": 28.95,
      "id": 11,
      "start": 27.1,
      "text": "对"
    },
    {
      "end": 33.28,
      "id": 12,
      "start": 28.95,
      "text": "他的那个老师好像只有他那个弟子"
    },
    {
      "end": 34.72,
      "id": 13,
      "start": 33.28,
      "text": "对"
    },
    {
      "end": 36.94,
      "id": 14,
      "start": 34.72,
      "text": "但是他那个老师非常有名了"
    },
    {
      "end": 38.16,
      "id": 15,
      "start": 36.94,
      "text": "在社那是非常有名的人"
    },
    {
      "end": 40.37,
      "id": 16,
      "start": 38.16,
      "text": "这是一个坑叔"
    },
    {
      "end": 41.81,
      "id": 17,
      "start": 40.37,
      "text": "他只有一个弟子"
    },
    {
      "end": 42.67,
      "id": 18,
      "start": 41.81,
      "text": "就是他了"
    },
    {
      "end": 45.62,
      "id": 19,
      "start": 42.67,
      "text": "对问题是说"
    },
    {
      "end": 47.22,
      "id": 20,
      "start": 45.62,
      "text": "就是中午吃饱饭对不对"
    },
    {
      "end": 49.22,
      "id": 21,
      "start": 47.22,
      "text": "就轮到他去上课"
    },
    {
      "end": 51.16,
      "id": 22,
      "start": 49.22,
      "text": "对"
    },
    {
      "end": 52.76,
      "id": 23,
      "start": 51.16,
      "text": "那吃饱饭之后"
    },
    {
      "end": 55.88,
      "id": 24,
      "start": 52.76,
      "text": "他就很容易睡着啊"
    },
    {
      "end": 57.1,
      "id": 25,
      "start": 55.88,
      "text": "对那很多时候"
    },
    {
      "end": 59.62,
      "id": 26,
      "start": 57.1,
      "text": "那个老坑叔完全就不知道他睡着了"
    },
    {
      "end": 62.34,
      "id": 27,
      "start": 59.62,
      "text": "对很多时候就是已经五点钟了"
    },
    {
      "end": 66.06,
      "id": 28,
      "start": 62.34,
      "text": "他那个老坑叔就是闭着眼睛"
    },
    {
      "end": 68.95,
      "id": 29,
      "start": 66.06,
      "text": "对就一直讲一直讲一直讲一直讲"
    },
    {
      "end": 69.89,
      "id": 30,
      "start": 68.95,
      "text": "对讲到自己"
    },
    {
      "end": 73.4,
      "id": 31,
      "start": 69.89,
      "text": "自己觉得差不多了"
    },
    {
      "end": 75.08,
      "id": 32,
      "start": 73.4,
      "text": "就会醒过来"
    },
    {
      "end": 77.9,
      "id": 33,
      "start": 75.08,
      "text": "对很多时候就是打他的头"
    },
    {
      "end": 78.22,
      "id": 34,
      "start": 77.9,
      "text": "外"
    },
    {
      "end": 78.66,
      "id": 35,
      "start": 78.24,
      "text": "外"
    },
    {
      "end": 81.33,
      "id": 36,
      "start": 78.66,
      "text": "洗一洗"
    },
    {
      "end": 82.33,
      "id": 37,
      "start": 81.33,
      "text": "去洗一洗"
    },
    {
      "end": 83.49,
      "id": 38,
      "start": 82.33,
      "text": "该吃晚饭了"
    },
    {
      "end": 84.73,
      "id": 39,
      "start": 83.49,
      "text": "去吃晚饭了"
    },
    {
      "end": 85.65,
      "id": 40,
      "start": 84.73,
      "text": "不要睡了"
    },
    {
      "end": 85.85,
      "id": 41,
      "start": 85.65,
      "text": "这样"
    },
    {
      "end": 91.84,
      "id": 42,
      "start": 85.85,
      "text": "人家可能就是从一点左右就已经讲到四五点这样"
    },
    {
      "end": 94.43,
      "id": 43,
      "start": 91.84,
      "text": "对他就睡到这个时候"
    },
    {
      "end": 95.51,
      "id": 44,
      "start": 94.43,
      "text": "因为很热嘛"
    },
    {
      "end": 97.27,
      "id": 45,
      "start": 95.51,
      "text": "又刚好吃的饱饭"
    },
    {
      "end": 98.25,
      "id": 46,
      "start": 97.27,
      "text": "就很热这样"
    },
    {
      "end": 102.88,
      "id": 47,
      "start": 98.25,
      "text": "对所以厂长就是说他他也觉得这样不太好啊"
    },
    {
      "end": 105.04,
      "id": 48,
      "start": 102.88,
      "text": "所以一直蛮想努力"
    },
    {
      "end": 108.51,
      "id": 49,
      "start": 105.04,
      "text": "可是就是说坐下来之后就会睡着"
    },
    {
      "end": 111.76,
      "id": 50,
      "start": 108.51,
      "text": "那那个老师的话就是不会发现"
    },
    {
      "end": 113.67,
      "id": 51,
      "start": 111.76,
      "text": "就是他讲他的这样"
    },
    {
      "end": 114.33,
      "id": 52,
      "start": 113.67,
      "text": "对啊"
    },
    {
      "end": 119.98,
      "id": 53,
      "start": 114.33,
      "text": "所以就变成他们又很清晰的在思考在讲"
    },
    {
      "end": 122.5,
      "id": 54,
      "start": 119.98,
      "text": "这样的话会讲的会非常的好"
    },
    {
      "end": 123.16,
      "id": 55,
      "start": 122.5,
      "text": "这样给吗"
    },
    {
      "end": 125.4,
      "id": 56,
      "start": 123.16,
      "text": "嗯"
    },
    {
      "end": 125.88,
      "id": 57,
      "start": 125.4,
      "text": "对啊"
    },
    {
      "end": 127.84,
      "id": 58,
      "start": 125.88,
      "text": "所以就大概就是这个样子"
    },
    {
      "end": 133.76,
      "id": 59,
      "start": 127.84,
      "text": "嗯"
    },
    {
      "end": 135.74,
      "id": 60,
      "start": 133.76,
      "text": "反正反正这种例子很多"
    },
    {
      "end": 138.78,
      "id": 61,
      "start": 135.74,
      "text": "另外还有一个像"
    },
    {
      "end": 141.36,
      "id": 62,
      "start": 138.78,
      "text": "然后尿一个老师了"
    },
    {
      "end": 144.64,
      "id": 63,
      "start": 141.36,
      "text": "对他也讲讲讲讲讲讲"
    },
    {
      "end": 147.36,
      "id": 64,
      "start": 144.64,
      "text": "讲到一阵子之后啊"
    },
    {
      "end": 148.84,
      "id": 65,
      "start": 147.36,
      "text": "就觉得好奇怪"
    },
    {
      "end": 150.98,
      "id": 66,
      "start": 148.84,
      "text": "一直想不懂是为什么"
    },
    {
      "end": 153.14,
      "id": 67,
      "start": 150.98,
      "text": "对后来发现"
    },
    {
      "end": 154.4,
      "id": 68,
      "start": 153.14,
      "text": "也是一样了"
    },
    {
      "end": 156.38,
      "id": 69,
      "start": 154.4,
      "text": "就是一大堆人挤进来"
    },
    {
      "end": 158.56,
      "id": 70,
      "start": 156.38,
      "text": "那其中有一个人可能在打瞌睡嘛"
    },
    {
      "end": 160.31,
      "id": 71,
      "start": 158.56,
      "text": "对所以会葬到那个床"
    },
    {
      "end": 166.06,
      "id": 72,
      "start": 160.31,
      "text": "对那他就觉得好奇怪"
    },
    {
      "end": 168.52,
      "id": 73,
      "start": 166.06,
      "text": "我一直以为怎么会有地震"
    },
    {
      "end": 170.44,
      "id": 74,
      "start": 168.52,
      "text": "很像地震"
    },
    {
      "end": 173.0,
      "id": 75,
      "start": 170.44,
      "text": "对原来是你在那边搅局"
    },
    {
      "end": 175.5,
      "id": 76,
      "start": 173.0,
      "text": "就是头在打那个嘛"
    },
    {
      "end": 179.77,
      "id": 77,
      "start": 175.5,
      "text": "大概就是这样一个状态"
    },
    {
      "end": 180.87,
      "id": 78,
      "start": 179.77,
      "text": "这样给吗"
    },
    {
      "end": 187.49,
      "id": 79,
      "start": 180.87,
      "text": "对所以要比较专注的去什么会"
    },
    {
      "end": 189.22,
      "id": 80,
      "start": 187.49,
      "text": "但是问题是OK"
    },
    {
      "end": 190.7,
      "id": 81,
      "start": 189.22,
      "text": "反正就是大思考略是这样吧"
    },
    {
      "end": 196.8,
      "id": 82,
      "start": 190.7,
      "text": "那我们今天讲到这边"
    }
