{
  "duration": 345.0,
  "language": "zh",
  "rtf": 0.014654640037654156,
  "segments": [
    {
      "end": 5.54,
      "id": 0,
      "start": 0.0,
      "text": "有一次心 故此破设 非今亦"
    },
    {
      "end": 15.66,
      "id": 1,
      "start": 5.54,
      "text": "这个佛 佛教主 怎么讲"
    },
    {
      "end": 31.06,
      "id": 2,
      "start": 15.66,
      "text": "于真实亦 觉会圆满 明曰为佛"
    },
    {
      "end": 44.0,
      "id": 3,
      "start": 31.06,
      "text": "对啊 就像藏文的话就是 双根双结嘛 对不对"
    },
    {
      "end": 48.32,
      "id": 4,
      "start": 44.0,
      "text": "对 所以双的话就是有苏醒的意思 醒过来的那个心"
    },
    {
      "end": 54.21,
      "id": 5,
      "start": 48.32,
      "text": "结的话就是变成广真 增长广大"
    },
    {
      "end": 58.43,
      "id": 6,
      "start": 54.21,
      "text": "对 所以就是变成那个有点像是某一种结是"
    },
    {
      "end": 62.11,
      "id": 7,
      "start": 58.43,
      "text": "像棉花的那个瓣一样 增长广大过去"
    },
    {
      "end": 66.34,
      "id": 8,
      "start": 62.11,
      "text": "结 所以叫做双结 这样可以吗"
    },
    {
      "end": 71.52,
      "id": 9,
      "start": 66.34,
      "text": "所以其实这边要讲的是说 怎么讲"
    },
    {
      "end": 75.84,
      "id": 10,
      "start": 71.52,
      "text": "总之你看我们这边的话 像藏文的话"
    },
    {
      "end": 83.07,
      "id": 11,
      "start": 75.84,
      "text": "德库那尼拉 罗地吉比双结 因为吉 所以叫做结 这样可以吗"
    },
    {
      "end": 86.32,
      "id": 12,
      "start": 83.07,
      "text": "因为什么什么样的一个吉 所以叫做结"
    },
    {
      "end": 89.12,
      "id": 13,
      "start": 86.32,
      "text": "中文就没办法了 就是真实亦圆满"
    },
    {
      "end": 94.42,
      "id": 14,
      "start": 89.12,
      "text": "所以叫做佛 就莫名其妙了 了解吧"
    },
    {
      "end": 103.28,
      "id": 15,
      "start": 94.42,
      "text": "如果按照藏文的话 如与真实亦 佛顾 明约佛"
    },
    {
      "end": 105.28,
      "id": 16,
      "start": 103.28,
      "text": "要亮一个状态 不是嘛"
    },
    {
      "end": 109.55,
      "id": 17,
      "start": 105.28,
      "text": "就是在做那个字面解释 对不对 那个字意解释"
    },
    {
      "end": 113.92,
      "id": 18,
      "start": 109.55,
      "text": "可是这个 对 所以就是变成"
    },
    {
      "end": 117.47,
      "id": 19,
      "start": 113.92,
      "text": "我们好像是在睡眠当中 无名的睡眠当中"
    },
    {
      "end": 123.22,
      "id": 20,
      "start": 117.47,
      "text": "这样可以吗 对 那佛就从无名当中睡醒了"
    },
    {
      "end": 130.35,
      "id": 21,
      "start": 123.22,
      "text": "所以叫做上识醒的意思 醒过来 我们还在睡 他醒了 这样可以吗"
    },
    {
      "end": 136.51,
      "id": 22,
      "start": 130.35,
      "text": "第一个是醒 第二个是广真的感觉了 我是觉得广真"
    },
    {
      "end": 141.42,
      "id": 23,
      "start": 136.51,
      "text": "醒 觉是哪一个觉啊 觉悟的觉"
    },
    {
      "end": 145.22,
      "id": 24,
      "start": 141.42,
      "text": "觉是啥意思 自意"
    },
    {
      "end": 149.97,
      "id": 25,
      "start": 145.22,
      "text": "OK 觉就已经用过了 那个已经用过了"
    },
    {
      "end": 155.23,
      "id": 26,
      "start": 149.97,
      "text": "觉的话是广真的意思 广真"
    },
    {
      "end": 161.44,
      "id": 27,
      "start": 155.23,
      "text": "行跟觉都一样 行觉 广真 这样可以吗"
    },
    {
      "end": 164.4,
      "id": 28,
      "start": 161.44,
      "text": "那什么叫做广真呢 就是变成我们的那个"
    },
    {
      "end": 168.74,
      "id": 29,
      "start": 164.4,
      "text": "我们的智慧小小 就是变成所知很大 智慧很小"
    },
    {
      "end": 172.99,
      "id": 30,
      "start": 168.74,
      "text": "它的话就是说智慧 遍满一切所知"
    },
    {
      "end": 179.14,
      "id": 31,
      "start": 172.99,
      "text": "所以智慧跟所知一样的广 所以广真的意思了"
    },
    {
      "end": 183.06,
      "id": 32,
      "start": 179.14,
      "text": "这样可以 一方面 两种解释"
    },
    {
      "end": 185.06,
      "id": 33,
      "start": 183.06,
      "text": "所以很多地方会跟那样解释"
    },
    {
      "end": 188.27,
      "id": 34,
      "start": 185.06,
      "text": "中观以下好像那种解释很多了"
    },
    {
      "end": 191.12,
      "id": 35,
      "start": 188.27,
      "text": "可是像这边的话 就是变成对真实意"
    },
    {
      "end": 195.28,
      "id": 36,
      "start": 191.12,
      "text": "就是变成我们那个完全没有接触到真实意嘛 对不对"
    },
    {
      "end": 200.4,
      "id": 37,
      "start": 195.28,
      "text": "那出地到什么地方 就是说稍微对真实意是有"
    },
    {
      "end": 204.94,
      "id": 38,
      "start": 200.4,
      "text": "有一些见地 但是也不是圆满的 该怎么讲"
    },
    {
      "end": 207.57,
      "id": 39,
      "start": 204.94,
      "text": "完全广真 这样可以吗"
    },
    {
      "end": 213.54,
      "id": 40,
      "start": 207.57,
      "text": "对 所以就是变成那个基板的话 就是"
    },
    {
      "end": 220.93,
      "id": 41,
      "start": 213.54,
      "text": "反正就是说 对啊 就是说像声文读觉"
    },
    {
      "end": 224.21,
      "id": 42,
      "start": 220.93,
      "text": "你看中文的话声文读觉还有大圣 佛嘛"
    },
    {
      "end": 226.51,
      "id": 43,
      "start": 224.21,
      "text": "圣文阿罗汉读觉阿罗汉佛"
    },
    {
      "end": 232.1,
      "id": 44,
      "start": 226.51,
      "text": "我们会说什么 就是说小觉 中觉 大觉吗 还是什么"
    },
    {
      "end": 237.06,
      "id": 45,
      "start": 232.1,
      "text": "就是这样讲的嘛 对啊 总之就是变成对"
    },
    {
      "end": 243.65,
      "id": 46,
      "start": 237.06,
      "text": "对 但是问题是说可能要就是变成小广真 对不对"
    },
    {
      "end": 248.56,
      "id": 47,
      "start": 243.65,
      "text": "中广真 大大的广真 其实那是这样的意思"
    },
    {
      "end": 253.9,
      "id": 48,
      "start": 248.56,
      "text": "总之出地的时候已经现真空性了"
    },
    {
      "end": 261.58,
      "id": 49,
      "start": 253.9,
      "text": "对 接下去它十地之间吧 十地 出地到十地"
    },
    {
      "end": 266.06,
      "id": 50,
      "start": 261.58,
      "text": "对真实意的通达的那个情形说不出来"
    },
    {
      "end": 271.49,
      "id": 51,
      "start": 266.06,
      "text": "没办法描述 但就是有进步的空间嘛"
    },
    {
      "end": 277.2,
      "id": 52,
      "start": 271.49,
      "text": "但是问题是说他们都像那个吧 就是说月亮 出山道 对不对"
    },
    {
      "end": 281.06,
      "id": 53,
      "start": 277.2,
      "text": "四五六七八这样 对 佛的时候满了"
    },
    {
      "end": 287.18,
      "id": 54,
      "start": 281.06,
      "text": "对 所以就是变成这个是针对空性了 总之很难讲嘛 对不对"
    },
    {
      "end": 291.79,
      "id": 55,
      "start": 287.18,
      "text": "我们很难讲 但是问题就是说对空性的智慧就满了"
    },
    {
      "end": 296.48,
      "id": 56,
      "start": 291.79,
      "text": "对 往下是缺的了 十地是缺的 这样可以吗"
    },
    {
      "end": 298.24,
      "id": 57,
      "start": 296.48,
      "text": "八地也是缺的 就是这样下来"
    },
    {
      "end": 303.88,
      "id": 58,
      "start": 298.24,
      "text": "对 所以就是变成 总之就是说对真实意也就是对空性了"
    },
    {
      "end": 311.5,
      "id": 59,
      "start": 303.88,
      "text": "嗯 觉慧对空性圆满 对 商劫的劫是这个意思"
    },
    {
      "end": 313.9,
      "id": 60,
      "start": 311.5,
      "text": "所以佛也有这个意思了 这样可以吗"
    },
    {
      "end": 316.33,
      "id": 61,
      "start": 314.33,
      "text": "对 所以就是变成 佛有两种意思了"
    },
    {
      "end": 320.33,
      "id": 62,
      "start": 316.33,
      "text": "就是一种是觉的意思 性的意思嘛 对不对"
    },
    {
      "end": 325.96,
      "id": 63,
      "start": 320.33,
      "text": "一种是应该是觉慧圆满 类似这样的一个意思了"
    },
    {
      "end": 328.63,
      "id": 64,
      "start": 325.96,
      "text": "觉慧广真圆满的意思"
    },
    {
      "end": 331.18,
      "id": 65,
      "start": 328.63,
      "text": "对 所以这边讲的是这个 这样可以吗"
    },
    {
      "end": 336.23,
      "id": 66,
      "start": 332.34,
      "text": "总之这边的重点不在这边 这个重点是说"
    },
    {
      "end": 338.54,
      "id": 67,
      "start": 336.23,
      "text": "佛 佛 佛 佛 佛"
    },
    {
      "end": 345.0,
      "id": 68,
      "start": 338.54,
      "text": "所谓的佛讲的就是说 于真实意 觉慧圆满的佛 称之为佛"
    }
  ],
  "server_elapsed_s": 5.055850812990684,
  "task": "transcribe"
}