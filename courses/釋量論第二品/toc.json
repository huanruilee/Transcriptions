        {
          "title": "五、重點複習",
          "timestamp": 0
        },
        {
          "title": "六、破斥世間造物主的本質",
          "timestamp": 0,
          "verses": [
            {
              "ref": "8",
              "text": "由所知無常 彼不堅性故"
            },
            {
              "ref": "8",
              "text": "量非有常性 達有事量故"
            },
            {
              "ref": "8",
              "text": "有依次生者"
            },
            {
              "ref": "9",
              "text": "常生非理故"
            }
          ]
        },
        {
          "title": "七、破斥有世間造物主的理由",
          "timestamp": 0,
          "verses": [
            {
              "ref": "10",
              "text": "住行形差別 及能作義等"
            },
            {
              "ref": "11",
              "text": "隨有無加持 形等如欲成 由彼所比度 彼是正理性"
            },
            {
              "ref": "12",
              "text": "異事所成就 聲同無異故 比度則非理 如灰物比火"
            }
          ]
        },
        {
          "title": "八、討論法義時應有的態度",
          "timestamp": 0
        }
      ]
