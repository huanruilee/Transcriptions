    {
      "title": "第八講 如何判別因果關係",
      "sessionId": "08",
      "timestamp": 0,
      "children": [
        {
          "title": "一、心是否為世間的造物主",
          "timestamp": 0
        },
        {
          "title": "二、大自在天不應該是萬物的因",
          "timestamp": 0,
          "verses": [
            {
              "ref": "22",
              "text": "──如彼事是因 即何時非因"
            }
          ]
        },
        {
          "title": "三、常法並非永恆不變",
          "timestamp": 0
        },
        {
          "title": "四、常法不應從非因轉變為是因",
          "timestamp": 0,
          "verses": [
            {
              "ref": "24",
              "text": "自性無差別 亦不可能作"
            }
          ]
        },
        {
          "title": "五、因必須對於生果有所饒益",
          "timestamp": 0,
          "verses": [
            {
              "ref": "26",
              "text": "能生苗地等 性轉變是因"
            },
            {
              "ref": "24",
              "text": "常則無遮故 功能亦難知"
            },
            {
              "ref": "25",
              "text": "有何成何性 計餘為彼因 則於一切果 諸因應無窮"
            }
          ]
        },
        {
          "title": "六、因緣聚合才能成為一果之因",
          "timestamp": 0,
          "verses": [
            {
              "ref": "27",
              "text": "諸別別無能 若性無差別 合亦應無能 故成有差別"
            }
          ]
        },
        {
          "title": "七、一法於何時才具有生果的能力",
          "timestamp": 0,
          "verses": [
            {
              "ref": "28",
              "text": "故各別無能 合則有功德"
            }
          ]
        }
      ]
    },
    {
