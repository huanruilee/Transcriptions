    {
      "title": "第五講 介紹量與量士夫",
      "sessionId": "05",
      "timestamp": 0,
      "children": [
        {
          "title": "一、重點複習",
          "timestamp": 0
        },
        {
          "title": "二、分別再決知不是量的理由",
          "timestamp": 0,
          "verses": [
            {
              "ref": "3",
              "text": "緣於已取故 不許彼世俗"
            }
          ]
        },
        {
          "title": "三、量必須是認知的理由",
          "timestamp": 0,
          "verses": [
            {
              "ref": "3",
              "text": "覺是正量性 所取所捨事 轉趣彼主故"
            },
            {
              "ref": "4",
              "text": "由有境各異 覺證各異故 彼有此有故"
            }
          ]
        },
        {
          "title": "四、如何了解量不欺誑",
          "timestamp": 0,
          "verses": [
            {
              "ref": "4",
              "text": "由自證自體"
            },
            {
              "ref": "5",
              "text": "由名言是量"
            }
          ]
        },
        {
          "title": "五、量必須是新的認知",
          "timestamp": 0,
          "verses": [
            {
              "ref": "5",
              "text": "顯不知義爾"
            }
          ]
        },
        {
          "title": "六、顯現新的境不見得是量",
          "timestamp": 0,
          "verses": [
            {
              "ref": "5",
              "text": "證知自體後"
            },
            {
              "ref": "6",
              "text": "總相識應得"
            },
            {
              "ref": "6",
              "text": "意謂於自相 不知所知故 觀察自相故"
            }
          ]
        },
        {
          "title": "七、世尊透由實修而成為量士夫",
          "timestamp": 0
        },
        {
          "title": "八、在生活中如何思惟緣起",
          "timestamp": 0
        },
        {
          "title": "九、透由學習確立自己的目標",
