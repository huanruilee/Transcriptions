        {
          "title": "四、重點複習",
          "timestamp": 0
        },
        {
          "title": "五、心的形成並非依賴於身",
          "timestamp": 0,
          "verses": [
            {
              "ref": "35",
              "text": "非爾破依故"
            }
          ]
        },
        {
          "title": "六、應以客觀的立場探討有無前後世",
          "timestamp": 0
        },
        {
          "title": "七、心能否在身體之外獨立運作",
          "timestamp": 0
        },
        {
          "title": "八、我們的身與心從何而來",
          "timestamp": 0
        },
        {
          "title": "九、以觀待同類前因證成有前後世",
          "timestamp": 0,
          "verses": [
            {
              "ref": "36",
              "text": "最初受生時 呼吸根覺等 非不待自類 唯從於身生"
            },
            {
              "ref": "37",
              "text": "太過故現見 具有結續能 彼為有何事 又由無何事 於後無結續"
            },
            {
              "ref": "38",
              "text": "何處不產生 濕生等眾生 全無彼地等 故一切種性"
            },
            {
              "ref": "39",
              "text": "故根等不待 自類是大種 如一轉變時 皆變無別故"
            }
          ]
        }
      ]
    },
    {
      "title": "第十四講 五根與意知的關係",
      "sessionId": "14",
      "timestamp": 0,
      "children": [
        {
          "title": "一、大悲之後加入增上意樂的理由",
          "timestamp": 0
        },
        {
          "title": "二、應以何種心態看待小乘行者",
          "timestamp": 0
        },
        {
          "title": "三、重點複習與事例辨析",
          "timestamp": 0
        },
        {
          "title": "四、五根能否成為意知的近取因",
          "timestamp": 0,
          "verses": [
            {
              "ref": "40",
              "text": "諸根一一損 意覺非有損"
            }
          ]
        },
        {
          "title": "五、以喻說明苦樂源自於心",
          "timestamp": 0
        },
        {
          "title": "六、五根與意知之間的關係",
          "timestamp": 0,
          "verses": [
            {
              "ref": "40",
              "text": "此變則現見 彼等亦轉變"
            }
          ]
        },
        {
          "title": "七、世間人如何看待苦樂",
          "timestamp": 0
        }
      ]
    },
    {
      "title": "第十五講 探討身心如何運作",
      "sessionId": "15",
      "timestamp": 0,
      "children": [
        {
          "title": "一、五根是由意知所生",
          "timestamp": 0,
          "verses": [
            {
              "ref": "41",
              "text": "故覺住所依 有依於覺性 是諸根之因 故是根從覺"
            }
          ]
        },
        {
          "title": "二、解釋何謂身心互相隨逐",
          "timestamp": 0,
          "verses": [
            {
              "ref": "42",
              "text": "有如彼能引 後亦當如彼 由彼識益故 說意依於身"
            }
          ]
        },
        {
          "title": "三、根知與意知有無形成的先後次第",
          "timestamp": 0
        },
        {
          "title": "四、說明何謂身心互為因果",
          "timestamp": 0,
          "verses": [
            {
              "ref": "43",
              "text": "若無根非覺 彼亦非彼無 如是互為因 故互是有因"
            }
          ]
        },
        {
          "title": "五、破斥外道所許意知依身的主張",
          "timestamp": 0,
          "verses": [
            {
              "ref": "44",
              "text": "從無次第者 非生有次第 非別亦無待 從身次生覺 彼亦顯次第"
            },
            {
              "ref": "45",
              "text": "其前前剎那 是一一剎那 先無者之因 是故一切時 可見其為因"
            }
          ]
        },
        {
          "title": "六、斷除煩惱之後心是否會中斷",
          "timestamp": 0
        },
        {
          "title": "七、破斥他宗主張沒有前後世的立論",
          "timestamp": 0,
          "verses": [
            {
              "ref": "46",
              "text": "後心與餘心 結續有何違 彼羅漢後心 由何許無續"
            },
            {
              "ref": "47",
              "text": "豈隨此宗派 量不成義耶 若謂離彼因 此中何不說"
            }
          ]
        },
        {
          "title": "八、剖析身不是意知的增上緣",
          "timestamp": 0,
          "verses": [
