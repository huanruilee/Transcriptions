      "start": 875.89,
      "end": 898.81
    },
    {
      "id": "p_48",
      "heading": null,
      "sentences": [
        {
          "start": 898.81,
          "end": 910.41,
          "text": "就變成，呃，緣青色的演示，跟回憶，自心無緣的是，同樣一個青色，對，這個回答的時候。"
