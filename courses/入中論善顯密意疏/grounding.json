  "terminology": [
    {
      "term": "現量",
      "note": "不得盲將現量與現前通達兩用法合一"
    },
    {
      "term": "比量",
      "note": "比度而生；初通達無常例"
    },
    {
      "term": "已決識",
      "note": "舊稿以絕制等音寫；本講有宗派分類限定"
    },
    {
      "term": "境與有境",
      "note": "舊稿近/靜/俱近/拒絕/聚集等音寫須按上下文，不作全庫替換"
    },
    {
      "term": "自證",
      "note": "自證自知與由成立所量成立能量不可混同"
    },
    {
      "term": "根本無漏智",
      "note": "如水注水為自境界二現不現，非宗派自證混一"
    },
    {
      "term": "成立與通達",
      "note": "本講兩派爭議，禁止把一方升成定論"
    },
    {
      "term": "自性有／依他起",
      "note": "自生他生及自證所破為自性實有，不否定名言依他起。"
    },
    {
      "term": "無方分極微",
      "note": "五方分/圍城等音寫須核，不變成不存在一切微塵。"
    },
    {
      "term": "二諦與無過失名言",
      "note": "本堂區分懂世俗諦與無過失名言建立，講者明說自己講法不見得對。"
    },
    {
      "term": "增益",
      "note": "53B不限於錯誤，凡分別假立皆可稱；不全改顛倒。"
    },
    {
      "term": "阿叉囉",
      "note": "字/不變兩義，依上課版163；無字譯法須保留講者辨析。"
    },
    {
      "term": "無方分極微",
      "note": "54A破此及聚合境不必破一切外境，與無時分內識對照。"
    },
    {
      "term": "錯亂根識",
      "note": "54A不能安立所量真實有，安立虛妄則相宜。"
    },
    {
      "term": "唯心非破外境",
      "note": "54A先理證後教證，常我作者與心業為主須保留限定。"
    }
  ],
  "doctrinalSchema": "承接破自證，釋如何成立能緣識；區分成立/通達及無漏智/自證；保留不確定及未解。",
