{
  "name": "transcriptions-platform",
  "version": "1.0.0",
  "description": "Multi-media transcript learning platform for series courses, governed by GGF",
  "main": "src/js/app.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.js tests/acceptance/*.test.js tests/quality.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:acceptance": "node --test tests/acceptance/*.test.js",
    "test:quality": "node --test tests/quality.test.js",
    "test:qa": "node scripts/qa_analyze.js",
    "test:qa:json": "node scripts/qa_analyze.js --json",
    "dev": "npx serve src -p 9090",
    "start": "npx serve src -p 9090"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huanruilee/Transcriptions.git"
  },
  "keywords": [
    "transcription",
    "audio-sync",
    "madhyamakavatara",
    "buddhism",
    "ggf-governed"
  ],
  "author": "Henry Lee",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/huanruilee/Transcriptions/issues"
  },
  "homepage": "https://github.com/huanruilee/Transcriptions#readme",
  "devDependencies": {
    "jsdom": "^30.0.1",
    "ws": "^8.21.3"
  }
}
