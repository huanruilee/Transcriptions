{
  "name": "transcriptions-platform",
  "version": "1.0.0",
  "description": "Multi-media transcript learning platform for series courses, governed by GGF",
  "main": "src/js/app.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.js tests/acceptance/*.test.js tests/quality.test.js tests/alignment-pipeline.test.js tests/cross-artifact-consistency.test.js tests/required-set-not-truncated.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:acceptance": "node --test tests/acceptance/*.test.js",
    "test:quality": "node --test tests/quality.test.js",
    "test:human-review": "node --test tests/required-set-not-truncated.test.js",
    "build:human-review-package": "python3 scripts/build_human_review_package.py",
    "test:qa": "node scripts/qa_analyze.js",
    "test:qa:json": "node scripts/qa_analyze.js --json",
    "test:asr-gate": "node --test tests/unit/asrIntegrityGate.test.js",
    "test:rating": "node --test tests/unit/reviewRating.test.js",
    "score": "python3 scripts/quality_scorer.py",
    "score:fix": "python3 scripts/quality_scorer.py --fix",
    "learn:eval": "python3 scripts/active_learning_manager.py --eval",
    "learn:sync": "python3 scripts/active_learning_manager.py --sync-all",
    "learn:dry-run": "python3 scripts/active_learning_manager.py --sync-all --dry-run",
    "dev": "npx serve src -p 9090",
    "start": "npx serve src -p 9090"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huanruilee/Transcriptions.git"
  },
  "keywords": [
    "transcription",
    "audio-sync",
    "madhyamakavatara",
    "buddhism",
    "ggf-governed"
  ],
  "author": "Henry Lee",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/huanruilee/Transcriptions/issues"
  },
  "homepage": "https://github.com/huanruilee/Transcriptions#readme",
  "devDependencies": {
    "jsdom": "^30.0.1",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
